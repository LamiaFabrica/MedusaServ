[Unit]
Description=MedusaServ Professional Web Server
Documentation=https://docs.medusaserv.com
After=network.target psiforcedb.service
Wants=psiforcedb.service

[Service]
Type=simple
User=medusaserv
Group=medusaserv
WorkingDirectory=/opt/medusaserv
ExecStart=/opt/medusaserv/bin/medusaserv --config /opt/medusaserv/config/medusaserv.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
StandardOutput=append:/opt/medusaserv/data/logs/medusaserv.log
StandardError=append:/opt/medusaserv/data/logs/medusaserv-error.log

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/medusaserv/data
ReadOnlyPaths=/opt/medusaserv/config

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
