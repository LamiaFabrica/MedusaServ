<!--
© 2025 D Hargreaves AKA Roylepython | All Rights Reserved

CONTACT PAGE - LAMIA FABRICA BACK-OFFICE INTEGRATION
====================================================

This page provides contact functionality that will be integrated with the Lamia Fabrica back-office system
-->

manifest contact_page() {
    // SEO META TAGS
    meta {
        title: "Contact Us - Get in Touch | Lamia Fabrica Back-Office Integration"
        description: "Contact the Medusa ecosystem team. Get support, ask questions, or request features. Integrated with Lamia Fabrica back-office system for seamless communication."
        keywords: "contact, support, lamia fabrica, back-office, customer service, help desk, get in touch"
        author: "D Hargreaves AKA Roylepython"
        viewport: "width=device-width, initial-scale=1.0"
        charset: "UTF-8"
    }

    // OPEN GRAPH & TWITTER CARDS
    social {
        og_title: "Contact Us - Get in Touch with the Medusa Ecosystem"
        og_description: "Get support, ask questions, or request features. Integrated with Lamia Fabrica back-office system."
        og_image: "C:/Build/Medusa_Art/medusa-transformed.png"
        og_url: "https://poweredbymedusa.com/contact"
        twitter_card: "summary_large_image"
        twitter_creator: "@Roylepython"
    }

    // STRUCTURED DATA
    structured_data {
        type: "ContactPage"
        name: "Contact Us"
        description: "Contact page for the Medusa ecosystem with Lamia Fabrica back-office integration"
        url: "https://poweredbymedusa.com/contact"
        author: "D Hargreaves"
    }

    // INCLUDE HEADER, MENU, FOOTER, COPYRIGHT
    include "header.lamia"
    include "menu.lamia"

    // HERO SECTION
    section hero {
        background: "linear-gradient(135deg, #8B3F8B 0%, #6B2B6B 100%)"
        padding: "120px 0 80px"
        margin_top: "200px"
        
        container {
            max_width: "1200px"
            margin: "0 auto"
            padding: "0 2rem"
            text_align: "center"
            
            badge {
                text: "📞 Get in Touch"
                background: "rgba(255, 255, 255, 0.2)"
                color: "white"
                padding: "0.5rem 1rem"
                border_radius: "25px"
                margin_bottom: "2rem"
                animation: "pulse 2s infinite"
            }
            
            title {
                text: "Contact Us"
                size: "4rem"
                weight: "800"
                margin_bottom: "1.5rem"
                gradient: "linear-gradient(45deg, #ff6b00, #ffffff)"
            }
            
            subtitle {
                text: "Get in touch with the Medusa ecosystem team. We're here to help with support, questions, feature requests, or just to say hello."
                size: "1.4rem"
                margin_bottom: "3rem"
                opacity: "0.9"
                max_width: "800px"
                margin: "0 auto 3rem"
            }
            
            stats_grid {
                display: "grid"
                grid_template_columns: "repeat(3, 1fr)"
                gap: "2rem"
                margin_bottom: "3rem"
                
                stat {
                    background: "rgba(255, 255, 255, 0.1)"
                    padding: "2rem"
                    border_radius: "15px"
                    backdrop_filter: "blur(10px)"
                    
                    number: "24/7"
                    label: "Support Available"
                    description: "Round the clock"
                }
                
                stat {
                    background: "rgba(255, 255, 255, 0.1)"
                    padding: "2rem"
                    border_radius: "15px"
                    backdrop_filter: "blur(10px)"
                    
                    number: "⚡"
                    label: "Fast Response"
                    description: "Usually within hours"
                }
                
                stat {
                    background: "rgba(255, 255, 255, 0.1)"
                    padding: "2rem"
                    border_radius: "15px"
                    backdrop_filter: "blur(10px)"
                    
                    number: "🤖"
                    label: "AI Powered"
                    description: "Lamia Fabrica integration"
                }
            }
        }
    }

    // CONTACT FORM SECTION
    section contact_form {
        background: "white"
        padding: "4rem 0"
        
        container {
            max_width: "1200px"
            margin: "0 auto"
            padding: "0 2rem"
            
            title {
                text: "Send Us a Message"
                size: "3rem"
                weight: "700"
                color: "#8B3F8B"
                text_align: "center"
                margin_bottom: "1rem"
            }
            
            subtitle {
                text: "Fill out the form below and we'll get back to you as soon as possible"
                size: "1.2rem"
                color: "#666"
                text_align: "center"
                max_width: "600px"
                margin: "0 auto 4rem"
            }
            
            form_container {
                display: "grid"
                grid_template_columns: "1fr 1fr"
                gap: "3rem"
                margin_bottom: "3rem"
                
                contact_form {
                    background: "#f8f9fa"
                    border_radius: "15px"
                    padding: "2.5rem"
                    border: "2px solid #e9ecef"
                    
                    title {
                        text: "Contact Information"
                        size: "1.5rem"
                        weight: "600"
                        color: "#8B3F8B"
                        margin_bottom: "2rem"
                    }
                    
                    form {
                        display: "flex"
                        flex_direction: "column"
                        gap: "1.5rem"
                        
                        field_group {
                            display: "flex"
                            flex_direction: "column"
                            gap: "0.5rem"
                            
                            label {
                                text: "Full Name *"
                                font_weight: "600"
                                color: "#333"
                            }
                            
                            input {
                                type: "text"
                                name: "full_name"
                                placeholder: "Enter your full name"
                                required: true
                                padding: "1rem"
                                border: "2px solid #e9ecef"
                                border_radius: "10px"
                                font_size: "1rem"
                                transition: "border-color 0.3s ease"
                                focus: "border-color: #8B3F8B; outline: none"
                            }
                        }
                        
                        field_group {
                            display: "flex"
                            flex_direction: "column"
                            gap: "0.5rem"
                            
                            label {
                                text: "Email Address *"
                                font_weight: "600"
                                color: "#333"
                            }
                            
                            input {
                                type: "email"
                                name: "email"
                                placeholder: "Enter your email address"
                                required: true
                                padding: "1rem"
                                border: "2px solid #e9ecef"
                                border_radius: "10px"
                                font_size: "1rem"
                                transition: "border-color 0.3s ease"
                                focus: "border-color: #8B3F8B; outline: none"
                            }
                        }
                        
                        field_group {
                            display: "flex"
                            flex_direction: "column"
                            gap: "0.5rem"
                            
                            label {
                                text: "Phone Number"
                                font_weight: "600"
                                color: "#333"
                            }
                            
                            input {
                                type: "tel"
                                name: "phone"
                                placeholder: "Enter your phone number (optional)"
                                padding: "1rem"
                                border: "2px solid #e9ecef"
                                border_radius: "10px"
                                font_size: "1rem"
                                transition: "border-color 0.3s ease"
                                focus: "border-color: #8B3F8B; outline: none"
                            }
                        }
                        
                        field_group {
                            display: "flex"
                            flex_direction: "column"
                            gap: "0.5rem"
                            
                            label {
                                text: "Subject *"
                                font_weight: "600"
                                color: "#333"
                            }
                            
                            select {
                                name: "subject"
                                required: true
                                padding: "1rem"
                                border: "2px solid #e9ecef"
                                border_radius: "10px"
                                font_size: "1rem"
                                background: "white"
                                transition: "border-color 0.3s ease"
                                focus: "border-color: #8B3F8B; outline: none"
                                
                                option {
                                    value: "general"
                                    text: "General Inquiry"
                                }
                                
                                option {
                                    value: "support"
                                    text: "Technical Support"
                                }
                                
                                option {
                                    value: "feature"
                                    text: "Feature Request"
                                }
                                
                                option {
                                    value: "bug"
                                    text: "Bug Report"
                                }
                                
                                option {
                                    value: "partnership"
                                    text: "Partnership"
                                }
                                
                                option {
                                    value: "other"
                                    text: "Other"
                                }
                            }
                        }
                        
                        field_group {
                            display: "flex"
                            flex_direction: "column"
                            gap: "0.5rem"
                            
                            label {
                                text: "Message *"
                                font_weight: "600"
                                color: "#333"
                            }
                            
                            textarea {
                                name: "message"
                                placeholder: "Tell us how we can help you..."
                                required: true
                                padding: "1rem"
                                border: "2px solid #e9ecef"
                                border_radius: "10px"
                                font_size: "1rem"
                                min_height: "150px"
                                resize: "vertical"
                                font_family: "inherit"
                                transition: "border-color 0.3s ease"
                                focus: "border-color: #8B3F8B; outline: none"
                            }
                        }
                        
                        field_group {
                            display: "flex"
                            align_items: "center"
                            gap: "1rem"
                            
                            input {
                                type: "checkbox"
                                name: "newsletter"
                                id: "newsletter"
                            }
                            
                            label {
                                text: "Subscribe to our newsletter for updates and announcements"
                                font_size: "0.9rem"
                                color: "#666"
                                cursor: "pointer"
                            }
                        }
                        
                        submit_button {
                            text: "🚀 Send Message"
                            type: "submit"
                            background: "#ff6b00"
                            color: "white"
                            padding: "1rem 2rem"
                            border: "none"
                            border_radius: "50px"
                            font_size: "1.1rem"
                            font_weight: "600"
                            cursor: "pointer"
                            transition: "all 0.3s ease"
                            hover: "background: #e55a00; transform: translateY(-2px)"
                        }
                    }
                }
                
                contact_info {
                    background: "linear-gradient(135deg, #6B2B6B 0%, #2a1a2a 100%)"
                    color: "white"
                    border_radius: "15px"
                    padding: "2.5rem"
                    
                    title {
                        text: "Get in Touch"
                        size: "1.5rem"
                        weight: "600"
                        margin_bottom: "2rem"
                    }
                    
                    info_list {
                        display: "flex"
                        flex_direction: "column"
                        gap: "2rem"
                        
                        info_item {
                            display: "flex"
                            align_items: "center"
                            gap: "1rem"
                            
                            icon {
                                font_size: "1.5rem"
                                width: "40px"
                                height: "40px"
                                display: "flex"
                                align_items: "center"
                                justify_content: "center"
                                background: "rgba(255, 255, 255, 0.2)"
                                border_radius: "50%"
                            }
                            
                            content {
                                display: "flex"
                                flex_direction: "column"
                                gap: "0.25rem"
                                
                                label {
                                    font_weight: "600"
                                    font_size: "1rem"
                                }
                                
                                value {
                                    font_size: "0.9rem"
                                    opacity: "0.9"
                                }
                            }
                        }
                        
                        info_item {
                            icon: "📧"
                            label: "Email"
                            value: "contact@poweredbymedusa.com"
                        }
                        
                        info_item {
                            icon: "🌐"
                            label: "Website"
                            value: "poweredbymedusa.com"
                        }
                        
                        info_item {
                            icon: "📱"
                            label: "Social Media"
                            value: "@Roylepython"
                        }
                        
                        info_item {
                            icon: "⏰"
                            label: "Response Time"
                            value: "Usually within 24 hours"
                        }
                    }
                    
                    support_section {
                        margin_top: "3rem"
                        padding_top: "2rem"
                        border_top: "1px solid rgba(255, 255, 255, 0.2)"
                        
                        title {
                            text: "Quick Support"
                            size: "1.2rem"
                            weight: "600"
                            margin_bottom: "1rem"
                        }
                        
                        support_links {
                            display: "flex"
                            flex_direction: "column"
                            gap: "0.75rem"
                            
                            link {
                                display: "flex"
                                align_items: "center"
                                gap: "0.5rem"
                                color: "white"
                                text_decoration: "none"
                                padding: "0.5rem"
                                border_radius: "5px"
                                transition: "background 0.3s ease"
                                hover: "background: rgba(255, 255, 255, 0.1)"
                                
                                icon: "📚"
                                text: "Documentation"
                                url: "docs.lamia"
                            }
                            
                            link {
                                icon: "🎮"
                                text: "Playground"
                                url: "lamia/playground.lamia"
                            }
                            
                            link {
                                icon: "🤖"
                                text: "Lamia Fabrica"
                                url: "lamia-fabrica.lamia"
                            }
                            
                            link {
                                icon: "⚡"
                                text: "MedusaServ"
                                url: "medusaserv.lamia"
                            }
                        }
                    }
                }
            }
        }
    }

    // INTEGRATION SECTION
    section integration {
        background: "linear-gradient(135deg, #2a1a2a 0%, #1a1a2e 100%)"
        color: "white"
        padding: "4rem 0"
        
        container {
            max_width: "1200px"
            margin: "0 auto"
            padding: "0 2rem"
            text_align: "center"
            
            title {
                text: "Lamia Fabrica Back-Office Integration"
                size: "3rem"
                weight: "700"
                margin_bottom: "1rem"
            }
            
            subtitle {
                text: "Your messages are automatically processed and routed through our advanced back-office system"
                size: "1.2rem"
                margin_bottom: "4rem"
                opacity: "0.9"
            }
            
            integration_grid {
                display: "grid"
                grid_template_columns: "repeat(auto-fit, minmax(300px, 1fr))"
                gap: "2rem"
                
                integration_feature {
                    background: "rgba(255, 255, 255, 0.1)"
                    border_radius: "15px"
                    padding: "2rem"
                    backdrop_filter: "blur(10px)"
                    border: "1px solid rgba(255, 255, 255, 0.2)"
                    transition: "all 0.3s ease"
                    hover_effect: "background: rgba(255, 255, 255, 0.15); transform: translateY(-5px)"
                    
                    icon: "🤖"
                    title: "AI-Powered Routing"
                    description: "Messages are automatically categorized and routed to the appropriate team members using advanced AI algorithms."
                }
                
                integration_feature {
                    background: "rgba(255, 255, 255, 0.1)"
                    border_radius: "15px"
                    padding: "2rem"
                    backdrop_filter: "blur(10px)"
                    border: "1px solid rgba(255, 255, 255, 0.2)"
                    transition: "all 0.3s ease"
                    hover_effect: "background: rgba(255, 255, 255, 0.15); transform: translateY(-5px)"
                    
                    icon: "📊"
                    title: "Real-time Analytics"
                    description: "Track response times, customer satisfaction, and support metrics in real-time through the back-office dashboard."
                }
                
                integration_feature {
                    background: "rgba(255, 255, 255, 0.1)"
                    border_radius: "15px"
                    padding: "2rem"
                    backdrop_filter: "blur(10px)"
                    border: "1px solid rgba(255, 255, 255, 0.2)"
                    transition: "all 0.3s ease"
                    hover_effect: "background: rgba(255, 255, 255, 0.15); transform: translateY(-5px)"
                    
                    icon: "🔗"
                    title: "Seamless Integration"
                    description: "All contact forms are automatically integrated with our CRM, ticketing system, and customer database."
                }
            }
        }
    }

    // FAQ SECTION
    section faq {
        background: "white"
        padding: "4rem 0"
        
        container {
            max_width: "1200px"
            margin: "0 auto"
            padding: "0 2rem"
            
            title {
                text: "Frequently Asked Questions"
                size: "3rem"
                weight: "700"
                color: "#8B3F8B"
                text_align: "center"
                margin_bottom: "1rem"
            }
            
            subtitle {
                text: "Find quick answers to common questions"
                size: "1.2rem"
                color: "#666"
                text_align: "center"
                max_width: "600px"
                margin: "0 auto 4rem"
            }
            
            faq_grid {
                display: "grid"
                grid_template_columns: "repeat(auto-fit, minmax(500px, 1fr))"
                gap: "2rem"
                
                faq_item {
                    background: "#f8f9fa"
                    border_radius: "15px"
                    padding: "2rem"
                    border: "2px solid #e9ecef"
                    transition: "all 0.3s ease"
                    hover_effect: "transform: translateY(-2px); box-shadow: 0 10px 25px rgba(139, 63, 139, 0.1)"
                    
                    question {
                        text: "How quickly will I receive a response?"
                        font_size: "1.2rem"
                        font_weight: "600"
                        color: "#8B3F8B"
                        margin_bottom: "1rem"
                    }
                    
                    answer {
                        text: "We typically respond to all inquiries within 24 hours. For urgent technical support, we aim to respond within 4-6 hours during business hours."
                        color: "#666"
                        line_height: "1.6"
                    }
                }
                
                faq_item {
                    question: "What information should I include in my message?"
                    answer: "Please include your name, email, and a detailed description of your inquiry or issue. For technical support, include system details, error messages, and steps to reproduce the problem."
                }
                
                faq_item {
                    question: "Can I request new features for the Medusa ecosystem?"
                    answer: "Absolutely! We welcome feature requests and suggestions. Please use the 'Feature Request' subject category and provide as much detail as possible about your idea."
                }
                
                faq_item {
                    question: "Is there a way to get priority support?"
                    answer: "Priority support is available for enterprise customers and Patreon supporters. Please mention your support level in your message for faster response times."
                }
                
                faq_item {
                    question: "How is my data protected?"
                    answer: "All contact information is encrypted and stored securely. We never share your personal information with third parties and comply with GDPR regulations."
                }
                
                faq_item {
                    question: "Can I schedule a call or meeting?"
                    answer: "Yes! For complex inquiries or partnership discussions, we can schedule video calls. Please mention this in your message and we'll coordinate a time that works for you."
                }
            }
        }
    }

    // PATREON SUPPORT SECTION
    section patreon_support {
        background: "linear-gradient(135deg, #1a1a2e 0%, #0f0f23 100%)"
        color: "white"
        padding: "4rem 0"
        
        container {
            max_width: "1200px"
            margin: "0 auto"
            padding: "0 2rem"
            text_align: "center"
            
            title {
                text: "Get Priority Support"
                size: "2.5rem"
                weight: "700"
                margin_bottom: "1rem"
            }
            
            subtitle {
                text: "Support our development and get faster response times with Patreon membership"
                size: "1.2rem"
                margin_bottom: "3rem"
                opacity: "0.9"
            }
            
            cta_button {
                text: "🎯 Support on Patreon"
                link: "https://www.patreon.com/TheMedusaInitiative"
                background: "#ff6b00"
                color: "white"
                padding: "1rem 3rem"
                border_radius: "50px"
                font_size: "1.2rem"
                font_weight: "600"
                hover_effect: "transform: translateY(-3px); box-shadow: 0 10px 25px rgba(255, 107, 0, 0.4)"
            }
        }
    }

    include "footer.lamia"
    include "copyright.lamia"
}
