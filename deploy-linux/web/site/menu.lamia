                }
            }
            
            separator {
                width: "2px"
                height: "20px"
                background: "linear-gradient(to bottom, transparent, #FF6B9D, transparent)"
                border_radius: "1px"
                opacity: "0.6"
                animation: "separatorPulse 2s ease-in-out infinite"
            }
            
            // LAMIA FABRICA
            nav_item {
                link {
                    icon: "hand-wave-gif3d-mini"
                    text: "Lamia Fabrica"
                    url: "lamia-fabrica.lamia"
                    hover_effect: "translateY(-1px)"
                }
            }
            
            separator {
                width: "2px"
                height: "20px"
                background: "linear-gradient(to bottom, transparent, #FF6B9D, transparent)"
                border_radius: "1px"
                opacity: "0.6"
                animation: "separatorPulse 2s ease-in-out infinite"
            }
            
            // MEDUSASERV
            nav_item has_children {
                link {
                    icon: "server-gif3d-mini"
                    text: "MedusaServ"
                    url: "#"
                    hover_effect: "translateY(-1px)"
                }
                
                dropdown {
                    position: "absolute"
                    top: "100%"
                    left: "0"
                    min_width: "400px"
                    background: "rgba(255, 255, 255, 0.98)"
                    backdrop_filter: "blur(20px)"
                    border_radius: "15px"
                    box_shadow: "0 20px 60px rgba(0, 0, 0, 0.2)"
                    padding: "1.5rem"
                    opacity: "0"
                    visibility: "hidden"
                    transform: "translateY(-10px) scale(0.95)"
                    transition: "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)"
                    z_index: "1001"
                    border: "2px solid #FF6B9D"
                    
                    dropdown_title {
                        text: "MedusaServ Web Server"
                        font_size: "1.2rem"
                        font_weight: "bold"
                        color: "#8B3F8B"
                        text_align: "center"
                        margin_bottom: "1.5rem"
                        padding_bottom: "0.5rem"
                        border_bottom: "2px solid #FF6B9D"
                    }
                    
                    dropdown_buttons {
                        display: "flex"
                        gap: "1rem"
                        justify_content: "center"
                        
                        button server {
                            display: "flex"
                            flex_direction: "column"
                            align_items: "center"
                            padding: "1rem"
                            background: "linear-gradient(135deg, #8B3F8B, #FF6B9D)"
                            border: "none"
                            border_radius: "10px"
                            color: "white"
                            cursor: "pointer"
                            transition: "all 0.3s ease"
                            min_width: "150px"
                            hover_effect: "translateY(-5px) scale(1.05); box-shadow: 0 10px 20px rgba(139, 63, 139, 0.4)"
                            
                            icon: "⚡"
                            title: "Server"
                            description: "High-performance C++"
                            link: "medusaserv.lamia"
                        }
                        
                        button security {
                            display: "flex"
                            flex_direction: "column"
                            align_items: "center"
                            padding: "1rem"
