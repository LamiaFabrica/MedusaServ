<!--
© 2025 D Hargreaves AKA Roylepython | All Rights Reserved

LAMIA PLAYGROUND - TRY THE REVOLUTIONARY PROGRAMMING LANGUAGE
=============================================================

This page provides an interactive playground for users to try Lamia programming language
-->

manifest lamia_playground() {
    // SEO META TAGS
    meta {
        title: "Lamia Playground - Try Revolutionary Programming Language | Interactive Demo"
        description: "Try Lamia programming language in our interactive playground. Experience 78.3% complexity reduction, 3D emotion synthesis, and revolutionary features."
        keywords: "lamia playground, try lamia, interactive demo, programming language, 78.3% complexity reduction, 3D emotion synthesis"
        author: "D Hargreaves AKA Roylepython"
        viewport: "width=device-width, initial-scale=1.0"
        charset: "UTF-8"
    }

    // OPEN GRAPH & TWITTER CARDS
    social {
        og_title: "Lamia Playground - Try Revolutionary Programming Language"
        og_description: "Experience the future of programming with our interactive Lamia playground"
        og_image: "C:/Build/Medusa_Art/medusa-transformed.png"
        og_url: "https://poweredbymedusa.com/lamia/playground"
        twitter_card: "summary_large_image"
        twitter_creator: "@Roylepython"
    }

    // STRUCTURED DATA
    structured_data {
        type: "SoftwareApplication"
        name: "Lamia Playground"
        version: "0.3.0d"
        description: "Interactive playground for Lamia programming language"
        applicationCategory: "Programming Tool"
        operatingSystem: "Cross-platform"
        author: "D Hargreaves"
    }

    // INCLUDE HEADER, MENU, FOOTER, COPYRIGHT
    include "../header.lamia"
    include "../menu.lamia"

    // HERO SECTION
    section hero {
        background: "linear-gradient(135deg, #8B3F8B 0%, #6B2B6B 100%)"
        padding: "120px 0 80px"
        margin_top: "200px"
        
        container {
            max_width: "1200px"
            margin: "0 auto"
            padding: "0 2rem"
            text_align: "center"
            
            badge {
                text: "🎮 Interactive Programming Playground"
                background: "rgba(255, 255, 255, 0.2)"
                color: "white"
                padding: "0.5rem 1rem"
                border_radius: "25px"
                margin_bottom: "2rem"
                animation: "pulse 2s infinite"
            }
            
            title {
                text: "Lamia Playground"
                size: "4rem"
                weight: "800"
                margin_bottom: "1.5rem"
                gradient: "linear-gradient(45deg, #ff6b00, #ffffff)"
            }
            
            subtitle {
                text: "Experience the revolutionary Lamia programming language in our interactive playground. Try 78.3% complexity reduction, 3D emotion synthesis, and industry-first features."
                size: "1.4rem"
                margin_bottom: "3rem"
                opacity: "0.9"
                max_width: "900px"
                margin: "0 auto 3rem"
            }
            
            stats_grid {
                display: "grid"
                grid_template_columns: "repeat(3, 1fr)"
                gap: "2rem"
                margin_bottom: "3rem"
                
                stat {
                    background: "rgba(255, 255, 255, 0.1)"
                    padding: "2rem"
                    border_radius: "15px"
                    backdrop_filter: "blur(10px)"
                    
                    number: "0"
                    label: "Setup Required"
                    description: "Instant access"
                }
                
                stat {
                    background: "rgba(255, 255, 255, 0.1)"
                    padding: "2rem"
                    border_radius: "15px"
                    backdrop_filter: "blur(10px)"
                    
                    number: "∞"
                    label: "Examples"
                    description: "Endless possibilities"
                }
                
                stat {
                    background: "rgba(255, 255, 255, 0.1)"
                    padding: "2rem"
                    border_radius: "15px"
                    backdrop_filter: "blur(10px)"
                    
                    number: "⚡"
                    label: "Real-time"
                    description: "Instant results"
                }
            }
        }
    }

    // PLAYGROUND SECTION
    section playground {
        background: "white"
        padding: "4rem 0"
        
        container {
            max_width: "1400px"
            margin: "0 auto"
            padding: "0 2rem"
            
            title {
                text: "Interactive Playground"
                size: "3rem"
                weight: "700"
                color: "#8B3F8B"
                text_align: "center"
                margin_bottom: "1rem"
            }
            
            subtitle {
                text: "Write Lamia code and see instant results. No setup required."
                size: "1.2rem"
                color: "#666"
                text_align: "center"
                max_width: "600px"
                margin: "0 auto 4rem"
            }
            
            playground_container {
                display: "grid"
                grid_template_columns: "1fr 1fr"
                gap: "2rem"
                margin_bottom: "3rem"
                
                code_editor {
                    background: "#1e1e1e"
                    border_radius: "15px"
                    padding: "2rem"
                    min_height: "500px"
                    
                    title {
                        text: "Lamia Code Editor"
                        color: "white"
                        font_size: "1.2rem"
                        margin_bottom: "1rem"
                    }
                    
                    editor {
                        background: "#2d2d2d"
                        border_radius: "10px"
                        padding: "1rem"
                        font_family: "monospace"
                        color: "#ffffff"
                        min_height: "400px"
                        border: "none"
                        outline: "none"
                        resize: "vertical"
                        
                        placeholder: "// Try Lamia code here
manifest hello_world() {
    // This is a simple Lamia manifest
    section greeting {
        title: \"Hello, World!\"
        message: \"Welcome to Lamia programming language\"
    }
}"
                    }
                    
                    buttons {
                        button run {
                            text: "🚀 Run Code"
                            background: "#ff6b00"
                            color: "white"
                            padding: "0.5rem 1rem"
                            border_radius: "5px"
                            margin_right: "1rem"
                            hover_effect: "background: #e55a00"
                        }
                        
                        button clear {
                            text: "🗑️ Clear"
                            background: "#666"
                            color: "white"
                            padding: "0.5rem 1rem"
                            border_radius: "5px"
                            hover_effect: "background: #555"
                        }
                    }
                }
                
                output {
                    background: "#f8f9fa"
                    border_radius: "15px"
                    padding: "2rem"
                    min_height: "500px"
                    border: "2px solid #e9ecef"
                    
                    title {
                        text: "Live Output"
                        color: "#8B3F8B"
                        font_size: "1.2rem"
                        margin_bottom: "1rem"
                    }
                    
                    result {
                        background: "white"
                        border_radius: "10px"
                        padding: "1rem"
                        min_height: "400px"
                        border: "1px solid #dee2e6"
                        font_family: "monospace"
                        color: "#333"
                        
                        content: "// Output will appear here when you run your Lamia code
// Try the example code in the editor!"
                    }
                }
            }
        }
    }

    // EXAMPLES SECTION
    section examples {
        background: "linear-gradient(135deg, #6B2B6B 0%, #2a1a2a 100%)"
        color: "white"
        padding: "4rem 0"
        
        container {
            max_width: "1200px"
            margin: "0 auto"
            padding: "0 2rem"
            text_align: "center"
            
            title {
                text: "Example Projects"
                size: "3rem"
                weight: "700"
                margin_bottom: "1rem"
            }
            
            subtitle {
                text: "Explore these example projects to see Lamia's revolutionary features in action"
                size: "1.2rem"
                margin_bottom: "4rem"
                opacity: "0.9"
            }
            
            examples_grid {
                display: "grid"
                grid_template_columns: "repeat(auto-fit, minmax(300px, 1fr))"
                gap: "2rem"
                
                example {
                    background: "rgba(255, 255, 255, 0.1)"
                    border_radius: "15px"
                    padding: "2rem"
                    backdrop_filter: "blur(10px)"
                    border: "1px solid rgba(255, 255, 255, 0.2)"
                    transition: "all 0.3s ease"
                    hover_effect: "background: rgba(255, 255, 255, 0.15); transform: translateY(-5px)"
                    
                    icon: "🐍"
                    title: "Hello World"
                    description: "Simple manifest example showing basic Lamia syntax and structure."
                    difficulty: "Beginner"
                    link: "examples/hello-world.lamia"
                }
                
                example {
                    background: "rgba(255, 255, 255, 0.1)"
                    border_radius: "15px"
                    padding: "2rem"
                    backdrop_filter: "blur(10px)"
                    border: "1px solid rgba(255, 255, 255, 0.2)"
                    transition: "all 0.3s ease"
                    hover_effect: "background: rgba(255, 255, 255, 0.15); transform: translateY(-5px)"
                    
                    icon: "🧠"
                    title: "3D Emotion Synthesis"
                    description: "Experience Lamia's revolutionary 3D emotion synthesis feature."
                    difficulty: "Intermediate"
                    link: "examples/emotion-synthesis.lamia"
                }
                
                example {
                    background: "rgba(255, 255, 255, 0.1)"
                    border_radius: "15px"
                    padding: "2rem"
                    backdrop_filter: "blur(10px)"
                    border: "1px solid rgba(255, 255, 255, 0.2)"
                    transition: "all 0.3s ease"
                    hover_effect: "background: rgba(255, 255, 255, 0.15); transform: translateY(-5px)"
                    
                    icon: "🚀"
                    title: "@ludicrous Mode"
                    description: "See the power of @ludicrous mode with ultra-high performance examples."
                    difficulty: "Advanced"
                    link: "examples/ludicrous-mode.lamia"
                }
                
                example {
                    background: "rgba(255, 255, 255, 0.1)"
                    border_radius: "15px"
                    padding: "2rem"
                    backdrop_filter: "blur(10px)"
                    border: "1px solid rgba(255, 255, 255, 0.2)"
                    transition: "all 0.3s ease"
                    hover_effect: "background: rgba(255, 255, 255, 0.15); transform: translateY(-5px)"
                    
                    icon: "🎨"
                    title: "3D GIF Creation"
                    description: "Create stunning 3D GIFs with Lamia's built-in tools and libraries."
                    difficulty: "Intermediate"
                    link: "examples/3d-gif.lamia"
                }
                
                example {
                    background: "rgba(255, 255, 255, 0.1)"
                    border_radius: "15px"
                    padding: "2rem"
                    backdrop_filter: "blur(10px)"
                    border: "1px solid rgba(255, 255, 255, 0.2)"
                    transition: "all 0.3s ease"
                    hover_effect: "background: rgba(255, 255, 255, 0.15); transform: translateY(-5px)"
                    
                    icon: "⚙️"
                    title: "G-code Generation"
                    description: "Generate G-code for CNC and 3D printing with Lamia's manufacturing integration."
                    difficulty: "Advanced"
                    link: "examples/gcode-generation.lamia"
                }
                
                example {
                    background: "rgba(255, 255, 255, 0.1)"
                    border_radius: "15px"
                    padding: "2rem"
                    backdrop_filter: "blur(10px)"
                    border: "1px solid rgba(255, 255, 255, 0.2)"
                    transition: "all 0.3s ease"
                    hover_effect: "background: rgba(255, 255, 255, 0.15); transform: translateY(-5px)"
                    
                    icon: "👥"
                    title: "Social Protocols"
                    description: "Build applications with built-in social networking capabilities."
                    difficulty: "Intermediate"
                    link: "examples/social-protocols.lamia"
                }
            }
        }
    }

    // FEATURES HIGHLIGHT SECTION
    section features_highlight {
        background: "linear-gradient(135deg, #2a1a2a 0%, #1a1a2e 100%)"
        color: "white"
        padding: "4rem 0"
        
        container {
            max_width: "1200px"
            margin: "0 auto"
            padding: "0 2rem"
            text_align: "center"
            
            title {
                text: "Revolutionary Features to Try"
                size: "3rem"
                weight: "700"
                margin_bottom: "1rem"
            }
            
            subtitle {
                text: "Experience the features that make Lamia the future of programming"
                size: "1.2rem"
                margin_bottom: "4rem"
                opacity: "0.9"
            }
            
            features_grid {
                display: "grid"
                grid_template_columns: "repeat(auto-fit, minmax(300px, 1fr))"
                gap: "2rem"
                
                feature {
                    background: "rgba(255, 255, 255, 0.1)"
                    border_radius: "15px"
                    padding: "2rem"
                    backdrop_filter: "blur(10px)"
                    border: "1px solid rgba(255, 255, 255, 0.2)"
                    transition: "all 0.3s ease"
                    hover_effect: "background: rgba(255, 255, 255, 0.15); transform: translateY(-5px)"
                    
                    icon: "📄"
                    title: "Manifest System"
                    description: "Declarative configuration with crystal-clear structure."
                    link: "manifest.lamia"
                }
                
                feature {
                    background: "rgba(255, 255, 255, 0.1)"
                    border_radius: "15px"
                    padding: "2rem"
                    backdrop_filter: "blur(10px)"
                    border: "1px solid rgba(255, 255, 255, 0.2)"
                    transition: "all 0.3s ease"
                    hover_effect: "background: rgba(255, 255, 255, 0.15); transform: translateY(-5px)"
                    
                    icon: "💎"
                    title: "Crystal Return Types"
                    description: "Type-safe programming with crystal-clear return types."
                    link: "crystal.lamia"
                }
                
                feature {
                    background: "rgba(255, 255, 255, 0.1)"
                    border_radius: "15px"
                    padding: "2rem"
                    backdrop_filter: "blur(10px)"
                    border: "1px solid rgba(255, 255, 255, 0.2)"
                    transition: "all 0.3s ease"
                    hover_effect: "background: rgba(255, 255, 255, 0.15); transform: translateY(-5px)"
                    
                    icon: "🎨"
                    title: "3D GIF Technology"
                    description: "Create stunning 3D animations and interactive experiences."
                    link: "gif3d.lamia"
                }
            }
        }
    }

    // PATREON SUPPORT SECTION
    section patreon_support {
        background: "linear-gradient(135deg, #1a1a2e 0%, #0f0f23 100%)"
        color: "white"
        padding: "4rem 0"
        
        container {
            max_width: "1200px"
            margin: "0 auto"
            padding: "0 2rem"
            text_align: "center"
            
            title {
                text: "Support Lamia Development"
                size: "2.5rem"
                weight: "700"
                margin_bottom: "1rem"
            }
            
            subtitle {
                text: "Your support makes the difference between life and death for this revolutionary programming language"
                size: "1.2rem"
                margin_bottom: "3rem"
                opacity: "0.9"
            }
            
            cta_button {
                text: "🎯 Support on Patreon"
                link: "https://www.patreon.com/TheMedusaInitiative"
                background: "#ff6b00"
                color: "white"
                padding: "1rem 3rem"
                border_radius: "50px"
                font_size: "1.2rem"
                font_weight: "600"
                hover_effect: "transform: translateY(-3px); box-shadow: 0 10px 25px rgba(255, 107, 0, 0.4)"
            }
        }
    }

    include "../footer.lamia"
    include "../copyright.lamia"
}
