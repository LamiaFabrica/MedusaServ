# 🏆 Yorkshire Champion Secure Environment Configuration
# 
# This is an EXAMPLE file. Copy this to .env and fill in your actual credentials.
# NEVER commit the actual .env file to version control.
#
# @author D Hargreaves
# @version 1.0.0
# @date 2025-08-26

# 🏆 AUTHENTICATION CREDENTIALS
# Set these environment variables for secure authentication
MEDUSA_USERNAME=your_username_here
MEDUSA_PASSWORD=your_secure_password_here

# 🏆 DATABASE CONNECTION
# PostgreSQL/PsiForceDB connection settings
MEDUSA_DB_HOST=172.236.23.54
MEDUSA_DB_PORT=5432
MEDUSA_DB_NAME=medusa_rts
MEDUSA_DB_USER=medusa
MEDUSA_DB_PASS=your_database_password_here

# 🏆 SECURITY SETTINGS
# Encryption key for secure credential storage
MEDUSA_ENCRYPTION_KEY=your_32_character_encryption_key_here

# 🏆 CREDENTIALS FILE PATH
# Path to encrypted credentials file (optional)
MEDUSA_CREDENTIALS_FILE=/path/to/secure/credentials.enc

# 🏆 SYSTEM SETTINGS
# Application configuration
MEDUSA_ENVIRONMENT=production
MEDUSA_DEBUG=false
MEDUSA_LOG_LEVEL=info

# 🏆 API SETTINGS
# External API configurations
MEDUSA_API_KEY=your_api_key_here
MEDUSA_API_SECRET=your_api_secret_here

# 🏆 NOTIFICATION SETTINGS
# Email and notification configuration
MEDUSA_SMTP_HOST=smtp.yourdomain.com
MEDUSA_SMTP_PORT=587
MEDUSA_SMTP_USER=your_smtp_username
MEDUSA_SMTP_PASS=your_smtp_password
MEDUSA_SMTP_ENCRYPTION=tls

# 🏆 SECURITY HEADERS
# Additional security configurations
MEDUSA_CORS_ORIGINS=https://lamia.website,https://repo.poweredbymedusa.com
MEDUSA_SESSION_SECRET=your_session_secret_here
MEDUSA_CSRF_SECRET=your_csrf_secret_here

# 🏆 PERFORMANCE SETTINGS
# System performance configuration
MEDUSA_CACHE_ENABLED=true
MEDUSA_CACHE_TTL=3600
MEDUSA_MAX_UPLOAD_SIZE=100M
MEDUSA_MEMORY_LIMIT=512M

# 🏆 MONITORING
# System monitoring and logging
MEDUSA_MONITORING_ENABLED=true
MEDUSA_LOG_FILE=/var/log/medusa/application.log
MEDUSA_ERROR_LOG=/var/log/medusa/error.log

# 🏆 BACKUP SETTINGS
# Automated backup configuration
MEDUSA_BACKUP_ENABLED=true
MEDUSA_BACKUP_RETENTION_DAYS=30
MEDUSA_BACKUP_PATH=/var/backups/medusa

# 🏆 INTEGRATION SETTINGS
# Third-party service integrations
MEDUSA_GITHUB_TOKEN=your_github_token_here
MEDUSA_DISCORD_WEBHOOK=your_discord_webhook_url_here
MEDUSA_SLACK_WEBHOOK=your_slack_webhook_url_here

# 🏆 DEVELOPMENT SETTINGS
# Development-specific configurations (not for production)
# MEDUSA_DEV_MODE=true
# MEDUSA_TEST_DATABASE=medusa_test
# MEDUSA_MOCK_SERVICES=true
