    <script>
        // Tab switching functionality
        function switchTab(tabName) {
            const panels = document.querySelectorAll('.tab-panel');
            panels.forEach(panel => panel.classList.remove('active'));
            
            const buttons = document.querySelectorAll('.tab-button');
            buttons.forEach(button => button.classList.remove('active'));
            
            document.getElementById(tabName).classList.add('active');
            event.target.classList.add('active');
        }

        // Code completion functionality
        function triggerCompletion() {
            const loadingSpinner = document.getElementById('loadingSpinner');
            const suggestionsPanel = document.getElementById('suggestionsPanel');
            
            loadingSpinner.style.display = 'block';
            
            setTimeout(() => {
                loadingSpinner.style.display = 'none';
                // Update suggestions with new content
                updateSuggestions();
            }, 1500);
        }

        function updateSuggestions() {
            // Simulate AI-generated suggestions
            const suggestions = [
                {
                    type: 'Function Body',
                    confidence: 96,
                    code: 'return Math.pow(2, n) - 1; // Optimized mathematical approach',
                    explanation: 'Yorkshire Champion AI suggests using mathematical optimization for better performance.'
                },
                {
                    type: 'Error Handling',
                    confidence: 88,
                    code: 'if (n < 0) throw new Error("Input must be non-negative");',
                    explanation: 'Add input validation to prevent runtime errors and improve robustness.'
                }
            ];
            
            // Update suggestions panel with new content
            updateCodeMetrics();
        }

        function updateCodeMetrics() {
            const codeInput = document.getElementById('codeInput');
            const lineCount = codeInput.value.split('\n').length;
            const cursorPos = codeInput.selectionStart;
            
            document.getElementById('lineCount').textContent = lineCount;
            
            // Update other metrics
            const performanceScore = Math.floor(Math.random() * 20 + 80);
            document.getElementById('performanceScore').textContent = performanceScore + '/100';
            
            // Simulate syntax checking
            setTimeout(() => {
                document.getElementById('syntaxStatus').innerHTML = '✅ Valid';
            }, 500);
        }

        function updateCursorPosition() {
            const codeInput = document.getElementById('codeInput');
            const lines = codeInput.value.substr(0, codeInput.selectionStart).split('\n');
            const line = lines.length;
            const column = lines[lines.length - 1].length + 1;
            document.getElementById('cursorPosition').textContent = line + ':' + column;
        }

        // Utility functions
        function clearEditor() {
            document.getElementById('codeInput').value = '';
            updateCodeMetrics();
        }

        function loadExample() {
            const examples = [
                '// Binary search implementation\nfunction binarySearch(arr, target) {\n    let left = 0;\n    let right = arr.length - 1;\n    \n    while (left <= right) {\n        // AI will complete this...\n    }\n}',
                '// React component with hooks\nimport React, { useState, useEffect } from "react";\n\nfunction UserProfile({ userId }) {\n    const [user, setUser] = useState(null);\n    \n    // AI will suggest the rest...\n}',
                '// Python data processing\ndef process_data(data):\n    """Process user data with validation"""\n    if not data:\n        # AI completion here...\n        pass'
            ];
            
            const randomExample = examples[Math.floor(Math.random() * examples.length)];
            document.getElementById('codeInput').value = randomExample;
            updateCodeMetrics();
        }

        function exportCode() {
            const code = document.getElementById('codeInput').value;
            const blob = new Blob([code], { type: 'text/plain' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'generated_code.txt';
            a.click();
            window.URL.revokeObjectURL(url);
        }

        function updateLanguage() {
            const language = document.getElementById('mainLanguageSelect').value;
            // Update editor syntax highlighting based on language
            updateCodeMetrics();
        }

        // Code generation functions
        function generateCustomCode() {
            const prompt = document.getElementById('generationPrompt').value;
            const language = document.getElementById('genLanguage').value;
            const framework = document.getElementById('genFramework').value;
            
            if (!prompt.trim()) {
                alert('Please enter a description of what you want to generate');
                return;
            }
            
            const spinner = document.getElementById('genLoadingSpinner');
            const codeOutput = document.getElementById('generatedCode');
            
            spinner.style.display = 'block';
            codeOutput.value = '// Yorkshire Champion AI is generating your code...\n// This may take a few moments for complex requests...';
            
            setTimeout(() => {
                spinner.style.display = 'none';
                
                // Simulate generated code based on prompt
                let generatedCode = '';
                if (language === 'typescript' && framework === 'express') {
                    generatedCode = `// Yorkshire Champion AI Generated Code
import express, { Request, Response } from 'express';
import jwt from 'jsonwebtoken';
import bcrypt from 'bcrypt';
import { body, validationResult } from 'express-validator';
import rateLimit from 'express-rate-limit';

interface User {
    id: number;
    email: string;
    password: string;
    createdAt: Date;
}

interface AuthRequest {
    email: string;
    password: string;
}

interface AuthResponse {
    success: boolean;
    token?: string;
    user?: Omit<User, 'password'>;
    message?: string;
}

const router = express.Router();

// Rate limiting for authentication attempts
const authLimiter = rateLimit({
    windowMs: 15 * 60 * 1000, // 15 minutes
    max: 5, // limit each IP to 5 requests per windowMs
    message: { error: 'Too many login attempts, please try again later' },
    standardHeaders: true,
    legacyHeaders: false
});

// Input validation middleware
const validateAuth = [
    body('email')
        .isEmail()
        .normalizeEmail()
        .withMessage('Valid email is required'),
    body('password')
        .isLength({ min: 8 })
        .withMessage('Password must be at least 8 characters long')
        .matches(/^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&])[A-Za-z\\d@$!%*?&]/)
        .withMessage('Password must contain uppercase, lowercase, number and special character')
];

/**
 * POST /auth/login
 * Authenticates user and returns JWT token
 * 
 * @route POST /auth/login
 * @param {AuthRequest} req.body - User credentials
 * @returns {AuthResponse} Authentication result with JWT token
 * 
 * @example
 * // Request body
 * {
 *   "email": "user@example.com",
 *   "password": "SecurePass123!"
 * }
 * 
 * // Success response
 * {
 *   "success": true,
 *   "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
 *   "user": {
 *     "id": 1,
 *     "email": "user@example.com",
 *     "createdAt": "2024-01-01T00:00:00.000Z"
 *   }
 * }
 */
router.post('/auth/login', 
    authLimiter,
    validateAuth,
    async (req: Request<{}, AuthResponse, AuthRequest>, res: Response<AuthResponse>) => {
        try {
            // Check validation results
            const errors = validationResult(req);
            if (!errors.isEmpty()) {
                return res.status(400).json({
                    success: false,
                    message: 'Invalid input: ' + errors.array().map(e => e.msg).join(', ')
                });
            }

            const { email, password } = req.body;

            // Find user by email (replace with your database query)
            const user = await findUserByEmail(email);
            if (!user) {
                return res.status(401).json({
                    success: false,
                    message: 'Invalid credentials'
                });
            }

            // Verify password
            const isValidPassword = await bcrypt.compare(password, user.password);
            if (!isValidPassword) {
                return res.status(401).json({
                    success: false,
                    message: 'Invalid credentials'
                });
            }

            // Generate JWT token
            const token = jwt.sign(
                { 
                    userId: user.id, 
                    email: user.email 
                },
                process.env.JWT_SECRET || 'your-secret-key',
                { 
                    expiresIn: '24h',
                    issuer: 'medusa-auth-service',
                    audience: 'medusa-client'
                }
            );

            // Return success response (exclude password)
            const { password: _, ...userWithoutPassword } = user;
            
            res.status(200).json({
                success: true,
                token,
                user: userWithoutPassword,
                message: 'Authentication successful'
            });

        } catch (error) {
            console.error('Authentication error:', error);
            res.status(500).json({
                success: false,
                message: 'Internal server error'
            });
        }
    }
);

// Mock database function (replace with your actual database implementation)
async function findUserByEmail(email: string): Promise<User | null> {
    // This is a placeholder - implement your database query here
    // Example with Prisma, Sequelize, TypeORM, etc.
    return null;
}

export default router;

// Yorkshire Champion AI Notes:
// - Implements comprehensive input validation with express-validator
// - Includes rate limiting to prevent brute force attacks
// - Uses bcrypt for secure password hashing
// - JWT tokens with proper claims and expiration
// - TypeScript interfaces for type safety
// - Comprehensive error handling and logging
// - Follows REST API best practices
// - Includes detailed JSDoc documentation
// - Implements security headers and CSRF protection
// - Performance optimized with Yorkshire Champion 15.0x standards`;
                } else {
                    generatedCode = `// Yorkshire Champion AI Generated Code
// Language: ${language}
// Framework: ${framework}
// Prompt: ${prompt}

// This is a placeholder for the generated code.
// The actual implementation would be generated based on
// your specific requirements and the chosen language/framework.

console.log("Generated with Yorkshire Champion AI 15.0x performance boost!");`;
                }
                
                codeOutput.value = generatedCode;
                document.getElementById('genQualityScore').textContent = (Math.random() * 10 + 90).toFixed(1) + '%';
            }, 3000);
        }

        // Refactoring functions
        function analyzeCode() {
            alert('Analyzing code for refactoring opportunities...');
        }

        function suggestRefactoring() {
            alert('Generating refactoring suggestions...');
        }

        function applyRefactoring() {
            alert('Applying refactoring changes...');
        }

        function revertChanges() {
            alert('Reverting to original code...');
        }

        // Analysis functions
        function analyzeComplexity() {
            alert('Running complexity analysis...');
        }

        function securityAudit() {
            alert('Performing security audit...');
        }

        function performanceAnalysis() {
            alert('Analyzing performance metrics...');
        }

        function architectureReview() {
            alert('Reviewing code architecture...');
        }

        // Generation helper functions
        function generateFunction() {
            document.getElementById('generationPrompt').value = 'Generate a utility function for data validation with TypeScript types, error handling, and comprehensive tests.';
            generateCustomCode();
        }

        function generateClass() {
            document.getElementById('generationPrompt').value = 'Create a class for managing user sessions with authentication, authorization, and audit logging capabilities.';
            generateCustomCode();
        }

        function generateTests() {
            document.getElementById('generationPrompt').value = 'Generate comprehensive unit tests for the provided code including edge cases, mocking, and coverage reports.';
            generateCustomCode();
        }

        function generateDocs() {
            document.getElementById('generationPrompt').value = 'Generate comprehensive documentation including API docs, usage examples, and developer guides.';
            generateCustomCode();
        }

        // Initialize floating particles
        function createAIParticles() {
            const container = document.getElementById('aiParticles');
            for (let i = 0; i < 15; i++) {
                const particle = document.createElement('div');
                particle.className = 'ai-particle';
                particle.style.left = Math.random() * 100 + 'vw';
                particle.style.animationDelay = Math.random() * 12 + 's';
                particle.style.animationDuration = (Math.random() * 8 + 12) + 's';
                container.appendChild(particle);
            }
        }

        // Update activity feed
        function updateActivityFeed() {
            const feed = document.getElementById('activityFeed');
            const activities = [
                'Function completion generated with 98% confidence',
                'Code refactoring suggestion applied - Performance +12%',
                'Security vulnerability detected and fixed',
                'AI model ensemble optimized for current context',
                'Yorkshire Champion boost applied - 15.0x faster execution',
                'Unit tests auto-generated for new function',
                'Code documentation updated with AI assistance'
            ];
            
            const time = new Date().toLocaleTimeString();
            const activity = activities[Math.floor(Math.random() * activities.length)];
            
            const newEntry = document.createElement('div');
            newEntry.style.cssText = 'padding: 3px 0; opacity: 0.8; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 12px;';
            newEntry.textContent = `[${time}] ${activity}`;
            
            feed.insertBefore(newEntry, feed.firstChild);
            
            // Keep only last 8 entries
            while (feed.children.length > 8) {
                feed.removeChild(feed.lastChild);
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            createAIParticles();
            
            // Update activity feed every 8 seconds
            setInterval(updateActivityFeed, 8000);
            
            // Auto-save code every 30 seconds
            setInterval(() => {
                const code = document.getElementById('codeInput').value;
                if (code.trim()) {
                    localStorage.setItem('ai_completion_code', code);
                }
            }, 30000);
            
            // Load saved code on startup
            const savedCode = localStorage.getItem('ai_completion_code');
            if (savedCode) {
                document.getElementById('codeInput').value = savedCode;
                updateCodeMetrics();
            }
            
            // Auto-update statistics
            setInterval(() => {
                const statNumbers = document.querySelectorAll('.stat-number');
                statNumbers.forEach(stat => {
                    if (!stat.textContent.includes('%') && !stat.textContent.includes('x')) {
                        const currentValue = parseInt(stat.textContent.replace(/,/g, ''));
                        if (!isNaN(currentValue)) {
                            const increment = Math.floor(Math.random() * 50) + 1;
                            stat.textContent = (currentValue + increment).toLocaleString();
                        }
                    }
                });
            }, 15000); // Update every 15 seconds
        });

        // Yorkshire Champion AI Code Completion Engine
        class YorkshireChampionAI {
            constructor() {
                this.performanceMultiplier = 15.0;
                this.models = ['Yorkshire Fusion', 'CodeGen Specialized', 'Medusa Native'];
                this.accuracy = 98.7;
            }
            
            async generateCompletion(code, context) {
                const startTime = performance.now();
                
                // Simulate AI processing with Yorkshire Champion optimization
                await new Promise(resolve => {
                    setTimeout(resolve, Math.random() * 100 + 50); // Base time
                });
                
                const endTime = performance.now();
                const baseTime = endTime - startTime;
                const optimizedTime = baseTime / this.performanceMultiplier;
                
                return {
                    suggestions: this.generateSuggestions(code, context),
                    processingTime: optimizedTime,
                    confidence: this.accuracy + Math.random() * 2 - 1,
                    yorkshireBoost: this.performanceMultiplier
                };
            }
            
            generateSuggestions(code, context) {
                // Simulate intelligent code suggestions
                return [
                    {
                        type: 'Function Completion',
                        code: '// AI-generated completion based on context',
                        confidence: 95 + Math.random() * 5
                    }
                ];
            }
        }

        // Initialize Yorkshire Champion AI
        const yorkshireAI = new YorkshireChampionAI();
    </script>
</body>
</html>