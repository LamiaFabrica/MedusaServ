function processUserData(users) {
    var result = [];
    for (var i = 0; i < users.length; i++) {
        if (users[i].age > 18) {
            if (users[i].status === 'active') {
                if (users[i].hasPermission) {
                    result.push({
                        id: users[i].id,
                        name: users[i].name,
                        email: users[i].email,
                        age: users[i].age
                    });
                }
            }
        }
    }
    return result;
}</textarea>
                        </div>

                        <div class="editor-panel">
                            <div class="editor-header">
                                <div class="editor-title">Refactored Code</div>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <span style="font-size: 12px; color: var(--champion-success);">Improvements: 7</span>
                                </div>
                            </div>
                            <textarea class="code-editor" id="refactoredCode" readonly>// Yorkshire Champion AI Refactored Code
const processUserData = (users) => {
    return users
        .filter(isEligibleUser)
        .map(extractUserInfo);
};

const isEligibleUser = (user) => 
    user.age > 18 && 
    user.status === 'active' && 
    user.hasPermission;

const extractUserInfo = ({ id, name, email, age }) => ({
    id,
    name,
    email,
    age
});

// Benefits:
// - Reduced complexity from O(n) to O(n) with better readability
// - Eliminated nested if statements (3 levels → 0 levels)
// - Used modern ES6+ features
// - Separated concerns with pure functions
// - Improved maintainability and testability</textarea>
