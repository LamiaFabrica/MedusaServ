                            <button class="btn btn-sm btn-secondary">Download</button>
                            <button class="btn btn-sm btn-success">Share</button>
                        </div>
                    </div>

                    <div class="report-item">
                        <div class="report-info">
                            <div class="report-name">Security Analysis Report</div>
                            <div class="report-details">Weekly security review - Generated yesterday</div>
                        </div>
                        <div class="report-actions">
                            <button class="btn btn-sm btn-info">View</button>
                            <button class="btn btn-sm btn-secondary">Download</button>
                            <button class="btn btn-sm btn-success">Share</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Analytics Dashboard -->
            <div class="analytics-dashboard">
                <h4>Analytics Dashboard</h4>
                <div class="analytics-charts">
                    <div class="chart-container">
                        <h5>Healing Trends Over Time</h5>
                        <canvas id="healing-trends-chart"></canvas>
                    </div>
                    
                    <div class="chart-container">
                        <h5>Error Types Distribution</h5>
                        <canvas id="error-distribution-chart"></canvas>
                    </div>
                    
                    <div class="chart-container">
                        <h5>Yorkshire Champion Improvements</h5>
                        <canvas id="yorkshire-improvements-chart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.syntax-healer-thingamabob {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
