    animation: uploadFloat 3s ease-in-out infinite;
}

.config-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin: 20px 0;
}

.config-section {
    background: rgba(0,0,0,0.3);
