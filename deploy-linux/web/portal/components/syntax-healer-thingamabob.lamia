}

.report-actions {
    display: flex;
    gap: 10px;
}

.analytics-charts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 30px;
    margin: 30px 0;
}

.chart-container {
    background: rgba(0,0,0,0.3);
    padding: 20px;
    border-radius: 15px;
    border: 1px solid rgba(255,255,255,0.1);
}

/* Animations */
@keyframes healerPulse {
    0%, 100% { text-shadow: 0 0 10px rgba(0, 191, 255, 0.5); }
    50% { text-shadow: 0 0 20px rgba(0, 191, 255, 0.8), 0 0 30px rgba(0, 191, 255, 0.6); }
}

@keyframes championGlow {
    0%, 100% { color: #FFD700; text-shadow: 0 0 10px rgba(255, 215, 0, 0.5); }
    50% { color: #FFA500; text-shadow: 0 0 20px rgba(255, 215, 0, 0.8), 0 0 30px rgba(255, 152, 0, 0.6); }
}

@keyframes championPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

@keyframes scoreGlow {
    0%, 100% { box-shadow: 0 0 5px rgba(255, 215, 0, 0.5); }
    50% { box-shadow: 0 0 15px rgba(255, 215, 0, 0.8), 0 0 25px rgba(255, 152, 0, 0.6); }
}

@keyframes uploadFloat {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}

@keyframes progressShimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
}
</style>

<script>
// Syntax Healer JavaScript Functions
let monitoringActive = false;
let batchProcessingActive = false;

function showHealerTab(tabName) {
    // Hide all tab contents
    const contents = document.querySelectorAll('.tab-content');
    contents.forEach(content => content.classList.remove('active'));
    
    // Remove active from all buttons
    const buttons = document.querySelectorAll('.tab-button');
    buttons.forEach(button => button.classList.remove('active'));
    
    // Show selected tab and mark button as active
    document.getElementById(tabName + '-tab').classList.add('active');
    event.target.classList.add('active');
    
    // Initialize tab-specific functionality
    initializeHealerTab(tabName);
}

function initializeHealerTab(tabName) {
    switch(tabName) {
        case 'overview':
            updateHealingStats();
            break;
        case 'upload':
            setupUploadArea();
            break;
        case 'real-time':
            // Real-time tab initialization
            break;
        case 'reports':
            // Initialize charts
            break;
    }
}

function updateHealingStats() {
    // Simulate stat updates
    const filesHealed = 1847 + Math.floor(Math.random() * 10);
    const issuesFixed = 12634 + Math.floor(Math.random() * 50);
    const successRate = (98.5 + Math.random() * 1.0).toFixed(1);
    const yorkshireMultiplier = (14.5 + Math.random() * 1.0).toFixed(1);
    
    document.getElementById('files-healed').textContent = filesHealed.toLocaleString();
    document.getElementById('issues-fixed').textContent = issuesFixed.toLocaleString();
    document.getElementById('success-rate').textContent = successRate + '%';
    document.getElementById('yorkshire-multiplier').textContent = yorkshireMultiplier + 'x';
}

function setupUploadArea() {
    const uploadArea = document.getElementById('upload-area');
    const fileInput = document.getElementById('file-input');
    
    // Drag and drop event handlers
    uploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadArea.classList.add('dragover');
    });
    
    uploadArea.addEventListener('dragleave', (e) => {
        e.preventDefault();
        uploadArea.classList.remove('dragover');
    });
    
    uploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        uploadArea.classList.remove('dragover');
        handleFileUpload({ target: { files: e.dataTransfer.files } });
    });
}

function handleFileUpload(event) {
    const files = Array.from(event.target.files);
    if (files.length === 0) return;
    
    console.log(`Processing ${files.length} files for healing...`);
    
    // Show progress
    const progressContainer = document.getElementById('upload-progress');
    const progressFill = document.getElementById('upload-progress-fill');
    const progressDetails = document.getElementById('progress-details');
    
    progressContainer.style.display = 'block';
    
    // Simulate file processing
    let processedFiles = 0;
    const totalFiles = files.length;
    
    const processFile = (file, index) => {
        setTimeout(() => {
            processedFiles++;
            const progress = (processedFiles / totalFiles) * 100;
            
            progressFill.style.width = progress + '%';
            progressDetails.innerHTML = `Processing ${file.name}... (${processedFiles}/${totalFiles})`;
            
            // Simulate healing result
            const healingResult = {
                filename: file.name,
                success: Math.random() > 0.1,
                issuesFound: Math.floor(Math.random() * 15 + 1),
                issuesFixed: Math.floor(Math.random() * 12 + 1),
                yorkshireScore: (12.0 + Math.random() * 6.0).toFixed(1)
            };
            
            displayUploadResult(healingResult);
            
            if (processedFiles === totalFiles) {
                setTimeout(() => {
                    progressContainer.style.display = 'none';
                    alert(`File processing complete!\n${processedFiles} files processed with Yorkshire Champion healing.`);
                }, 1000);
            }
        }, index * 500 + 500);
    };
    
    files.forEach((file, index) => {
        processFile(file, index);
    });
}

function displayUploadResult(result) {
    const resultsContainer = document.getElementById('upload-results');
    
    const resultElement = document.createElement('div');
    resultElement.className = `upload-result ${result.success ? 'success' : 'error'}`;
    resultElement.innerHTML = `
        <div class="result-header">
            <span class="result-icon">${result.success ? '✅' : '❌'}</span>
            <span class="result-filename">${result.filename}</span>
            <span class="result-status">${result.success ? 'HEALED' : 'FAILED'}</span>
        </div>
        <div class="result-details">
            Issues found: ${result.issuesFound}, Fixed: ${result.issuesFixed}
            ${result.success ? `| Yorkshire Score: ${result.yorkshireScore}x` : ''}
        </div>
    `;
    
    resultsContainer.appendChild(resultElement);
    
    // Auto-scroll to show latest result
    resultElement.scrollIntoView({ behavior: 'smooth' });
}

function updateStrictnessDisplay(value) {
    const display = document.getElementById('strictness-display');
    const levels = {
        1: '1 (Very Lenient)', 2: '2 (Lenient)', 3: '3 (Relaxed)',
        4: '4 (Moderate)', 5: '5 (Balanced)', 6: '6 (Thorough)',
        7: '7 (Recommended)', 8: '8 (Strict)', 9: '9 (Very Strict)', 10: '10 (Maximum)'
    };
    display.textContent = levels[value] || `${value} (Custom)`;
}

function updateConfidenceDisplay(value) {
    document.getElementById('confidence-display').textContent = `${value} (${Math.round(value * 100)}%)`;
}

function toggleMonitoring() {
    monitoringActive = !monitoringActive;
    const btn = document.getElementById('start-monitoring');
    
    if (monitoringActive) {
        btn.innerHTML = '<i class="fas fa-stop"></i> Stop Monitoring';
        btn.className = 'btn btn-danger';
        startRealTimeMonitoring();
    } else {
        btn.innerHTML = '<i class="fas fa-play"></i> Start Monitoring';
        btn.className = 'btn btn-success';
        stopRealTimeMonitoring();
    }
}

function startRealTimeMonitoring() {
    const changesFeed = document.getElementById('changes-feed');
    
    // Simulate file changes
    const simulateChanges = () => {
        if (!monitoringActive) return;
        
        const changes = [
            { type: 'success', file: 'index.php', action: 'Fixed 3 syntax errors' },
            { type: 'info', file: 'app.js', action: 'Validated successfully' },
            { type: 'warning', file: 'legacy.cpp', action: 'Performance issues detected' },
            { type: 'success', file: 'styles.css', action: 'Formatting improved' }
        ];
        
        const change = changes[Math.floor(Math.random() * changes.length)];
        const timestamp = new Date().toLocaleTimeString();
        
        const feedItem = document.createElement('div');
        feedItem.className = `feed-item ${change.type}`;
        feedItem.innerHTML = `
            <div class="feed-icon">${change.type === 'success' ? '✅' : change.type === 'warning' ? '⚠️' : 'ℹ️'}</div>
            <div class="feed-content">
                <div class="feed-title">${change.file}</div>
                <div class="feed-details">${change.action}</div>
                <div class="feed-time">${timestamp}</div>
            </div>
        `;
        
        changesFeed.appendChild(feedItem);
        feedItem.scrollIntoView({ behavior: 'smooth' });
        
        // Keep only last 20 items
        while (changesFeed.children.length > 20) {
            changesFeed.removeChild(changesFeed.firstChild);
        }
        
        setTimeout(simulateChanges, 3000 + Math.random() * 5000);
    };
    
    simulateChanges();
}

function stopRealTimeMonitoring() {
    // Real-time monitoring stopped
    console.log('Real-time monitoring stopped');
}

function startBatchProcessing() {
    if (batchProcessingActive) return;
    
    batchProcessingActive = true;
    const progressContainer = document.getElementById('batch-progress');
    const progressFill = document.getElementById('batch-progress-fill');
    const currentFile = document.getElementById('current-file');
    
    progressContainer.style.display = 'block';
    document.getElementById('stop-batch').disabled = false;
    
    // Simulate batch processing
    const totalFiles = 150 + Math.floor(Math.random() * 50);
    let processedFiles = 0;
    let successFiles = 0;
    let errorFiles = 0;
    
    document.getElementById('total-files').textContent = totalFiles;
    
    const processBatchFile = () => {
        if (!batchProcessingActive || processedFiles >= totalFiles) {
            completeBatchProcessing();
            return;
        }
        
        processedFiles++;
        const success = Math.random() > 0.1;
        
        if (success) {
            successFiles++;
        } else {
            errorFiles++;
        }
        
        // Update progress
        const progress = (processedFiles / totalFiles) * 100;
        progressFill.style.width = progress + '%';
        
        document.getElementById('processed-files').textContent = processedFiles;
        document.getElementById('success-files').textContent = successFiles;
        document.getElementById('error-files').textContent = errorFiles;
        
        currentFile.textContent = `file_${processedFiles}.${['php', 'js', 'cpp', 'py', 'html'][Math.floor(Math.random() * 5)]}`;
        
        setTimeout(processBatchFile, 50 + Math.random() * 100);
    };
    
    processBatchFile();
}

function stopBatchProcessing() {
    batchProcessingActive = false;
    document.getElementById('stop-batch').disabled = true;
    document.getElementById('current-file').textContent = 'Processing stopped by user';
}

function completeBatchProcessing() {
    batchProcessingActive = false;
    document.getElementById('stop-batch').disabled = true;
    document.getElementById('current-file').textContent = 'Batch processing completed!';
    
    setTimeout(() => {
        document.getElementById('batch-progress').style.display = 'none';
        alert('Batch processing completed successfully!');
    }, 2000);
}

function previewBatchFiles() {
    alert('Preview would show list of files to be processed based on current filters');
}

function addCustomRule() {
    const name = document.getElementById('custom-rule-name').value;
    const pattern = document.getElementById('custom-rule-pattern').value;
    const message = document.getElementById('custom-rule-message').value;
    const severity = document.getElementById('custom-rule-severity').value;
    
    if (!name || !pattern || !message) {
        alert('Please fill in all fields for the custom rule');
        return;
    }
    
    alert(`Custom rule "${name}" added successfully!`);
    
    // Clear form
    document.getElementById('custom-rule-name').value = '';
    document.getElementById('custom-rule-pattern').value = '';
    document.getElementById('custom-rule-message').value = '';
}

function generateReport() {
    const reportType = document.getElementById('report-type').value;
    const period = document.getElementById('report-period').value;
    const format = document.getElementById('report-format').value;
    
    alert(`Generating ${reportType} report for ${period} in ${format} format...`);
    
    setTimeout(() => {
        alert('Report generated successfully! Download will start shortly.');
    }, 3000);
}

// Initialize when page loads
document.addEventListener('DOMContentLoaded', function() {
    // Start with overview tab
    initializeHealerTab('overview');
    
    // Update stats every 10 seconds
    setInterval(updateHealingStats, 10000);
});
</script>}
