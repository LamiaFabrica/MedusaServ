<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Resource Monitor - PFQL Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/portal-style.css">
</head>
<body>
    <div class="portal-header">
        <h1>📊 System Resource Monitor</h1>
        <div class="portal-status" id="resourceStatus">
            <span class="status-indicator online"></span>
            Resource Monitor: ACTIVE
        </div>
    </div>

    <div class="service-container">
        <div class="service-controls">
            <button class="service-btn" onclick="resourceMonitor.startMonitoring()">▶️ Start Monitor</button>
            <button class="service-btn" onclick="resourceMonitor.stopMonitoring()">⏹️ Stop Monitor</button>
            <button class="service-btn" onclick="resourceMonitor.resourceReport()">📋 Resource Report</button>
            <button class="service-btn" onclick="resourceMonitor.killProcess()">❌ Kill Process</button>
        </div>

        <div class="resource-dashboard" id="resourceDashboard">
            <div class="resource-grid">
                <div class="resource-card">
                    <h4>CPU Usage</h4>
                    <div class="resource-chart">
                        <div class="chart-bar" id="cpuChart"></div>
                    </div>
                    <div class="resource-details">
                        <div>Current: <span id="cpuCurrent">23%</span></div>
                        <div>Average: <span id="cpuAverage">18%</span></div>
                        <div>Peak: <span id="cpuPeak">67%</span></div>
                    </div>
                </div>
                
                <div class="resource-card">
                    <h4>Memory Usage</h4>
                    <div class="resource-chart">
                        <div class="chart-bar" id="memoryChart"></div>
                    </div>
                    <div class="resource-details">
                        <div>Used: <span id="memoryUsed">6.2GB</span></div>
                        <div>Free: <span id="memoryFree">9.8GB</span></div>
                        <div>Total: <span id="memoryTotal">16GB</span></div>
                    </div>
                </div>
                
                <div class="resource-card">
                    <h4>Disk I/O</h4>
                    <div class="resource-chart">
                        <div class="chart-bar" id="diskChart"></div>
                    </div>
                    <div class="resource-details">
                        <div>Read: <span id="diskRead">45 MB/s</span></div>
                        <div>Write: <span id="diskWrite">12 MB/s</span></div>
                        <div>IOPS: <span id="diskIOPS">230</span></div>
                    </div>
                </div>
                
                <div class="resource-card">
                    <h4>Network I/O</h4>
                    <div class="resource-chart">
                        <div class="chart-bar" id="networkChart"></div>
                    </div>
                    <div class="resource-details">
                        <div>In: <span id="networkIn">2.3 MB/s</span></div>
                        <div>Out: <span id="networkOut">1.8 MB/s</span></div>
                        <div>Packets: <span id="networkPackets">1,247/s</span></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="process-list" id="processList">
            <h3>🔧 Top Processes</h3>
            <div class="process-table">
                <!-- Process list will be populated here -->
            </div>
        </div>

        <div class="service-output" id="resourceOutput">
            <div>[RESOURCE] System resource monitor initialized</div>
            <div>[RESOURCE] Connected to PsiForceDB on 172.236.23.54</div>
            <div>[RESOURCE] Monitoring system resources in real-time...</div>
        </div>
    </div>

    <script>
        class SystemResourceMonitor {
            constructor() {
                this.monitoring = false;
                this.monitoringInterval = null;
                this.resourceHistory = {
                    cpu: [],
                    memory: [],
                    disk: [],
                    network: []
                };
                this.init();
            }

            async init() {
                await this.connectToPsiForceDB();
                await this.loadResourceData();
                await this.loadProcessList();
            }

            async connectToPsiForceDB() {
                try {
                    const response = await fetch('/api/pfql-routes/system/resources/status', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            server: '172.236.23.54',
                            database: 'psiforcedb_system'
                        })
                    });
                    
                    if (response.ok) {
                        this.logOutput('[RESOURCE] Connected to PsiForceDB resource monitoring system');
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Connection failed: ${error.message}`);
                }
            }

            startMonitoring() {
                if (!this.monitoring) {
                    this.monitoring = true;
                    this.logOutput('[RESOURCE] Starting real-time resource monitoring...');
                    
                    this.monitoringInterval = setInterval(async () => {
                        await this.loadResourceData();
                        await this.loadProcessList();
                    }, 2000); // Every 2 seconds
                    
                    document.getElementById('resourceStatus').innerHTML = 
                        '<span class="status-indicator online"></span>Resource Monitor: MONITORING';
                }
            }

            stopMonitoring() {
                if (this.monitoring) {
                    this.monitoring = false;
                    if (this.monitoringInterval) {
                        clearInterval(this.monitoringInterval);
                        this.monitoringInterval = null;
                    }
                    this.logOutput('[RESOURCE] Resource monitoring stopped');
                    
                    document.getElementById('resourceStatus').innerHTML = 
                        '<span class="status-indicator warning"></span>Resource Monitor: STOPPED';
                }
            }

            async loadResourceData() {
                try {
                    const response = await fetch('/api/pfql-routes/system/resources/current', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://system:resources:current',
                            server: '172.236.23.54'
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        this.updateResourceDisplay(result);
                        this.updateResourceHistory(result);
                    }
                } catch (error) {
                    // Use simulated data if real data unavailable
                    this.updateResourceDisplay(this.getSimulatedData());
                }
            }

            async loadProcessList() {
                try {
                    const response = await fetch('/api/pfql-routes/system/resources/processes', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://system:processes:top',
                            server: '172.236.23.54',
                            limit: 10
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        this.displayProcessList(result.processes);
                    }
                } catch (error) {
                    // Use simulated process data
                    this.displayProcessList(this.getSimulatedProcesses());
                }
            }

            async resourceReport() {
                this.logOutput('[RESOURCE] Generating resource utilization report...');
                try {
                    const response = await fetch('/api/pfql-routes/system/resources/report', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://system:resources:report',
                            server: '172.236.23.54',
                            timeframe: '1h'
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        this.displayResourceReport(result);
                        this.logOutput('[RESOURCE] Resource report generated');
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Report generation failed: ${error.message}`);
                }
            }

            async killProcess() {
                const pid = prompt('Enter Process ID (PID) to terminate:');
                if (pid) {
                    const confirmKill = confirm(`Are you sure you want to terminate process ${pid}?`);
                    if (confirmKill) {
                        this.logOutput(`[RESOURCE] Terminating process ${pid}...`);
                        try {
                            const response = await fetch('/api/pfql-routes/system/resources/kill', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    ...window.pfqlAuth.getAuthHeaders()
                                },
                                body: JSON.stringify({
                                    command: 'pf://system:process:kill',
                                    server: '172.236.23.54',
                                    pid: parseInt(pid)
                                })
                            });
                            
                            if (response.ok) {
                                const result = await response.json();
                                this.logOutput(`[RESOURCE] Process ${pid} terminated: ${result.status}`);
                                await this.loadProcessList(); // Refresh process list
                            }
                        } catch (error) {
                            this.logOutput(`[ERROR] Failed to terminate process: ${error.message}`);
                        }
                    }
                }
            }

            updateResourceDisplay(data) {
                // CPU
                const cpuUsage = data.cpu?.usage || 23;
                document.getElementById('cpuCurrent').textContent = cpuUsage + '%';
                document.getElementById('cpuAverage').textContent = (data.cpu?.average || 18) + '%';
                document.getElementById('cpuPeak').textContent = (data.cpu?.peak || 67) + '%';
                this.updateChart('cpuChart', cpuUsage);
                
                // Memory
                const memoryUsed = data.memory?.used || 6.2;
                const memoryTotal = data.memory?.total || 16;
                document.getElementById('memoryUsed').textContent = memoryUsed + 'GB';
                document.getElementById('memoryFree').textContent = (memoryTotal - memoryUsed).toFixed(1) + 'GB';
                document.getElementById('memoryTotal').textContent = memoryTotal + 'GB';
                this.updateChart('memoryChart', (memoryUsed / memoryTotal) * 100);
                
                // Disk I/O
                document.getElementById('diskRead').textContent = (data.disk?.read || 45) + ' MB/s';
                document.getElementById('diskWrite').textContent = (data.disk?.write || 12) + ' MB/s';
                document.getElementById('diskIOPS').textContent = data.disk?.iops || 230;
                this.updateChart('diskChart', Math.min((data.disk?.read || 45) / 100 * 100, 100));
                
                // Network I/O
                document.getElementById('networkIn').textContent = (data.network?.in || 2.3) + ' MB/s';
                document.getElementById('networkOut').textContent = (data.network?.out || 1.8) + ' MB/s';
                document.getElementById('networkPackets').textContent = (data.network?.packets || 1247) + '/s';
                this.updateChart('networkChart', Math.min((data.network?.in || 2.3) / 10 * 100, 100));
            }

            updateChart(chartId, percentage) {
                const chart = document.getElementById(chartId);
                chart.style.width = percentage + '%';
                
                // Color based on usage level
                if (percentage > 80) {
                    chart.style.backgroundColor = '#F44336'; // Red
                } else if (percentage > 60) {
                    chart.style.backgroundColor = '#FF9800'; // Orange
                } else {
                    chart.style.backgroundColor = '#4CAF50'; // Green
                }
            }

            displayProcessList(processes) {
                const container = document.getElementById('processList');
                const processTable = container.querySelector('.process-table');
                
                if (processes && processes.length > 0) {
                    processTable.innerHTML = `
                        <div class="process-header">
                            <span>PID</span>
                            <span>Name</span>
                            <span>CPU%</span>
                            <span>Memory</span>
                            <span>Actions</span>
                        </div>
                        ${processes.map(process => `
                            <div class="process-row">
                                <span>${process.pid}</span>
                                <span class="process-name">${process.name}</span>
                                <span class="cpu-usage">${process.cpu}%</span>
                                <span>${process.memory}</span>
                                <span>
                                    <button class="process-action" onclick="resourceMonitor.inspectProcess(${process.pid})">
                                        Inspect
                                    </button>
                                    <button class="process-action danger" onclick="resourceMonitor.terminateProcess(${process.pid})">
                                        Kill
                                    </button>
                                </span>
                            </div>
                        `).join('')}
                    `;
                } else {
                    processTable.innerHTML = '<div class="no-processes">No process data available</div>';
                }
            }

            inspectProcess(pid) {
                this.logOutput(`[RESOURCE] Inspecting process ${pid}...`);
                // Show process details in a modal or expanded view
                alert(`Process ${pid} inspection - Feature would show detailed process information`);
            }

            terminateProcess(pid) {
                const confirmKill = confirm(`Terminate process ${pid}?`);
                if (confirmKill) {
                    this.logOutput(`[RESOURCE] Terminating process ${pid}...`);
                    // Simulate process termination
                    setTimeout(() => {
                        this.logOutput(`[RESOURCE] Process ${pid} terminated`);
                        this.loadProcessList();
                    }, 1000);
                }
            }

            updateResourceHistory(data) {
                // Keep last 60 data points (2 minutes at 2-second intervals)
                const maxHistory = 60;
                
                if (data.cpu) {
                    this.resourceHistory.cpu.push(data.cpu.usage || 23);
                    if (this.resourceHistory.cpu.length > maxHistory) {
                        this.resourceHistory.cpu.shift();
                    }
                }
            }

            getSimulatedData() {
                return {
                    cpu: {
                        usage: 20 + Math.random() * 30,
                        average: 18 + Math.random() * 10,
                        peak: 60 + Math.random() * 20
                    },
                    memory: {
                        used: 5 + Math.random() * 3,
                        total: 16
                    },
                    disk: {
                        read: 20 + Math.random() * 50,
                        write: 5 + Math.random() * 20,
                        iops: 200 + Math.random() * 100
                    },
                    network: {
                        in: 1 + Math.random() * 3,
                        out: 0.5 + Math.random() * 2,
                        packets: 1000 + Math.random() * 500
                    }
                };
            }

            getSimulatedProcesses() {
                return [
                    { pid: 1234, name: 'psiforcedb', cpu: 15.2, memory: '2.1GB' },
                    { pid: 5678, name: 'nginx', cpu: 8.7, memory: '245MB' },
                    { pid: 9012, name: 'node', cpu: 6.3, memory: '1.8GB' },
                    { pid: 3456, name: 'postgres', cpu: 4.1, memory: '892MB' },
                    { pid: 7890, name: 'systemd', cpu: 2.8, memory: '128MB' }
                ];
            }

            logOutput(message) {
                const output = document.getElementById('resourceOutput');
                const timestamp = new Date().toLocaleTimeString();
                output.innerHTML += `<div>[${timestamp}] ${message}</div>`;
                output.scrollTop = output.scrollHeight;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            window.resourceMonitor = new SystemResourceMonitor();
        });
    </script>
    
    <style>
        .resource-dashboard {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #64B5F6;
            border-radius: 6px;
            padding: 15px;
            margin: 15px 0;
        }
        .resource-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }
        .resource-card {
            background: rgba(100, 181, 246, 0.1);
            border: 1px solid #64B5F6;
            border-radius: 6px;
            padding: 15px;
        }
        .resource-chart {
            height: 20px;
            background: #333;
            border-radius: 10px;
            overflow: hidden;
            margin: 10px 0;
        }
        .chart-bar {
            height: 100%;
            background: #4CAF50;
            width: 0%;
            border-radius: 10px;
            transition: width 0.3s ease, background-color 0.3s ease;
        }
        .resource-details {
            font-size: 14px;
        }
        .resource-details div {
            margin: 3px 0;
            display: flex;
            justify-content: space-between;
        }
        .process-list {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #64B5F6;
            border-radius: 6px;
            padding: 15px;
            margin: 15px 0;
        }
        .process-table {
            margin-top: 10px;
        }
        .process-header {
            display: grid;
            grid-template-columns: 80px 1fr 80px 100px 120px;
            gap: 10px;
            font-weight: bold;
            background: rgba(100, 181, 246, 0.2);
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 5px;
        }
        .process-row {
            display: grid;
            grid-template-columns: 80px 1fr 80px 100px 120px;
            gap: 10px;
            padding: 8px 10px;
            border: 1px solid rgba(100, 181, 246, 0.3);
            border-radius: 4px;
            margin-bottom: 2px;
            background: rgba(255, 255, 255, 0.05);
        }
        .process-name {
            font-family: monospace;
        }
        .cpu-usage {
            text-align: right;
        }
        .process-action {
            background: #64B5F6;
            border: none;
            border-radius: 3px;
            color: white;
            padding: 3px 8px;
            cursor: pointer;
            font-size: 11px;
            margin-right: 3px;
        }
        .process-action.danger {
            background: #F44336;
        }
        .process-action:hover {
            opacity: 0.8;
        }
    </style>
</body>
</html>