<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chaos Management - PFQL Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/portal-style.css">
    <style>
        .chaos-container {
            background: linear-gradient(135deg, #330000, #800000);
            border-radius: 12px;
            padding: 20px;
            margin: 10px 0;
            position: relative;
            overflow: hidden;
        }
        .chaos-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><path d="M10 10l80 30-40 40 20-60z" fill="none" stroke="rgba(255,69,0,0.1)" stroke-width="0.5"/></svg>') repeat;
            animation: chaosFlow 15s linear infinite;
            pointer-events: none;
        }
        @keyframes chaosFlow {
            0% { transform: translate(0, 0) rotate(0deg); }
            100% { transform: translate(-50px, -50px) rotate(360deg); }
        }
        .chaos-matrix {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 20px;
            position: relative;
            z-index: 1;
        }
        .chaos-service {
            background: rgba(255, 69, 0, 0.1);
            border: 2px solid #FF4500;
            border-radius: 8px;
            padding: 15px;
            transition: all 0.3s ease;
            position: relative;
        }
        .chaos-service:hover {
            background: rgba(255, 69, 0, 0.2);
            transform: scale(1.02) rotate(1deg);
            box-shadow: 0 0 25px rgba(255, 69, 0, 0.6);
        }
        .chaos-meter {
            width: 100%;
            height: 20px;
            background: #333;
            border-radius: 10px;
            overflow: hidden;
            margin: 10px 0;
            position: relative;
        }
        .chaos-progress {
            height: 100%;
            background: linear-gradient(90deg, #FF4500, #DC143C, #8B0000);
            border-radius: 10px;
            transition: width 0.5s ease;
            animation: chaosFlicker 3s ease-in-out infinite;
        }
        @keyframes chaosFlicker {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        .chaos-field {
            background: linear-gradient(45deg, rgba(255, 69, 0, 0.1), rgba(220, 20, 60, 0.1));
            border: 2px dashed #FF4500;
            border-radius: 8px;
            padding: 20px;
            margin: 15px 0;
            position: relative;
            overflow: hidden;
        }
        .chaos-field::after {
            content: '';
            position: absolute;
            top: -100%;
            left: -100%;
            width: 300%;
            height: 300%;
            background: radial-gradient(circle, rgba(255, 69, 0, 0.05) 0%, transparent 70%);
            animation: chaosSwirl 25s linear infinite;
        }
        @keyframes chaosSwirl {
            0% { transform: rotate(0deg) scale(1); }
            50% { transform: rotate(180deg) scale(1.2); }
            100% { transform: rotate(360deg) scale(1); }
        }
        .chaos-controls {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin: 15px 0;
            position: relative;
            z-index: 2;
        }
        .chaos-btn {
            background: linear-gradient(135deg, #FF4500, #DC143C);
            border: none;
            border-radius: 6px;
            color: white;
            padding: 10px 15px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
            position: relative;
        }
        .chaos-btn:hover {
            transform: translateY(-2px) rotate(-2deg);
            box-shadow: 0 5px 20px rgba(255, 69, 0, 0.6);
        }
        .chaos-btn:active {
            transform: scale(0.95) rotate(2deg);
        }
        .chaos-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin: 20px 0;
            position: relative;
            z-index: 1;
        }
        .chaos-stat {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid #FF4500;
            border-radius: 6px;
            padding: 12px;
            text-align: center;
            transition: all 0.3s ease;
        }
        .chaos-stat:hover {
            border-color: #DC143C;
            background: rgba(255, 69, 0, 0.1);
        }
        .chaos-output {
            background: #000;
            border: 2px solid #FF4500;
            border-radius: 6px;
            padding: 15px;
            font-family: 'Courier New', monospace;
            color: #FF4500;
            max-height: 200px;
            overflow-y: auto;
            margin: 10px 0;
            position: relative;
            z-index: 1;
        }
        .chaos-grid {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 5px;
            margin: 15px 0;
            position: relative;
            z-index: 1;
        }
        .chaos-node {
            background: #800000;
            border: 1px solid #FF4500;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
        }
        .chaos-node:hover {
            background: #FF4500;
            transform: scale(1.2) rotate(15deg);
            box-shadow: 0 0 10px #FF4500;
        }
        .chaos-node.active {
            background: #DC143C;
            animation: chaosNodePulse 1.5s infinite;
        }
        @keyframes chaosNodePulse {
            0%, 100% { transform: scale(1) rotate(0deg); }
            50% { transform: scale(1.3) rotate(10deg); }
        }
        .entropy-visualizer {
            width: 100%;
            height: 100px;
            background: #000;
            border: 1px solid #FF4500;
            border-radius: 4px;
            position: relative;
            overflow: hidden;
            margin: 10px 0;
        }
        .entropy-wave {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #FF4500, transparent);
            animation: entropyWave 4s ease-in-out infinite;
        }
        @keyframes entropyWave {
            0%, 100% { transform: translateX(-100%); height: 2px; }
            50% { transform: translateX(100%); height: 20px; }
        }
    </style>
</head>
<body>
    <div class="portal-header">
        <h1>🌪️ Chaos Management Portal</h1>
        <div class="portal-status" id="chaosStatus">
            <span class="status-indicator warning"></span>
            Chaos Field: CONTROLLED
        </div>
    </div>

    <div class="chaos-container">
        <div class="portal-section">
            <h2>🔥 Chaos Services Matrix</h2>
            <div class="chaos-matrix" id="chaosMatrix">
                <!-- Chaos services will be populated here -->
            </div>
        </div>

        <div class="portal-section">
            <h3>⚡ Chaos Field Control</h3>
            <div class="chaos-field" id="chaosField">
                <div class="chaos-controls">
                    <button class="chaos-btn" onclick="chaosManager.injectChaos()">💥 Inject</button>
                    <button class="chaos-btn" onclick="chaosManager.stabilize()">⚖️ Stabilize</button>
                    <button class="chaos-btn" onclick="chaosManager.amplify()">📈 Amplify</button>
                    <button class="chaos-btn" onclick="chaosManager.redirect()">🎯 Redirect</button>
                    <button class="chaos-btn" onclick="chaosManager.mutate()">🧬 Mutate</button>
                    <button class="chaos-btn" onclick="chaosManager.cascade()">🌊 Cascade</button>
                </div>
                
                <div class="chaos-stats" id="chaosStats">
                    <div class="chaos-stat">
                        <div>Entropy Level</div>
                        <div class="chaos-meter">
                            <div class="chaos-progress" id="entropyLevel" style="width: 73%"></div>
                        </div>
                        <div id="entropyValue">73%</div>
                    </div>
                    <div class="chaos-stat">
                        <div>Stability Index</div>
                        <div class="chaos-meter">
                            <div class="chaos-progress" id="stabilityIndex" style="width: 61%"></div>
                        </div>
                        <div id="stabilityValue">61%</div>
                    </div>
                    <div class="chaos-stat">
                        <div>Mutation Rate</div>
                        <div class="chaos-meter">
                            <div class="chaos-progress" id="mutationRate" style="width: 84%"></div>
                        </div>
                        <div id="mutationValue">84%</div>
                    </div>
                    <div class="chaos-stat">
                        <div>Cascade Potential</div>
                        <div class="chaos-meter">
                            <div class="chaos-progress" id="cascadePotential" style="width: 56%"></div>
                        </div>
                        <div id="cascadeValue">56%</div>
                    </div>
                </div>

                <div class="entropy-visualizer">
                    <div class="entropy-wave"></div>
                    <div class="entropy-wave" style="animation-delay: -2s; background: linear-gradient(90deg, transparent, #DC143C, transparent);"></div>
                </div>

                <div class="chaos-grid" id="chaosGrid">
                    <!-- Chaos nodes will be populated here -->
                </div>
            </div>
        </div>

        <div class="portal-section">
            <h3>📊 Chaos Operations Log</h3>
            <div class="chaos-output" id="chaosOutput">
                <div>[CHAOS] System initialized - Yorkshire Champion Chaos Control</div>
                <div>[CHAOS] PsiForceDB chaos engine connected</div>
                <div>[CHAOS] Entropy levels stabilized at 73%</div>
                <div>[CHAOS] Ready for chaos operations...</div>
            </div>
        </div>
    </div>

    <script>
        class PFQLChaosManager {
            constructor() {
                this.chaosServices = [
                    {
                        id: 'chaos_injection',
                        name: 'Chaos Injection',
                        description: 'Controlled chaos injection for system testing and resilience',
                        status: 'active',
                        entropy: 73,
                        commands: ['pf://chaos:inject', 'pf://chaos:disrupt', 'pf://chaos:stress']
                    },
                    {
                        id: 'chaos_stabilization',
                        name: 'Chaos Stabilization',
                        description: 'Stabilize chaotic systems and reduce entropy',
                        status: 'active',
                        entropy: 61,
                        commands: ['pf://chaos:stabilize', 'pf://chaos:calm', 'pf://chaos:equilibrium']
                    },
                    {
                        id: 'chaos_amplification',
                        name: 'Chaos Amplification',
                        description: 'Amplify chaos patterns for advanced testing',
                        status: 'warning',
                        entropy: 84,
                        commands: ['pf://chaos:amplify', 'pf://chaos:boost', 'pf://chaos:intensify']
                    },
                    {
                        id: 'chaos_redirection',
                        name: 'Chaos Redirection',
                        description: 'Redirect and channel chaos energy efficiently',
                        status: 'active',
                        entropy: 56,
                        commands: ['pf://chaos:redirect', 'pf://chaos:channel', 'pf://chaos:focus']
                    }
                ];
                this.init();
            }

            async init() {
                this.renderChaosServices();
                this.renderChaosGrid();
                this.startChaosMonitoring();
                await this.connectToPsiForceDB();
                this.startEntropyAnimation();
            }

            async connectToPsiForceDB() {
                try {
                    // REAL PSIFORCEDB CHAOS INTEGRATION
                    const response = await fetch('/api/pfql-routes/chaos/status', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://chaos:status',
                            server: '172.236.23.54',
                            database: 'psiforcedb_chaos'
                        })
                    });

                    if (response.ok) {
                        const data = await response.json();
                        this.updateChaosMetricsFromReal(data);
                        this.logOutput('[CHAOS] Connected to PsiForceDB chaos engine');
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Failed to connect to PsiForceDB: ${error.message}`);
                }
            }

            renderChaosServices() {
                const matrix = document.getElementById('chaosMatrix');
                matrix.innerHTML = this.chaosServices.map(service => `
                    <div class="chaos-service" data-service="${service.id}">
                        <h4>${service.name}</h4>
                        <p>${service.description}</p>
                        <div class="chaos-meter">
                            <div class="chaos-progress" style="width: ${service.entropy}%"></div>
                        </div>
                        <div>Entropy: ${service.entropy}%</div>
                        <div class="chaos-controls">
                            <button class="chaos-btn" onclick="chaosManager.executeService('${service.id}')">
                                Execute
                            </button>
                            <button class="chaos-btn" onclick="chaosManager.configureService('${service.id}')">
                                Configure
                            </button>
                        </div>
                    </div>
                `).join('');
            }

            renderChaosGrid() {
                const grid = document.getElementById('chaosGrid');
                let nodes = '';
                for (let i = 1; i <= 64; i++) {
                    const isActive = Math.random() > 0.6;
                    nodes += `<div class="chaos-node ${isActive ? 'active' : ''}" onclick="chaosManager.toggleChaosNode(${i})">${i}</div>`;
                }
                grid.innerHTML = nodes;
            }

            async executeCommand(command, params = []) {
                try {
                    // REAL PSIFORCEDB CHAOS COMMAND EXECUTION
                    const response = await fetch('/api/pfql-routes/chaos/execute', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: command,
                            params: params,
                            server: '172.236.23.54',
                            database: 'psiforcedb_chaos',
                            chaosLevel: 'controlled'
                        })
                    });

                    if (response.ok) {
                        const result = await response.json();
                        this.logOutput(`[CHAOS] ${command} executed successfully`);
                        this.parseChaosOutput(result);
                        return result;
                    } else {
                        throw new Error(`Command failed: ${response.statusText}`);
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Command execution failed: ${error.message}`);
                    throw error;
                }
            }

            async injectChaos() {
                this.logOutput('[CHAOS] Initiating controlled chaos injection...');
                await this.executeCommand('pf://chaos:inject', ['--level=moderate', '--target=resilience']);
                this.updateEntropyMeter(85);
                this.animateRandomNodes();
            }

            async stabilize() {
                this.logOutput('[CHAOS] Stabilizing chaotic systems...');
                await this.executeCommand('pf://chaos:stabilize', ['--method=gradual', '--target=equilibrium']);
                this.updateStabilityMeter(78);
                this.calmNodes();
            }

            async amplify() {
                this.logOutput('[CHAOS] Amplifying chaos patterns...');
                await this.executeCommand('pf://chaos:amplify', ['--factor=2.5', '--safety=maintained']);
                this.updateMutationMeter(92);
                this.intensifyNodes();
            }

            async redirect() {
                this.logOutput('[CHAOS] Redirecting chaos energy...');
                await this.executeCommand('pf://chaos:redirect', ['--channel=productive', '--efficiency=maximum']);
                this.updateCascadeMeter(43);
                this.channelNodes();
            }

            async mutate() {
                this.logOutput('[CHAOS] Triggering controlled mutations...');
                await this.executeCommand('pf://chaos:mutate', ['--rate=controlled', '--scope=targeted']);
                this.updateMutationMeter(88);
                this.mutateNodes();
            }

            async cascade() {
                this.logOutput('[CHAOS] Initiating cascade sequence...');
                await this.executeCommand('pf://chaos:cascade', ['--pattern=optimal', '--containment=active']);
                this.updateCascadeMeter(76);
                this.cascadeNodes();
            }

            async executeService(serviceId) {
                const service = this.chaosServices.find(s => s.id === serviceId);
                if (service) {
                    this.logOutput(`[CHAOS] Executing service: ${service.name}`);
                    const primaryCommand = service.commands[0];
                    await this.executeCommand(primaryCommand, ['--service-mode=true']);
                }
            }

            configureService(serviceId) {
                const service = this.chaosServices.find(s => s.id === serviceId);
                if (service) {
                    this.logOutput(`[CHAOS] Configuring service: ${service.name}`);
                    this.showServiceConfig(service);
                }
            }

            showServiceConfig(service) {
                const config = prompt(`Configure ${service.name}:\nEnter parameters (comma-separated):`, 'level=controlled,safety=high');
                if (config) {
                    this.logOutput(`[CHAOS] Service ${service.name} configured: ${config}`);
                }
            }

            toggleChaosNode(nodeId) {
                const node = document.querySelector(`.chaos-node:nth-child(${nodeId})`);
                node.classList.toggle('active');
                this.logOutput(`[CHAOS] Node ${nodeId} ${node.classList.contains('active') ? 'activated' : 'deactivated'}`);
            }

            animateRandomNodes() {
                const nodes = document.querySelectorAll('.chaos-node');
                for (let i = 0; i < 20; i++) {
                    const randomNode = nodes[Math.floor(Math.random() * nodes.length)];
                    setTimeout(() => {
                        randomNode.classList.add('active');
                    }, Math.random() * 2000);
                }
            }

            calmNodes() {
                const nodes = document.querySelectorAll('.chaos-node.active');
                nodes.forEach((node, index) => {
                    setTimeout(() => {
                        node.classList.remove('active');
                    }, index * 100);
                });
            }

            intensifyNodes() {
                const nodes = document.querySelectorAll('.chaos-node');
                nodes.forEach(node => {
                    if (Math.random() > 0.3) {
                        node.classList.add('active');
                    }
                });
            }

            channelNodes() {
                const nodes = document.querySelectorAll('.chaos-node');
                nodes.forEach((node, index) => {
                    if (index % 8 === 0 || index % 8 === 7) { // Edge nodes
                        node.classList.add('active');
                    } else {
                        node.classList.remove('active');
                    }
                });
            }

            mutateNodes() {
                const nodes = document.querySelectorAll('.chaos-node');
                nodes.forEach(node => {
                    if (Math.random() > 0.5) {
                        node.style.transform = `rotate(${Math.random() * 360}deg) scale(${0.8 + Math.random() * 0.4})`;
                        node.classList.add('active');
                    }
                });
            }

            cascadeNodes() {
                const nodes = document.querySelectorAll('.chaos-node');
                let delay = 0;
                for (let row = 0; row < 8; row++) {
                    for (let col = 0; col < 8; col++) {
                        const index = row * 8 + col;
                        setTimeout(() => {
                            nodes[index].classList.add('active');
                        }, delay);
                        delay += 50;
                    }
                }
            }

            updateEntropyMeter(value) {
                document.getElementById('entropyLevel').style.width = value + '%';
                document.getElementById('entropyValue').textContent = value + '%';
            }

            updateStabilityMeter(value) {
                document.getElementById('stabilityIndex').style.width = value + '%';
                document.getElementById('stabilityValue').textContent = value + '%';
            }

            updateMutationMeter(value) {
                document.getElementById('mutationRate').style.width = value + '%';
                document.getElementById('mutationValue').textContent = value + '%';
            }

            updateCascadeMeter(value) {
                document.getElementById('cascadePotential').style.width = value + '%';
                document.getElementById('cascadeValue').textContent = value + '%';
            }

            updateChaosMetricsFromReal(data) {
                if (data.metrics) {
                    this.updateEntropyMeter(data.metrics.entropy || 73);
                    this.updateStabilityMeter(data.metrics.stability || 61);
                    this.updateMutationMeter(data.metrics.mutation || 84);
                    this.updateCascadeMeter(data.metrics.cascade || 56);
                }
            }

            parseChaosOutput(result) {
                if (result.output) {
                    result.output.split('\n').forEach(line => {
                        if (line.trim()) {
                            this.logOutput(`[PSIFORCE] ${line}`);
                        }
                    });
                }
            }

            startChaosMonitoring() {
                setInterval(async () => {
                    try {
                        await this.connectToPsiForceDB();
                    } catch (error) {
                        // Silent monitoring - errors already logged
                    }
                }, 30000); // Every 30 seconds
            }

            startEntropyAnimation() {
                setInterval(() => {
                    const randomNodes = document.querySelectorAll('.chaos-node');
                    const randomNode = randomNodes[Math.floor(Math.random() * randomNodes.length)];
                    if (randomNode && Math.random() > 0.8) {
                        randomNode.classList.toggle('active');
                    }
                }, 1000);
            }

            logOutput(message) {
                const output = document.getElementById('chaosOutput');
                const timestamp = new Date().toLocaleTimeString();
                output.innerHTML += `<div>[${timestamp}] ${message}</div>`;
                output.scrollTop = output.scrollHeight;
            }
        }

        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', () => {
            window.chaosManager = new PFQLChaosManager();
        });

        // Authentication check
        if (typeof window.pfqlAuth === 'undefined') {
            console.warn('PFQL Auth not loaded - some features may be limited');
        }
    </script>
</body>
</html>