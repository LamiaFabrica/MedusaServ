    <script>
        // Tab switching functionality
        function switchTab(tabName) {
            const panels = document.querySelectorAll('.tab-panel');
            panels.forEach(panel => panel.classList.remove('active'));
            
            const buttons = document.querySelectorAll('.tab-button');
            buttons.forEach(button => button.classList.remove('active'));
            
            document.getElementById(tabName).classList.add('active');
            event.target.classList.add('active');
        }

        // Query optimization functions
        function optimizeQuery() {
            const originalQuery = document.getElementById('originalQuery').value;
            if (!originalQuery.trim()) {
                alert('Please enter a query to optimize');
                return;
            }
            
            // Simulate optimization process
            setTimeout(() => {
                document.getElementById('optimizedTime').textContent = '42ms';
                // Update optimized query is already shown
            }, 1500);
        }

        function analyzeQuery() {
            alert('Analyzing query performance metrics...');
        }

        function explainPlan() {
            alert('Generating execution plan...');
        }

        function clearQueries() {
            document.getElementById('originalQuery').value = '';
            document.getElementById('optimizedQuery').value = '';
        }

        // Query healer functions
        function healQuery() {
            alert('Healing query issues automatically...');
        }

        function detectIssues() {
            alert('Detecting query issues...');
        }

        function autoFix() {
            alert('Auto-fixing all detected issues...');
        }

        function validateSyntax() {
            alert('Validating SQL syntax...');
        }

        // Index advisor functions
        function analyzeIndexes() {
            alert('Analyzing table indexes...');
        }

        function generateIndexes() {
            alert('Generating optimal index recommendations...');
        }

        function evaluateIndexes() {
            alert('Evaluating index impact on performance...');
        }

        function exportScript() {
            const script = `-- Yorkshire Champion Index Optimization Script
-- Generated: ${new Date().toLocaleString()}

CREATE INDEX idx_users_created_status 
ON users(created_at DESC, status) 
WHERE status = 'active';

CREATE INDEX idx_orders_user_amount 
ON orders(user_id, total_amount DESC) 
INCLUDE (order_date, status);

CREATE INDEX idx_products_category_price 
ON products(category_id, price) 
WHERE stock > 0;`;
            
            const blob = new Blob([script], { type: 'text/sql' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'index_optimization_script.sql';
            a.click();
            window.URL.revokeObjectURL(url);
        }

        // Connection pool functions
        function optimizePool() {
            alert('Optimizing connection pool size...');
        }

        function rebalanceConnections() {
            alert('Rebalancing active connections...');
        }

        function warmupConnections() {
            alert('Warming up connection pool...');
        }

        function drainConnections() {
            alert('Draining idle connections...');
        }

        // Cache functions
        function optimizeCache() {
            alert('Optimizing cache configuration...');
        }

        function preloadCache() {
            alert('Preloading frequently accessed queries...');
        }

        function evictStale() {
            alert('Evicting stale cache entries...');
        }

        function analyzeCachePatterns() {
            alert('Analyzing cache access patterns...');
        }

        // Initialize connection pool visualization
        function initializeConnectionPool() {
            const poolContainer = document.getElementById('connectionPool');
            const totalConnections = 200;
            const activeConnections = 150;
            const idleConnections = 50;
            
            for (let i = 0; i < totalConnections; i++) {
                const node = document.createElement('div');
                node.className = 'connection-node';
                
                if (i < activeConnections) {
                    node.classList.add('connection-active');
                    node.textContent = 'A';
                    node.title = `Active Connection #${i + 1}`;
                } else if (i < activeConnections + idleConnections) {
                    node.classList.add('connection-idle');
                    node.textContent = 'I';
                    node.title = `Idle Connection #${i + 1}`;
                } else {
                    node.classList.add('connection-closed');
                    node.textContent = '×';
                    node.title = `Closed Slot #${i + 1}`;
                }
                
                poolContainer.appendChild(node);
            }
        }

        // Create floating particles
        function createDBParticles() {
            const container = document.getElementById('dbParticles');
            for (let i = 0; i < 20; i++) {
                const particle = document.createElement('div');
                particle.className = 'db-particle';
                particle.style.left = Math.random() * 100 + 'vw';
                particle.style.animationDelay = Math.random() * 15 + 's';
                particle.style.animationDuration = (Math.random() * 10 + 15) + 's';
                container.appendChild(particle);
            }
        }

        // Update real-time metrics
        function updateMetrics() {
            // Update QPS
            const qps = document.getElementById('qps');
            if (qps) {
                const currentQPS = parseInt(qps.textContent.replace(/,/g, ''));
                const variance = Math.floor(Math.random() * 100) - 50;
                qps.textContent = (currentQPS + variance).toLocaleString();
            }
            
            // Update latency
            const latency = document.getElementById('avgLatency');
            if (latency) {
                const currentLatency = parseInt(latency.textContent);
                const variance = Math.floor(Math.random() * 10) - 5;
                latency.textContent = Math.max(10, currentLatency + variance) + 'ms';
            }
            
            // Update slow queries
            const slowQueries = document.getElementById('slowQueries');
            if (slowQueries) {
                const variance = Math.floor(Math.random() * 3) - 1;
                const current = parseInt(slowQueries.textContent);
                slowQueries.textContent = Math.max(0, current + variance);
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            createDBParticles();
            initializeConnectionPool();
            
            // Update metrics every 2 seconds
            setInterval(updateMetrics, 2000);
            
            // Auto-update statistics
            setInterval(() => {
                const metrics = document.querySelectorAll('.metric-number');
                metrics.forEach(metric => {
                    if (!metric.textContent.includes('%') && !metric.textContent.includes('x') && 
                        !metric.textContent.includes('ms') && !metric.textContent.includes('TB') &&
                        !metric.textContent.includes('$')) {
                        const currentValue = parseInt(metric.textContent.replace(/,/g, ''));
                        if (!isNaN(currentValue)) {
                            const increment = Math.floor(Math.random() * 100) + 1;
                            metric.textContent = (currentValue + increment).toLocaleString();
                        }
                    }
                });
            }, 10000); // Update every 10 seconds
        });

        // Yorkshire Champion Database Optimizer
        class YorkshireChampionOptimizer {
            constructor() {
                this.performanceMultiplier = 15.0;
                this.optimizationLevel = 'YORKSHIRE_CHAMPION';
                this.cacheHitRatio = 87.3;
            }
            
            async optimizeQuery(query) {
                // Simulate Yorkshire Champion optimization
                const startTime = performance.now();
                
                await new Promise(resolve => {
                    setTimeout(resolve, Math.random() * 500 + 200);
                });
                
                const endTime = performance.now();
                const optimizationTime = endTime - startTime;
                
                return {
                    originalQuery: query,
                    optimizedQuery: this.rewriteQuery(query),
                    performanceGain: this.performanceMultiplier,
                    optimizationTime: optimizationTime,
                    yorkshireBoost: true
                };
            }
            
            rewriteQuery(query) {
                // Simulate query rewriting with Yorkshire Champion optimizations
                return `-- Yorkshire Champion Optimized\n${query}\n-- Performance Boost: 15.0x`;
            }
        }

        // Initialize Yorkshire Champion Optimizer
        const yorkshireOptimizer = new YorkshireChampionOptimizer();
    </script>
</body>
</html>}
