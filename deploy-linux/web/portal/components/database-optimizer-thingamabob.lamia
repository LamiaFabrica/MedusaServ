                        </div>
                        <div class="optimization-step" style="border-left-color: var(--champion-danger);">
                            <span style="color: var(--champion-danger);">❌</span>
                            <strong>Syntax Error:</strong> "WERE" should be "WHERE"
                        </div>
                        <div class="optimization-step" style="border-left-color: var(--champion-warning);">
                            <span style="color: var(--champion-warning);">⚠️</span>
                            <strong>Missing Quote:</strong> String literal not closed properly
                        </div>
                        <div class="optimization-step" style="border-left-color: var(--champion-warning);">
                            <span style="color: var(--champion-warning);">⚠️</span>
                            <strong>Invalid GROUP BY:</strong> SELECT * with GROUP BY requires aggregation
                        </div>
                    </div>

                    <div class="query-panel" style="margin-top: 20px;">
                        <div class="panel-header">
                            <div class="panel-title">Healed Query</div>
                            <span style="font-size: 12px; color: var(--champion-success);">✅ All Issues Fixed</span>
                        </div>
                        <textarea class="query-editor" id="healedQuery" readonly>-- Yorkshire Champion Query Healer Fixed Version
SELECT 
    username,
    COUNT(*) as user_count,
    MAX(created_at) as latest_creation
FROM users u
WHERE u.created_at > '2024-01-01'
    AND status = 'active'
GROUP BY username
HAVING COUNT(*) > 1
ORDER BY user_count DESC;

-- Fixes Applied:
-- ✓ Corrected SQL keywords (SELECT, FROM, WHERE)
-- ✓ Fixed unclosed string literal
-- ✓ Added quotes around string value 'active'
-- ✓ Replaced SELECT * with specific columns for GROUP BY
-- ✓ Added missing comparison value in HAVING clause
-- ✓ Specified column for ORDER BY</textarea>
                    </div>
