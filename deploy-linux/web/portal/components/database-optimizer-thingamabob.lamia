                        <textarea class="query-editor" id="problematicQuery">SELCT * FORM users u
WERE u.created_at > '2024-01-01
AND status = active
GROUP BY username
HAVING count(*) > 
ORDER BY DESC;</textarea>
                    </div>

                    <div class="optimization-results">
