/**
 * MEDUSASERV FILE MANAGER THINGAMABOB COMPONENT
 * ============================================
 * Enterprise file manager thingamabob with VSFTPD integration
 * © 2025 The Medusa Project | Roylepython | D Hargreaves
 */

@component "file_manager_thingamabob" {
    @version "0.4.0"
    @theme "enterprise_filemanager"
    @security_level "quantum_resistant"
    @encryption "AES_256_PQC"
    @session_management "JWT_PsiForceDB"
    @authentication_required true
    @psiforcedb_backend true
    @vsftpd_enabled true
    @sftp_support true
    @webdav_support true
    
    @render {
        <div class="filemanager-thingamabob">
            <!-- File Manager Header Thingamabob -->
            <div class="thingamabob-header">
                <div class="thingamabob-title">
                    <div class="thingamabob-icon">📁</div>
                    <h2>File Manager Thingamabob</h2>
                    <span class="thingamabob-badge">Enterprise</span>
                </div>
                <div class="thingamabob-controls">
                    <button class="thingamabob-btn upload">⬆️ Upload</button>
                    <button class="thingamabob-btn new-folder">📁 New Folder</button>
                    <button class="thingamabob-btn ftp-connect">🔗 FTP Connect</button>
                </div>
            </div>

            <!-- File Manager Interface Thingamabob -->
            <div class="thingamabob-interface">
                <!-- Navigation Panel Thingamabob -->
                <div class="navigation-thingamabob">
                    <div class="breadcrumb-bar">
                        <div class="breadcrumb">
                            <span class="breadcrumb-item">🏠</span>
                            <span class="breadcrumb-separator">/</span>
                            <span class="breadcrumb-item">web</span>
                            <span class="breadcrumb-separator">/</span>
                            <span class="breadcrumb-item active">portal</span>
                        </div>
                        <div class="view-controls">
                            <button class="view-btn active" data-view="grid">⊞</button>
                            <button class="view-btn" data-view="list">☰</button>
                            <button class="view-btn" data-view="details">📋</button>
                        </div>
                    </div>
                    
                    <div class="quick-access">
                        <h4>Quick Access</h4>
                        <div class="quick-links">
                            <div class="quick-link">
                                <div class="quick-icon">🏠</div>
                                <span>Home</span>
                            </div>
                            <div class="quick-link">
                                <div class="quick-icon">🌐</div>
                                <span>Web Root</span>
                            </div>
                            <div class="quick-link">
                                <div class="quick-icon">⚙️</div>
                                <span>Config</span>
                            </div>
                            <div class="quick-link">
                                <div class="quick-icon">📄</div>
                                <span>Logs</span>
                            </div>
                            <div class="quick-link">
                                <div class="quick-icon">🗄️</div>
                                <span>Backup</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="storage-info">
                        <h4>Storage Usage</h4>
                        <div class="storage-bar">
                            <div class="storage-used" style="width: 68%"></div>
                        </div>
                        <div class="storage-text">
                            <span>6.8 GB used</span>
                            <span>10 GB total</span>
                        </div>
                    </div>
                </div>

                <!-- File Browser Thingamabob -->
                <div class="browser-thingamabob">
                    <div class="toolbar">
                        <div class="toolbar-left">
                            <button class="toolbar-btn">⬅️ Back</button>
                            <button class="toolbar-btn">➡️ Forward</button>
                            <button class="toolbar-btn">⬆️ Up</button>
                            <button class="toolbar-btn">🔄 Refresh</button>
                        </div>
                        <div class="toolbar-right">
                            <input type="text" placeholder="Search files..." class="search-box">
                            <select class="sort-select">
                                <option>Sort by Name</option>
                                <option>Sort by Date</option>
                                <option>Sort by Size</option>
                                <option>Sort by Type</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- File Grid View -->
                    <div class="file-grid">
                        <div class="file-item folder" data-name="components">
                            <div class="file-icon">📁</div>
                            <div class="file-info">
                                <div class="file-name">components</div>
                                <div class="file-meta">Folder • 12 items</div>
                            </div>
                            <div class="file-actions">
                                <button class="action-btn">✏️</button>
                                <button class="action-btn">📋</button>
                                <button class="action-btn">🗑️</button>
                            </div>
                        </div>
                        
                        <div class="file-item folder" data-name="fccp">
                            <div class="file-icon">🔗</div>
                            <div class="file-info">
                                <div class="file-name">fccp</div>
                                <div class="file-meta">Folder • 3 items</div>
                            </div>
                            <div class="file-actions">
                                <button class="action-btn">✏️</button>
                                <button class="action-btn">📋</button>
                                <button class="action-btn">🗑️</button>
                            </div>
                        </div>
                        
                        <div class="file-item folder" data-name="icewall">
                            <div class="file-icon">🛡️</div>
                            <div class="file-info">
                                <div class="file-name">icewall</div>
                                <div class="file-meta">Folder • 5 items</div>
                            </div>
                            <div class="file-actions">
                                <button class="action-btn">✏️</button>
                                <button class="action-btn">📋</button>
                                <button class="action-btn">🗑️</button>
                            </div>
                        </div>
                        
                        <div class="file-item file lamia" data-name="index.lamia">
                            <div class="file-icon">🔬</div>
                            <div class="file-info">
                                <div class="file-name">index.lamia</div>
                                <div class="file-meta">LAMIA • 24.5 KB</div>
                            </div>
                            <div class="file-actions">
                                <button class="action-btn">✏️</button>
                                <button class="action-btn">📋</button>
                                <button class="action-btn">🗑️</button>
                            </div>
                        </div>
                        
                        <div class="file-item file html" data-name="index.html">
                            <div class="file-icon">🌐</div>
                            <div class="file-info">
                                <div class="file-name">index.html</div>
                                <div class="file-meta">HTML • 18.2 KB</div>
                            </div>
                            <div class="file-actions">
                                <button class="action-btn">✏️</button>
                                <button class="action-btn">📋</button>
                                <button class="action-btn">🗑️</button>
                            </div>
                        </div>
                        
                        <div class="file-item file lamia" data-name="portal.lamia">
                            <div class="file-icon">🚪</div>
                            <div class="file-info">
                                <div class="file-name">portal.lamia</div>
                                <div class="file-meta">LAMIA • 67.8 KB</div>
                            </div>
                            <div class="file-actions">
                                <button class="action-btn">✏️</button>
                                <button class="action-btn">📋</button>
                                <button class="action-btn">🗑️</button>
                            </div>
                        </div>
                        
                        <div class="file-item file lamia" data-name="login.lamia">
                            <div class="file-icon">🔑</div>
                            <div class="file-info">
                                <div class="file-name">login.lamia</div>
                                <div class="file-meta">LAMIA • 12.1 KB</div>
                            </div>
                            <div class="file-actions">
                                <button class="action-btn">✏️</button>
                                <button class="action-btn">📋</button>
                                <button class="action-btn">🗑️</button>
                            </div>
                        </div>
                        
                        <div class="file-item file gif" data-name="index_gif3d.lamia">
                            <div class="file-icon">🎬</div>
                            <div class="file-info">
                                <div class="file-name">index_gif3d.lamia</div>
                                <div class="file-meta">LAMIA • 45.3 KB</div>
                            </div>
                            <div class="file-actions">
                                <button class="action-btn">✏️</button>
                                <button class="action-btn">📋</button>
                                <button class="action-btn">🗑️</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Properties Panel Thingamabob -->
                <div class="properties-thingamabob">
                    <h3>File Properties</h3>
                    
                    <div class="selected-file">
                        <div class="file-preview">
                            <div class="preview-icon">🔬</div>
                            <div class="preview-name">index.lamia</div>
                        </div>
                        
                        <div class="file-details">
                            <div class="detail-row">
                                <span class="detail-label">Type:</span>
                                <span class="detail-value">LAMIA File</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Size:</span>
                                <span class="detail-value">24,576 bytes</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Modified:</span>
                                <span class="detail-value">Today, 2:30 PM</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Created:</span>
                                <span class="detail-value">Jan 20, 2025</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Permissions:</span>
                                <span class="detail-value">rwxr-xr-x</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Owner:</span>
                                <span class="detail-value">medusa:medusa</span>
                            </div>
                        </div>
                        
                        <div class="file-actions-panel">
                            <button class="action-panel-btn edit">✏️ Edit</button>
                            <button class="action-panel-btn download">📥 Download</button>
                            <button class="action-panel-btn copy">📋 Copy Path</button>
                            <button class="action-panel-btn permissions">🔒 Permissions</button>
                        </div>
                    </div>
                    
                    <div class="ftp-connection">
                        <h4>FTP Connection</h4>
                        <div class="connection-status">
                            <div class="status-indicator online"></div>
                            <span>VSFTPD Active</span>
                        </div>
                        
                        <div class="connection-info">
                            <div class="info-row">
                                <span class="info-label">Server:</span>
                                <span class="info-value">medusaserv.com</span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">Port:</span>
                                <span class="info-value">21 (FTP) / 22 (SFTP)</span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">Users:</span>
                                <span class="info-value">3 connected</span>
                            </div>
                        </div>
                        
                        <button class="ftp-manage-btn">⚙️ Manage FTP</button>
                    </div>
                </div>
            </div>
        </div>
    }
    
    @styles {
        .filemanager-thingamabob {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
            border-left: 4px solid #20c997;
            margin-bottom: 2rem;
        }

        .thingamabob-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #f8f9fa;
        }

        .thingamabob-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .thingamabob-icon {
            font-size: 1.5rem;
        }

        .thingamabob-title h2 {
            color: #20c997;
            margin: 0;
            font-size: 1.4rem;
            font-weight: 600;
        }

        .thingamabob-badge {
            background: linear-gradient(135deg, #20c997, #17a2b8);
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .thingamabob-controls {
            display: flex;
            gap: 0.5rem;
        }

        .thingamabob-btn {
            background: #20c997;
            color: white;
            border: none;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .thingamabob-btn:hover {
            background: #1ca085;
            transform: translateY(-1px);
        }

        .thingamabob-interface {
            display: grid;
            grid-template-columns: 250px 1fr 300px;
            gap: 1.5rem;
            min-height: 600px;
        }

        .navigation-thingamabob {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .breadcrumb-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem;
            background: white;
            border-radius: 6px;
            border: 1px solid #dee2e6;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            font-size: 0.875rem;
        }

        .breadcrumb-item {
            color: #6c757d;
        }

        .breadcrumb-item.active {
            color: #20c997;
            font-weight: 600;
        }

        .breadcrumb-separator {
            margin: 0 0.5rem;
            color: #adb5bd;
        }

        .view-controls {
            display: flex;
            gap: 0.25rem;
        }

        .view-btn {
            background: transparent;
            border: 1px solid #dee2e6;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.75rem;
            transition: all 0.2s ease;
        }

        .view-btn:hover,
        .view-btn.active {
            background: #20c997;
            color: white;
            border-color: #20c997;
        }

        .quick-access h4 {
            color: #343a40;
            font-size: 0.875rem;
            margin-bottom: 0.75rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #e9ecef;
        }

        .quick-links {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .quick-link {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 0.875rem;
        }

        .quick-link:hover {
            background: rgba(32, 201, 151, 0.1);
            color: #20c997;
        }

        .quick-icon {
            font-size: 0.875rem;
        }

        .storage-info h4 {
            color: #343a40;
            font-size: 0.875rem;
            margin-bottom: 0.75rem;
        }

        .storage-bar {
            background: #e9ecef;
            border-radius: 10px;
            height: 8px;
            margin-bottom: 0.5rem;
            overflow: hidden;
        }

        .storage-used {
            background: linear-gradient(90deg, #20c997, #17a2b8);
            height: 100%;
            transition: width 0.3s ease;
        }

        .storage-text {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            color: #6c757d;
        }

        .browser-thingamabob {
            border-right: 1px solid #e9ecef;
            padding-right: 1.5rem;
        }

        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem;
            background: #f8f9fa;
            border-radius: 6px;
            margin-bottom: 1rem;
        }

        .toolbar-left {
            display: flex;
            gap: 0.5rem;
        }

        .toolbar-btn {
            background: white;
            border: 1px solid #dee2e6;
            padding: 0.375rem 0.75rem;
            border-radius: 4px;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .toolbar-btn:hover {
            background: #20c997;
            color: white;
            border-color: #20c997;
        }

        .toolbar-right {
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }

        .search-box {
            padding: 0.375rem 0.75rem;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            font-size: 0.875rem;
            width: 200px;
        }

        .sort-select {
            padding: 0.375rem 0.75rem;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            font-size: 0.875rem;
            background: white;
        }

        .file-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
            max-height: 500px;
            overflow-y: auto;
            padding: 0.5rem;
        }

        .file-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 1rem;
            background: white;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
        }

        .file-item:hover {
            border-color: #20c997;
            box-shadow: 0 4px 12px rgba(32, 201, 151, 0.15);
            transform: translateY(-2px);
        }

        .file-item.folder .file-icon {
            color: #ffc107;
        }

        .file-item.lamia .file-icon {
            color: #20c997;
        }

        .file-item.html .file-icon {
            color: #fd7e14;
        }

        .file-item.gif .file-icon {
            color: #e83e8c;
        }

        .file-icon {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .file-info {
            text-align: center;
            width: 100%;
        }

        .file-name {
            font-weight: 600;
            color: #343a40;
            font-size: 0.875rem;
            margin-bottom: 0.25rem;
            word-break: break-word;
        }

        .file-meta {
            color: #6c757d;
            font-size: 0.75rem;
        }

        .file-actions {
            display: none;
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            gap: 0.25rem;
        }

        .file-item:hover .file-actions {
            display: flex;
        }

        .action-btn {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid #dee2e6;
            padding: 0.25rem;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.75rem;
            transition: all 0.2s ease;
        }

        .action-btn:hover {
            background: #20c997;
            color: white;
            border-color: #20c997;
        }

        .properties-thingamabob {
            padding-left: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .properties-thingamabob h3 {
            color: #343a40;
            margin: 0;
            font-size: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #e9ecef;
        }

        .selected-file {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1rem;
        }

        .file-preview {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 1rem;
        }

        .preview-icon {
            font-size: 3rem;
            color: #20c997;
            margin-bottom: 0.5rem;
        }

        .preview-name {
            font-weight: 600;
            color: #343a40;
            text-align: center;
            word-break: break-word;
        }

        .file-details {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.875rem;
        }

        .detail-label {
            color: #6c757d;
            font-weight: 600;
        }

        .detail-value {
            color: #343a40;
        }

        .file-actions-panel {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .action-panel-btn {
            background: white;
            border: 1px solid #dee2e6;
            padding: 0.5rem;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

        .action-panel-btn:hover {
            background: #20c997;
            color: white;
            border-color: #20c997;
        }

        .ftp-connection {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1rem;
        }

        .ftp-connection h4 {
            color: #343a40;
            font-size: 0.875rem;
            margin-bottom: 0.75rem;
        }

        .connection-status {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
            font-size: 0.875rem;
            font-weight: 600;
        }

        .status-indicator {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .status-indicator.online {
            background: #28a745;
        }

        .connection-info {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
        }

        .info-label {
            color: #6c757d;
        }

        .info-value {
            color: #343a40;
            font-weight: 600;
        }

        .ftp-manage-btn {
            width: 100%;
            background: #17a2b8;
            color: white;
            border: none;
            padding: 0.5rem;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

        .ftp-manage-btn:hover {
            background: #138496;
        }

        /* Responsive Design */
        @media (max-width: 1200px) {
            .thingamabob-interface {
                grid-template-columns: 200px 1fr 250px;
            }
        }

        @media (max-width: 900px) {
            .thingamabob-interface {
                grid-template-columns: 1fr;
                grid-template-rows: auto auto auto;
                gap: 1rem;
            }

            .thingamabob-header {
                flex-direction: column;
                gap: 1rem;
            }

            .toolbar {
                flex-direction: column;
                gap: 1rem;
            }

            .file-grid {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            }
        }
    }
}