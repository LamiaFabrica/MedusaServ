                        </div>
                    </div>

                    <div class="provider-card medusa champion">
                        <div class="provider-header">
                            <div class="provider-logo">
                                <i class="fas fa-crown"></i>
                            </div>
                            <div class="provider-info">
                                <div class="provider-name">Medusa Native DNS</div>
                                <div class="provider-status yorkshire">YORKSHIRE CHAMPION</div>
                            </div>
                        </div>
                        <div class="provider-stats">
                            <div class="stat">
                                <span class="stat-label">Domains:</span>
                                <span class="stat-value">5</span>
                            </div>
                            <div class="stat">
                                <span class="stat-label">Records:</span>
                                <span class="stat-value">258</span>
                            </div>
                            <div class="stat">
                                <span class="stat-label">Performance:</span>
                                <span class="stat-value">15.0x</span>
                            </div>
                        </div>
                        <div class="provider-actions">
