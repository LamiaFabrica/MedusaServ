}

@keyframes championGlow {
    0%, 100% { color: #FFD700; text-shadow: 0 0 10px rgba(255, 215, 0, 0.5); }
    50% { color: #FFA500; text-shadow: 0 0 20px rgba(255, 215, 0, 0.8), 0 0 30px rgba(255, 152, 0, 0.6); }
}

@keyframes championPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

@keyframes scoreGlow {
    0%, 100% { box-shadow: 0 0 5px rgba(255, 215, 0, 0.5); }
    50% { box-shadow: 0 0 15px rgba(255, 215, 0, 0.8), 0 0 25px rgba(255, 152, 0, 0.6); }
}
</style>

<script>
// Domain Manager JavaScript Functions
let selectedDomainFilter = 'all';
let selectedProviderFilter = 'all';

function showDomainTab(tabName) {
    // Hide all tab contents
    const contents = document.querySelectorAll('.tab-content');
    contents.forEach(content => content.classList.remove('active'));
    
    // Remove active from all buttons
    const buttons = document.querySelectorAll('.tab-button');
    buttons.forEach(button => button.classList.remove('active'));
    
    // Show selected tab and mark button as active
    document.getElementById(tabName + '-tab').classList.add('active');
    event.target.classList.add('active');
    
    // Initialize tab-specific functionality
    initializeDomainTab(tabName);
}

function initializeDomainTab(tabName) {
    switch(tabName) {
        case 'overview':
            updateDomainStats();
            updateActivityFeed();
            break;
        case 'domains':
            loadDomainsList();
            break;
        case 'subdomains':
            loadSubdomainsList();
            break;
        case 'dns-records':
            loadDNSRecords();
            break;
    }
}

function updateDomainStats() {
    // Simulate stat updates
    const totalDomains = 47 + Math.floor(Math.random() * 3);
    const totalSubdomains = 234 + Math.floor(Math.random() * 10);
    const dnsRecords = 1847 + Math.floor(Math.random() * 50);
    const queriesPerSecond = Math.floor(20000 + Math.random() * 10000);
    
    document.getElementById('total-domains').textContent = totalDomains;
    document.getElementById('total-subdomains').textContent = totalSubdomains;
    document.getElementById('dns-records').textContent = dnsRecords.toLocaleString();
    document.getElementById('queries-per-second').textContent = queriesPerSecond.toLocaleString();
}

function updateActivityFeed() {
    const activityFeed = document.getElementById('domain-activity-feed');
    
    const activities = [
        { type: 'success', title: 'SSL certificate renewed', details: 'Auto-renewal successful for blog.poweredbymedusa.com', badge: '15.0x' },
        { type: 'info', title: 'New subdomain created', details: 'staging.api.poweredbymedusa.com pointing to 172.236.20.29', badge: 'PROPAGATED' },
        { type: 'warning', title: 'DNS optimization needed', details: 'TTL values suboptimal for legacy.medusaserv.com', badge: 'OPTIMIZE' },
        { type: 'success', title: 'Domain transferred', details: 'newsite.poweredbymedusa.com moved to Cloudflare successfully', badge: '18.2x' }
    ];
    
    // Add new activity occasionally
    if (Math.random() > 0.7) {
        const activity = activities[Math.floor(Math.random() * activities.length)];
        const timestamp = new Date().toLocaleTimeString();
        
        const activityElement = document.createElement('div');
        activityElement.className = `activity-item ${activity.type}`;
        activityElement.innerHTML = `
            <div class="activity-icon">${activity.type === 'success' ? '✅' : activity.type === 'warning' ? '⚠️' : '🌐'}</div>
            <div class="activity-content">
                <div class="activity-title">${activity.title}</div>
                <div class="activity-details">${activity.details}</div>
                <div class="activity-time">${timestamp}</div>
            </div>
            <div class="activity-metrics">
                <span class="${activity.badge.includes('x') ? 'performance-badge' : activity.badge === 'PROPAGATED' ? 'propagation-badge' : 'optimize-badge'}">${activity.badge}</span>
            </div>
        `;
        
        activityFeed.insertBefore(activityElement, activityFeed.firstChild);
        
        // Keep only last 10 activities
        while (activityFeed.children.length > 10) {
            activityFeed.removeChild(activityFeed.lastChild);
        }
    }
}

function addNewDomain() {
    const domainName = prompt('Enter domain name:');
    if (domainName) {
        alert(`Adding domain: ${domainName}\nThis would initiate the domain registration and DNS setup process.`);
        // In real implementation, this would call the domain management API
    }
}

function editDomain(domainName) {
    alert(`Editing domain configuration for: ${domainName}`);
}

function viewDomainDetails(domainName) {
    alert(`Viewing detailed information for: ${domainName}\nThis would show comprehensive domain analytics, DNS records, and performance metrics.`);
}

function optimizeDomain(domainName) {
    alert(`Optimizing domain: ${domainName}\nApplying Yorkshire Champion DNS optimizations...`);
    // Simulate optimization
    setTimeout(() => {
        alert('Domain optimization complete! Yorkshire Champion performance achieved.');
    }, 2000);
}

function filterDomains(searchTerm) {
    // Filter domains based on search term
    console.log('Filtering domains by search term:', searchTerm);
}

function filterDomainsByStatus(status) {
    selectedDomainFilter = status;
    console.log('Filtering domains by status:', status);
}

function filterDomainsByProvider(provider) {
    selectedProviderFilter = provider;
    console.log('Filtering domains by provider:', provider);
}

function createSubdomain() {
    const subdomainName = document.getElementById('subdomain-name').value;
    const parentDomain = document.getElementById('parent-domain').value;
    const target = document.getElementById('subdomain-target').value;
    const recordType = document.getElementById('record-type').value;
    const autoSSL = document.getElementById('auto-ssl').checked;
    const yorkshireOptimization = document.getElementById('yorkshire-optimization').checked;
    
    if (!subdomainName || !target) {
        alert('Please fill in all required fields');
        return;
    }
    
    const fullDomain = `${subdomainName}.${parentDomain}`;
    
    alert(`Creating subdomain: ${fullDomain}
Type: ${recordType}
Target: ${target}
Auto-SSL: ${autoSSL ? 'Yes' : 'No'}
Yorkshire Champion: ${yorkshireOptimization ? 'Yes' : 'No'}

DNS propagation will begin shortly...`);
    
    // Clear form
    document.getElementById('subdomain-name').value = '';
    document.getElementById('subdomain-target').value = '';
}

function applySubdomainTemplate(templateType) {
    const templates = {
        'api': { target: '172.236.28.155', type: 'A' },
        'blog': { target: '172.236.20.28', type: 'A' },
        'shop': { target: 'shop-server.poweredbymedusa.com', type: 'CNAME' },
        'cdn': { target: 'cdn.cloudflare.com', type: 'CNAME' },
        'mail': { target: '172.236.25.10', type: 'A' }
    };
    
    const template = templates[templateType];
    if (template) {
        document.getElementById('subdomain-name').value = templateType;
        document.getElementById('subdomain-target').value = template.target;
        document.getElementById('record-type').value = template.type;
    }
}

function editSubdomain(subdomainName) {
    alert(`Editing subdomain: ${subdomainName}`);
}

function testSubdomain(subdomainName) {
    alert(`Testing subdomain: ${subdomainName}
Running DNS resolution test...
SSL certificate validation...
Response time measurement...

All tests would be performed here.`);
}

function deleteSubdomain(subdomainName) {
    if (confirm(`Are you sure you want to delete ${subdomainName}? This action cannot be undone.`)) {
        alert(`Deleting subdomain: ${subdomainName}`);
    }
}

function updateRecordForm(recordType) {
    const priorityField = document.querySelector('.priority-field');
    
    if (recordType === 'MX' || recordType === 'SRV') {
        priorityField.style.display = 'block';
    } else {
        priorityField.style.display = 'none';
    }
    
    // Update placeholder text based on record type
    const valueInput = document.getElementById('dns-record-value');
    const placeholders = {
        'A': 'IPv4 address (e.g., 192.168.1.1)',
        'AAAA': 'IPv6 address (e.g., 2001:db8::1)',
        'CNAME': 'Target domain (e.g., example.com)',
        'TXT': 'Text content (e.g., v=spf1 include:_spf.example.com ~all)',
        'MX': 'Mail server hostname (e.g., mail.example.com)',
        'SRV': 'Target hostname and port (e.g., server.example.com:443)'
    };
    
    valueInput.placeholder = placeholders[recordType] || 'Enter value';
}

function addDNSRecord() {
    const recordType = document.getElementById('dns-record-type').value;
    const recordName = document.getElementById('dns-record-name').value;
    const recordValue = document.getElementById('dns-record-value').value;
    const recordTTL = document.getElementById('dns-record-ttl').value;
    const recordPriority = document.getElementById('dns-record-priority').value;
    
    if (!recordName || !recordValue) {
        alert('Please fill in all required fields');
        return;
    }
    
    alert(`Adding DNS record:
Type: ${recordType}
Name: ${recordName || '@'}
Value: ${recordValue}
TTL: ${recordTTL}s
${(recordType === 'MX' || recordType === 'SRV') ? `Priority: ${recordPriority}` : ''}

DNS record will be created and propagated globally.`);
    
    // Clear form
    document.getElementById('dns-record-name').value = '';
    document.getElementById('dns-record-value').value = '';
}

function validateDNSRecord() {
    const recordType = document.getElementById('dns-record-type').value;
    const recordValue = document.getElementById('dns-record-value').value;
    
    if (!recordValue) {
        alert('Please enter a value to validate');
        return;
    }
    
    // Simulate validation
    alert(`Validating ${recordType} record with value: ${recordValue}
✅ Syntax validation: PASSED
✅ Format validation: PASSED
✅ Reachability test: PASSED
🏆 Yorkshire Champion compliance: PASSED`);
}

function filterRecords(recordType) {
    // Update active filter button
    const buttons = document.querySelectorAll('.filter-btn');
    buttons.forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');
    
    console.log('Filtering DNS records by type:', recordType);
}

function editDNSRecord(recordId) {
    alert(`Editing DNS record: ${recordId}`);
}

function testDNSRecord(recordId) {
    alert(`Testing DNS record: ${recordId}
Performing global DNS lookup...
Checking propagation status...
Measuring response times...

Test results would be displayed here.`);
}

function deleteDNSRecord(recordId) {
    if (confirm('Are you sure you want to delete this DNS record?')) {
        alert(`Deleting DNS record: ${recordId}`);
    }
}

function configureProvider(providerName) {
    alert(`Opening configuration for ${providerName} DNS provider...
This would show API key settings, authentication options, and provider-specific features.`);
}

function testProvider(providerName) {
    alert(`Testing connection to ${providerName}...
✅ API connectivity: SUCCESS
✅ Authentication: SUCCESS  
✅ Zone access: SUCCESS
🏆 Yorkshire Champion integration: READY`);
}

function syncProvider(providerName) {
    alert(`Syncing all domains with ${providerName}...
This would synchronize local DNS records with the cloud provider.`);
}

function checkDNSPropagation() {
    const domain = document.getElementById('propagation-domain').value;
    const recordType = document.getElementById('propagation-record-type').value;
    
    if (!domain) {
        alert('Please enter a domain to check');
        return;
    }
    
    const resultsContainer = document.getElementById('propagation-results');
    const serversContainer = document.getElementById('dns-servers-results');
    
    resultsContainer.style.display = 'block';
    serversContainer.innerHTML = '<div class="checking-message">Checking DNS propagation globally...</div>';
    
    // Simulate DNS server checks
    const dnsServers = [
        { name: 'Google DNS', location: 'Global', ip: '8.8.8.8' },
        { name: 'Cloudflare DNS', location: 'Global', ip: '1.1.1.1' },
        { name: 'OpenDNS', location: 'US', ip: '208.67.222.222' },
        { name: 'Quad9', location: 'Global', ip: '9.9.9.9' },
        { name: 'Level3', location: 'US', ip: '4.2.2.2' },
        { name: 'Comodo DNS', location: 'Global', ip: '8.26.56.26' }
    ];
    
    let checkedServers = 0;
    let successfulServers = 0;
    
    serversContainer.innerHTML = '';
    
    dnsServers.forEach((server, index) => {
        setTimeout(() => {
            const success = Math.random() > 0.1; // 90% success rate
            const responseTime = Math.floor(Math.random() * 100 + 20);
            
            const serverResult = document.createElement('div');
            serverResult.className = `dns-server-result ${success ? 'success' : 'failed'}`;
            serverResult.innerHTML = `
                <div class="server-info">
                    <div class="server-name">${server.name}</div>
                    <div class="server-location">${server.location} (${server.ip})</div>
                </div>
                <div class="server-status">
                    <div class="status-indicator ${success ? 'success' : 'failed'}">
                        ${success ? '✅ RESOLVED' : '❌ FAILED'}
                    </div>
                    ${success ? `<div class="response-time">${responseTime}ms</div>` : ''}
                </div>
            `;
            
            serversContainer.appendChild(serverResult);
            
            checkedServers++;
            if (success) successfulServers++;
            
            // Update summary
            document.getElementById('propagation-success').textContent = successfulServers;
            document.getElementById('propagation-total').textContent = checkedServers;
            
        }, index * 500);
    });
}

function renewCertificate(domainName) {
    alert(`Renewing SSL certificate for: ${domainName}
Generating new certificate...
Validating domain ownership...
Installing certificate...

This process may take a few minutes.`);
}

function downloadCertificate(domainName) {
    alert(`Downloading SSL certificate for: ${domainName}
Certificate bundle will be downloaded as a ZIP file containing:
- Certificate (.crt)
- Private key (.key) 
- Certificate chain (.ca-bundle)`);
}

function viewCertificateDetails(domainName) {
    alert(`SSL Certificate Details for ${domainName}:

Issuer: Let's Encrypt
Subject: CN=${domainName}
