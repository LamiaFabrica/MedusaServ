                            <div class="stat">
                                <span class="stat-label">Records:</span>
                                <span class="stat-value">1,247</span>
                            </div>
                            <div class="stat">
                                <span class="stat-label">API Calls:</span>
                                <span class="stat-value">23,456</span>
                            </div>
                        </div>
                        <div class="provider-actions">
                            <button class="btn btn-sm" onclick="configureProvider('cloudflare')">Configure</button>
                            <button class="btn btn-sm" onclick="testProvider('cloudflare')">Test</button>
                            <button class="btn btn-sm" onclick="syncProvider('cloudflare')">Sync</button>
                        </div>
                    </div>

                    <div class="provider-card route53 inactive">
                        <div class="provider-header">
                            <div class="provider-logo">
                                <i class="fab fa-aws"></i>
                            </div>
                            <div class="provider-info">
                                <div class="provider-name">AWS Route53</div>
                                <div class="provider-status disconnected">DISCONNECTED</div>
                            </div>
                        </div>
                        <div class="provider-stats">
                            <div class="stat">
                                <span class="stat-label">Domains:</span>
                                <span class="stat-value">8</span>
                            </div>
                            <div class="stat">
                                <span class="stat-label">Records:</span>
                                <span class="stat-value">342</span>
                            </div>
                            <div class="stat">
                                <span class="stat-label">API Calls:</span>
                                <span class="stat-value">--</span>
                            </div>
                        </div>
                        <div class="provider-actions">
                            <button class="btn btn-sm" onclick="configureProvider('route53')">Configure</button>
