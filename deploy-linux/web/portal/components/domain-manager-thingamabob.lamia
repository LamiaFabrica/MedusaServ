                            </div>
                            <div class="stat">
                                <span class="stat-label">Records:</span>
                                <span class="stat-value">0</span>
                            </div>
                            <div class="stat">
                                <span class="stat-label">API Calls:</span>
                                <span class="stat-value">--</span>
                            </div>
                        </div>
                        <div class="provider-actions">
                            <button class="btn btn-sm" onclick="configureProvider('google')">Configure</button>
                            <button class="btn btn-sm disabled">Test</button>
