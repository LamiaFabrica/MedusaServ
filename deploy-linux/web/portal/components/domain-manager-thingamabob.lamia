            <!-- DNS Propagation Checker -->
            <div class="propagation-checker">
                <h4>Global DNS Propagation Checker</h4>
                <div class="checker-form">
                    <input type="text" id="propagation-domain" placeholder="Enter domain or subdomain to check">
                    <select id="propagation-record-type">
                        <option value="A">A Record</option>
                        <option value="AAAA">AAAA Record</option>
                        <option value="CNAME">CNAME Record</option>
                        <option value="MX">MX Record</option>
                        <option value="TXT">TXT Record</option>
                    </select>
                    <button class="btn btn-primary" onclick="checkDNSPropagation()">
                        <i class="fas fa-search"></i> Check Propagation
                    </button>
                </div>
                
                <div class="propagation-results" id="propagation-results" style="display: none;">
                    <div class="results-header">
                        <h5>Global DNS Server Results</h5>
                        <div class="results-summary">
                            <span id="propagation-success">0</span>/<span id="propagation-total">0</span> servers responding
                        </div>
                    </div>
                    <div class="dns-servers-grid" id="dns-servers-results">
                        <!-- Results will be populated by JavaScript -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SSL Certificates Tab -->
    <div id="ssl-certs-tab" class="tab-content">
        <div class="ssl-certificates">
            <h3>SSL Certificate Management</h3>
            
            <!-- SSL Overview -->
            <div class="ssl-overview">
                <div class="ssl-stats">
                    <div class="ssl-stat">
                        <div class="stat-icon">🔒</div>
                        <div class="stat-info">
                            <div class="stat-title">Total Certificates</div>
                            <div class="stat-value">47</div>
                        </div>
                    </div>
                    
                    <div class="ssl-stat">
                        <div class="stat-icon">✅</div>
                        <div class="stat-info">
                            <div class="stat-title">Valid Certificates</div>
                            <div class="stat-value">47</div>
                        </div>
                    </div>
                    
                    <div class="ssl-stat">
                        <div class="stat-icon">⏰</div>
                        <div class="stat-info">
                            <div class="stat-title">Expiring Soon</div>
                            <div class="stat-value">3</div>
                        </div>
                    </div>
                    
                    <div class="ssl-stat">
                        <div class="stat-icon">🔄</div>
                        <div class="stat-info">
                            <div class="stat-title">Auto-Renewal</div>
                            <div class="stat-value">100%</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Certificate List -->
            <div class="certificates-list">
                <h4>SSL Certificates</h4>
                <div class="certificates-table-container">
                    <table class="certificates-table">
                        <thead>
                            <tr>
                                <th>Domain</th>
                                <th>Certificate Authority</th>
                                <th>Issue Date</th>
                                <th>Expiry Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="cert-row valid">
                                <td>
                                    <div class="domain-info">
                                        <div class="domain-name">poweredbymedusa.com</div>
                                        <div class="domain-coverage">+ 23 subdomains</div>
                                    </div>
                                </td>
                                <td>Let's Encrypt</td>
                                <td>2024-11-25</td>
                                <td class="expiry-date">2025-02-23</td>
                                <td><span class="cert-status valid">VALID</span></td>
                                <td>
                                    <button class="btn-icon" onclick="renewCertificate('poweredbymedusa.com')">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                    <button class="btn-icon" onclick="downloadCertificate('poweredbymedusa.com')">
                                        <i class="fas fa-download"></i>
                                    </button>
                                    <button class="btn-icon" onclick="viewCertificateDetails('poweredbymedusa.com')">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                            
                            <tr class="cert-row expiring-soon">
                                <td>
                                    <div class="domain-info">
                                        <div class="domain-name">api.medusaserv.com</div>
                                        <div class="domain-coverage">Wildcard certificate</div>
                                    </div>
                                </td>
                                <td>Let's Encrypt</td>
                                <td>2024-11-20</td>
                                <td class="expiry-date warning">2025-01-15</td>
                                <td><span class="cert-status expiring">EXPIRING SOON</span></td>
                                <td>
                                    <button class="btn-icon warning" onclick="renewCertificate('api.medusaserv.com')">
                                        <i class="fas fa-exclamation-triangle"></i>
                                    </button>
                                    <button class="btn-icon" onclick="downloadCertificate('api.medusaserv.com')">
                                        <i class="fas fa-download"></i>
                                    </button>
                                    <button class="btn-icon" onclick="viewCertificateDetails('api.medusaserv.com')">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Auto-Renewal Settings -->
            <div class="auto-renewal-settings">
                <h4>Auto-Renewal Configuration</h4>
                <div class="renewal-config">
                    <div class="config-option">
                        <label class="toggle-switch">
                            <input type="checkbox" id="auto-renewal-enabled" checked>
                            <span class="toggle-slider"></span>
                        </label>
                        <div class="option-info">
                            <div class="option-title">Enable Auto-Renewal</div>
                            <div class="option-description">Automatically renew certificates 30 days before expiry</div>
                        </div>
                    </div>
                    
                    <div class="config-option">
                        <label class="toggle-switch">
                            <input type="checkbox" id="renewal-notifications" checked>
                            <span class="toggle-slider"></span>
                        </label>
                        <div class="option-info">
                            <div class="option-title">Renewal Notifications</div>
                            <div class="option-description">Send email notifications for renewal events</div>
                        </div>
                    </div>
                    
                    <div class="config-option">
                        <label class="toggle-switch">
                            <input type="checkbox" id="wildcard-certs" checked>
                            <span class="toggle-slider"></span>
                        </label>
                        <div class="option-info">
                            <div class="option-title">Wildcard Certificates</div>
                            <div class="option-description">Use wildcard certificates for subdomains when possible</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.domain-manager-thingamabob {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    border: 2px solid #4CAF50;
    box-shadow: 0 0 20px rgba(76, 175, 80, 0.3);
}

.domain-manager-icon {
    color: #4CAF50;
    text-shadow: 0 0 10px rgba(76, 175, 80, 0.5);
    animation: domainPulse 2s infinite;
}

.domain-stats-display {
    display: flex;
    gap: 20px;
    position: absolute;
    top: 20px;
    right: 20px;
}

.domain-stat {
    text-align: center;
    background: rgba(0,0,0,0.3);
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid rgba(76, 175, 80, 0.3);
    min-width: 80px;
}

.domain-stat.champion {
    border-color: #FFD700;
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.1), rgba(0,0,0,0.3));
}

.domain-stat .stat-value {
    font-size: 1.6em;
    font-weight: bold;
    color: #4CAF50;
}

.domain-stat.champion .stat-value {
    color: #FFD700;
    animation: championGlow 3s infinite;
}

.status-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.status-card {
    background: linear-gradient(135deg, #2d3748 0%, #1a202c 100%);
    border-radius: 15px;
    padding: 20px;
    position: relative;
    overflow: hidden;
}

.status-card.domain-health {
    border: 2px solid #FFD700;
    box-shadow: 0 0 15px rgba(255, 215, 0, 0.3);
}

.status-card.dns-propagation {
    border: 2px solid #00BFFF;
    box-shadow: 0 0 15px rgba(0, 191, 255, 0.3);
}

.status-card.ssl-status {
    border: 2px solid #4CAF50;
    box-shadow: 0 0 15px rgba(76, 175, 80, 0.3);
}

.status-card.dns-queries {
    border: 2px solid #9C27B0;
    box-shadow: 0 0 15px rgba(156, 39, 176, 0.3);
}

.card-value {
    font-size: 2.2em;
    font-weight: bold;
    margin: 10px 0;
    color: #fff;
}

.health-indicator.excellent {
    background: #4CAF50;
    color: white;
    padding: 4px 12px;
    border-radius: 15px;
    font-size: 0.8em;
    font-weight: bold;
    display: inline-block;
    margin-top: 10px;
}

.propagation-bar {
    width: 100%;
    height: 8px;
    background: rgba(255,255,255,0.1);
    border-radius: 4px;
    overflow: hidden;
    margin-top: 15px;
}

.propagation-fill {
    height: 100%;
    background: linear-gradient(90deg, #00BFFF, #0080FF);
}

.ssl-indicator.secure {
    background: #4CAF50;
    color: white;
    padding: 4px 12px;
    border-radius: 15px;
    font-size: 0.8em;
    font-weight: bold;
    display: inline-block;
    margin-top: 10px;
}

.query-trend.up {
    color: #4CAF50;
    font-weight: bold;
    font-size: 1.1em;
}

.performance-map {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    background: rgba(0,0,0,0.3);
    padding: 20px;
    border-radius: 15px;
    margin: 20px 0;
}

.map-region {
    background: rgba(255,255,255,0.05);
    padding: 20px;
    border-radius: 10px;
    text-align: center;
    position: relative;
    border: 2px solid transparent;
    transition: all 0.3s ease;
}

.map-region:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 16px rgba(0,0,0,0.3);
}

.region-name {
    font-weight: bold;
    margin-bottom: 8px;
}

.region-performance.champion {
    color: #FFD700;
    font-size: 1.5em;
    font-weight: bold;
    animation: championGlow 3s infinite;
}

.region-performance.excellent {
    color: #4CAF50;
    font-size: 1.3em;
    font-weight: bold;
}

.region-performance.good {
    color: #FF9800;
    font-size: 1.2em;
    font-weight: bold;
}

.region-latency {
    color: #ccc;
    font-size: 0.9em;
    margin-top: 5px;
}

.activity-feed {
    max-height: 400px;
    overflow-y: auto;
}

.activity-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px;
    margin: 10px 0;
    background: rgba(0,0,0,0.3);
    border-radius: 10px;
    border-left: 4px solid transparent;
}

.activity-item.success {
    border-left-color: #4CAF50;
}

.activity-item.info {
    border-left-color: #00BFFF;
}

.activity-item.warning {
    border-left-color: #FF9800;
}

.activity-icon {
    font-size: 1.5em;
    width: 30px;
    text-align: center;
}

.activity-content {
    flex: 1;
}

.activity-title {
    font-weight: bold;
    margin-bottom: 4px;
}

.activity-details {
    color: #ccc;
    font-size: 0.9em;
    margin-bottom: 4px;
}

.activity-time {
    color: #888;
    font-size: 0.8em;
}

.performance-badge {
    background: linear-gradient(45deg, #FFD700, #FFA500);
    color: #000;
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 0.8em;
    font-weight: bold;
    animation: scoreGlow 3s infinite;
}

.propagation-badge {
    background: #4CAF50;
    color: white;
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 0.8em;
    font-weight: bold;
}

.optimize-badge {
    background: #FF9800;
    color: white;
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 0.8em;
    font-weight: bold;
}

.domains-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 20px;
}

.domain-item {
    display: flex;
    align-items: center;
    gap: 20px;
    background: rgba(0,0,0,0.3);
    padding: 20px;
    border-radius: 15px;
    border: 2px solid transparent;
    transition: all 0.3s ease;
}

.domain-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 16px rgba(0,0,0,0.3);
}

.domain-item.champion {
    border-color: #FFD700;
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.1), rgba(0,0,0,0.3));
}

.domain-item.active {
    border-color: #4CAF50;
    background: linear-gradient(135deg, rgba(76, 175, 80, 0.1), rgba(0,0,0,0.3));
}

.domain-item.pending {
    border-color: #FF9800;
    background: linear-gradient(135deg, rgba(255, 152, 0, 0.1), rgba(0,0,0,0.3));
}

.domain-info {
    flex: 1;
}

.domain-name {
    font-size: 1.3em;
    font-weight: bold;
    margin-bottom: 8px;
}

.domain-details {
    display: flex;
    gap: 15px;
    font-size: 0.9em;
    color: #ccc;
}

.domain-status {
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.9em;
    font-weight: bold;
    text-align: center;
    min-width: 120px;
}

.domain-status.yorkshire-champion {
    background: linear-gradient(45deg, #FFD700, #FFA500);
    color: #000;
    animation: championPulse 2s infinite;
}

.domain-status.active {
    background: #4CAF50;
    color: white;
}

.domain-status.pending {
    background: #FF9800;
    color: white;
}

.domain-metrics {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.metric {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

.metric-label {
    color: #ccc;
    font-size: 0.9em;
}

.metric-value {
    font-weight: bold;
}

.metric-value.champion {
    color: #FFD700;
    animation: championGlow 3s infinite;
}

.metric-value.secure {
    color: #4CAF50;
}

.metric-value.good {
    color: #FF9800;
}

.metric-value.pending {
    color: #ccc;
    font-style: italic;
}

.creation-form {
    background: rgba(0,0,0,0.3);
    padding: 20px;
    border-radius: 15px;
    margin: 20px 0;
}

.form-row {
    display: flex;
    align-items: center;
    gap: 15px;
    margin: 15px 0;
    flex-wrap: wrap;
}

.form-row input,
.form-row select {
    padding: 10px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.2);
    background: rgba(0,0,0,0.3);
    color: white;
}

.domain-suffix {
    color: #4CAF50;
    font-weight: bold;
}

.template-buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin: 15px 0;
}

.template-btn {
    background: rgba(76, 175, 80, 0.2);
    border: 1px solid rgba(76, 175, 80, 0.5);
    border-radius: 8px;
    padding: 10px 15px;
    color: #4CAF50;
    cursor: pointer;
    transition: all 0.3s ease;
}

.template-btn:hover {
