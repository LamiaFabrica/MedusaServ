                                </td>
                            </tr>
                            
                            <tr class="record-row active">
                                <td><span class="record-type cname">CNAME</span></td>
                                <td>www</td>
                                <td>poweredbymedusa.com</td>
                                <td>3600</td>
                                <td>-</td>
                                <td><span class="record-status active">ACTIVE</span></td>
                                <td>
                                    <button class="btn-icon" onclick="editDNSRecord('record-2')">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon" onclick="testDNSRecord('record-2')">
                                        <i class="fas fa-search"></i>
                                    </button>
                                    <button class="btn-icon" onclick="deleteDNSRecord('record-2')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                            
                            <tr class="record-row active">
                                <td><span class="record-type txt">TXT</span></td>
                                <td>_dmarc</td>
                                <td>v=DMARC1; p=quarantine; rua=mailto:dmarc@poweredbymedusa.com</td>
                                <td>3600</td>
                                <td>-</td>
                                <td><span class="record-status active">ACTIVE</span></td>
                                <td>
                                    <button class="btn-icon" onclick="editDNSRecord('record-3')">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon" onclick="testDNSRecord('record-3')">
                                        <i class="fas fa-search"></i>
                                    </button>
                                    <button class="btn-icon" onclick="deleteDNSRecord('record-3')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                            
                            <tr class="record-row active">
                                <td><span class="record-type mx">MX</span></td>
                                <td>@</td>
                                <td>mail.poweredbymedusa.com</td>
                                <td>3600</td>
                                <td>10</td>
                                <td><span class="record-status active">ACTIVE</span></td>
                                <td>
                                    <button class="btn-icon" onclick="editDNSRecord('record-4')">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon" onclick="testDNSRecord('record-4')">
                                        <i class="fas fa-search"></i>
                                    </button>
