# Makefile for InstallLamiaNativeWebServerComplete
# Enterprise Deployment System for Lamia Web Server
# © 2025 The Medusa Initiative

CXX = g++
CXXFLAGS = -std=c++20 -O3 -Wall -Wextra -pthread
INCLUDES = -I. -I../include -I/usr/include -I/usr/include/postgresql
LIBS = -lssh -lssh_threads -lpthread -lstdc++fs -lcrypto -lssl -lpq -lcrypt

# Target executable
TARGET = InstallLamiaNativeWebServer

# Source files
SOURCES = InstallLamiaNativeWebServerComplete_clean.cpp InstallDatabaseMethods.cpp InstallAllServices.cpp
HEADERS = InstallLamiaNativeWebServerComplete.hpp

# Object files
OBJECTS = $(SOURCES:.cpp=.o)

# Default target
all: $(TARGET)

# Build the installer
$(TARGET): $(OBJECTS)
	@echo "🔨 Building Lamia Native Web Server Installer..."
	$(CXX) $(CXXFLAGS) $(OBJECTS) -o $(TARGET) $(LIBS)
	@echo "✅ Build complete: $(TARGET)"
	@echo "📦 Size: $$(du -h $(TARGET) | cut -f1)"
	@chmod +x $(TARGET)

# Compile source files
%.o: %.cpp $(HEADERS)
	@echo "📝 Compiling $<..."
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Install to system
install: $(TARGET)
	@echo "📥 Installing to /usr/local/bin..."
	sudo cp $(TARGET) /usr/local/bin/
	sudo chmod +x /usr/local/bin/$(TARGET)
	@echo "✅ Installed successfully!"
	@echo "🚀 Run with: $(TARGET)"

# Create deployment package
package: $(TARGET)
	@echo "📦 Creating deployment package..."
	mkdir -p ../deployment-package
	cp $(TARGET) ../deployment-package/
	cp $(HEADERS) ../deployment-package/
	tar -czf ../medusa-installer-v0.4.0.tar.gz -C ../deployment-package .
	@echo "✅ Package created: ../medusa-installer-v0.4.0.tar.gz"

# Run the installer
run: $(TARGET)
	@echo "🚀 Launching Lamia Web Server Installer..."
	./$(TARGET)

# Run with verbose mode
run-verbose: $(TARGET)
	./$(TARGET) --verbose

# Run with specific target
run-target: $(TARGET)
	@read -p "Enter target IP: " ip; \
	./$(TARGET) --target $$ip

# Clean build files
clean:
	@echo "🧹 Cleaning build files..."
	rm -f $(OBJECTS) $(TARGET)
	rm -rf ../deployment-package
	@echo "✅ Clean complete"

# Development mode with debug symbols
debug: CXXFLAGS = -std=c++20 -g -O0 -Wall -Wextra -pthread -DDEBUG
debug: clean $(TARGET)
	@echo "🐛 Debug build complete"

# Static build for maximum portability
static: CXXFLAGS = -std=c++20 -O3 -Wall -Wextra -pthread -static
static: LIBS = -lssh -lssh_threads -lpthread -static-libgcc -static-libstdc++ -lcrypto -lssl -lpq -lcrypt -ldl
static: clean $(TARGET)
	@echo "📦 Static build complete"
	strip $(TARGET)
	@echo "📏 Stripped size: $$(du -h $(TARGET) | cut -f1)"

# Check dependencies
check-deps:
	@echo "🔍 Checking dependencies..."
	@which g++ > /dev/null || (echo "❌ g++ not found"; exit 1)
	@echo "✅ g++ found"
	@ldconfig -p | grep libssh > /dev/null || (echo "❌ libssh not found"; exit 1)
	@echo "✅ libssh found"
	@echo "✅ All dependencies satisfied"

# Help target
help:
	@echo ""
	@echo "🌟 Lamia Native Web Server Installer - Build System 🌟"
	@echo "======================================================"
	@echo ""
	@echo "Available targets:"
	@echo "  make              - Build the installer"
	@echo "  make install      - Install to /usr/local/bin"
	@echo "  make package      - Create deployment package"
	@echo "  make run          - Run the installer"
	@echo "  make run-verbose  - Run with verbose output"
	@echo "  make run-target   - Run with specific target IP"
	@echo "  make debug        - Build with debug symbols"
	@echo "  make static       - Build static executable"
	@echo "  make clean        - Remove build files"
	@echo "  make check-deps   - Check build dependencies"
	@echo "  make help         - Show this help"
	@echo ""
	@echo "Example workflow:"
	@echo "  1. make check-deps"
	@echo "  2. make"
	@echo "  3. make run"
	@echo ""

.PHONY: all install package run run-verbose run-target clean debug static check-deps help