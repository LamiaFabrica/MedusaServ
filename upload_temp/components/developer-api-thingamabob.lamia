            </div>

            <h4 style="color: #00ff88; margin-top: 30px;">IDE Extensions</h4>
            <div class="sdk-download-section">
                <div class="sdk-card" onclick="downloadIDE('vscode')">
                    <div class="sdk-language">VS Code</div>
                    <p style="color: #ccc; font-size: 14px;">Syntax highlighting, IntelliSense, debugging</p>
                </div>
                <div class="sdk-card" onclick="downloadIDE('intellij')">
                    <div class="sdk-language">IntelliJ IDEA</div>
