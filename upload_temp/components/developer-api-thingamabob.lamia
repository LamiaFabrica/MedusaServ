        <div id="api-content-webhooks" class="api-content" style="display: none;">
            <h3 style="color: #00ff88;">Webhook Management</h3>
            
            <div class="webhook-builder">
                <h4 style="color: #00ff88;">Create New Webhook</h4>
                <div class="test-input-group">
                    <label class="test-input-label">Webhook URL</label>
                    <input type="url" class="webhook-url-input" id="webhook-url" placeholder="https://your-app.com/webhooks/medusa">
                </div>
                <div class="test-input-group">
                    <label class="test-input-label">Events to Subscribe</label>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 10px 0;">
                        <label style="color: #ccc;"><input type="checkbox" value="extension.installed"> Extension Installed</label>
                        <label style="color: #ccc;"><input type="checkbox" value="extension.updated"> Extension Updated</label>
                        <label style="color: #ccc;"><input type="checkbox" value="system.status"> System Status Change</label>
                        <label style="color: #ccc;"><input type="checkbox" value="api.rate_limit"> Rate Limit Reached</label>
                        <label style="color: #ccc;"><input type="checkbox" value="security.threat"> Security Threat Detected</label>
                        <label style="color: #ccc;"><input type="checkbox" value="ai.ipa.blocked"> AI IPA Blocked Request</label>
                    </div>
                </div>
                <button class="generate-key-btn" onclick="createWebhook()">Create Webhook</button>
            </div>

            <div class="api-endpoint-group">
                <div class="endpoint-header">
                    <span>Webhook Payload Example</span>
                    <span class="security-badge">AI IPA SECURED</span>
                </div>
                <div class="endpoint-body expanded">
                    <div class="code-block">
{
  "event": "extension.installed",
  "timestamp": "2025-01-24T10:30:00Z",
  "data": {
    "extension_id": "ext_12345",
    "extension_name": "Advanced Security Monitor",
    "version": "1.2.3",
    "installed_by": "user_67890"
  },
  "signature": "sha256=abcdef123456...",
  "ai_ipa_validated": true
}
                    </div>
                </div>
            </div>

            <h4 style="color: #00ff88;">Active Webhooks</h4>
            <div id="webhook-list" class="api-endpoint-group">
                <div class="endpoint-header">
                    <span>No webhooks configured</span>
                    <span style="color: #666; font-size: 12px;">Create your first webhook above</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
class DeveloperAPIManager {
    constructor() {
        this.currentTab = 'overview';
        this.apiKey = null;
        this.testResults = [];
        this.webhooks = [];
        this.initializeWebSocket();
        this.loadSavedApiKey();
    }

    initializeWebSocket() {
        try {
            this.ws = new WebSocket('wss://localhost:8443/developer-api');
            this.ws.onopen = () => {
                console.log('Developer API WebSocket connected');
                this.updateConnectionStatus(true);
            };
            this.ws.onmessage = (event) => {
                const data = JSON.parse(event.data);
                this.handleRealtimeUpdate(data);
            };
            this.ws.onerror = (error) => {
                console.error('Developer API WebSocket error:', error);
                this.updateConnectionStatus(false);
            };
        } catch (error) {
            console.error('WebSocket initialization failed:', error);
        }
    }

    handleRealtimeUpdate(data) {
        switch(data.type) {
            case 'api_key_generated':
                document.getElementById('generated-api-key').value = data.api_key;
                this.showNotification('New API key generated successfully', 'success');
                break;
            case 'webhook_triggered':
                this.addWebhookLog(data);
                break;
            case 'rate_limit_warning':
                this.showNotification(`Rate limit warning: ${data.usage}`, 'warning');
                break;
            case 'security_alert':
                this.showNotification(`Security Alert: ${data.message}`, 'error');
                break;
        }
    }

    updateConnectionStatus(connected) {
        const indicator = document.querySelector('.ipa-dot');
        if (indicator) {
            indicator.style.background = connected ? '#00ff88' : '#ff6b35';
        }
    }

    generateApiKey() {
        const timestamp = Date.now();
        const randomBytes = new Uint8Array(32);
        crypto.getRandomValues(randomBytes);
        const keyData = Array.from(randomBytes).map(b => b.toString(16).padStart(2, '0')).join('');
        const apiKey = `mds_${timestamp.toString(36)}_${keyData.substring(0, 32)}`;
        
        document.getElementById('generated-api-key').value = apiKey;
        this.apiKey = apiKey;
        this.saveApiKey(apiKey);
        
        // Send to server for validation and storage
        if (this.ws && this.ws.readyState === WebSocket.OPEN) {
            this.ws.send(JSON.stringify({
                action: 'generate_api_key',
                key: apiKey,
                timestamp: new Date().toISOString(),
                ai_ipa_validated: true
            }));
        }
        
        this.showNotification('API key generated and secured with AI IPA protection', 'success');
    }

    saveApiKey(key) {
        localStorage.setItem('medusa_api_key', key);
    }

    loadSavedApiKey() {
        const saved = localStorage.getItem('medusa_api_key');
        if (saved) {
            document.getElementById('generated-api-key').value = saved;
            this.apiKey = saved;
        }
    }

    showApiTab(tabName) {
        // Hide all content
        const contents = document.querySelectorAll('[id^="api-content-"]');
        contents.forEach(content => content.style.display = 'none');
        
        // Remove active class from all tabs
        const tabs = document.querySelectorAll('.api-tab');
        tabs.forEach(tab => tab.classList.remove('active'));
        
        // Show selected content and activate tab
        document.getElementById(`api-content-${tabName}`).style.display = 'block';
        event.target.classList.add('active');
        
        this.currentTab = tabName;
        
        // Log tab access for Purple Pages
        this.logActivity(`Viewed API documentation: ${tabName}`);
    }

    toggleEndpoint(endpointId) {
        const body = document.getElementById(endpointId);
        body.classList.toggle('expanded');
    }

    async sendTestRequest() {
        const endpoint = document.getElementById('test-endpoint').value;
        const method = document.getElementById('test-method').value;
        const apiKey = document.getElementById('test-api-key').value;
        const headers = document.getElementById('test-headers').value;
        const body = document.getElementById('test-body').value;
        
        if (!apiKey) {
            this.showNotification('Please enter your API key', 'error');
            return;
        }

        const responseDiv = document.getElementById('test-response');
        responseDiv.innerHTML = '<p style="color: #00ff88;">Sending request...</p>';

        try {
            const requestHeaders = {
                'Authorization': `Bearer ${apiKey}`,
                'X-IPA-Token': this.generateIPAToken(),
                'Content-Type': 'application/json'
            };

            if (headers) {
                const customHeaders = JSON.parse(headers);
                Object.assign(requestHeaders, customHeaders);
            }

            const requestOptions = {
                method: method,
                headers: requestHeaders
            };

            if (method !== 'GET' && body) {
                requestOptions.body = body;
            }

            // Simulate API call (in real implementation, this would call the actual API)
            setTimeout(() => {
                const mockResponse = {
                    status: 200,
                    headers: {
                        'Content-Type': 'application/json',
                        'X-AI-IPA-Validated': 'true',
                        'X-Rate-Limit-Remaining': '999'
                    },
                    body: {
                        success: true,
                        message: 'Request processed successfully',
                        data: {
                            endpoint: endpoint,
                            method: method,
                            timestamp: new Date().toISOString(),
                            ai_ipa_status: 'validated'
                        }
                    }
                };

                this.displayTestResponse(mockResponse);
                this.logActivity(`API test: ${method} ${endpoint}`);
            }, 1500);

        } catch (error) {
            responseDiv.innerHTML = `<p style="color: #ff6b35;">Error: ${error.message}</p>`;
        }
    }

    generateIPAToken() {
        const timestamp = Date.now();
        const randomData = Math.random().toString(36).substring(2);
        return `ipa_${timestamp}_${randomData}`;
    }

    displayTestResponse(response) {
        const responseDiv = document.getElementById('test-response');
        responseDiv.innerHTML = `
            <div style="color: #00ff88; margin-bottom: 10px;">
                <strong>Status:</strong> ${response.status}
            </div>
            <div style="color: #ccc; margin-bottom: 10px;">
                <strong>Headers:</strong>
                <pre style="font-size: 12px; margin: 5px 0;">${JSON.stringify(response.headers, null, 2)}</pre>
            </div>
            <div style="color: #ccc;">
                <strong>Response Body:</strong>
                <pre style="font-size: 12px; margin: 5px 0;">${JSON.stringify(response.body, null, 2)}</pre>
            </div>
        `;
    }

    clearTestResponse() {
        document.getElementById('test-response').innerHTML = '<p style="color: #ccc;">Response will appear here...</p>';
    }

    downloadSDK(language) {
        // In real implementation, this would download the actual SDK
        this.showNotification(`Downloading ${language.toUpperCase()} SDK v0.4.0...`, 'success');
        this.logActivity(`Downloaded SDK: ${language}`);
        
        // Simulate download
        setTimeout(() => {
            this.showNotification(`${language.toUpperCase()} SDK downloaded successfully`, 'success');
        }, 2000);
    }

    downloadIDE(ide) {
        this.showNotification(`Downloading ${ide} extension...`, 'success');
        this.logActivity(`Downloaded IDE extension: ${ide}`);
    }

    createWebhook() {
        const url = document.getElementById('webhook-url').value;
        const events = Array.from(document.querySelectorAll('input[type="checkbox"]:checked'))
                          .map(cb => cb.value);

        if (!url) {
            this.showNotification('Please enter a webhook URL', 'error');
            return;
        }

        if (events.length === 0) {
            this.showNotification('Please select at least one event', 'error');
            return;
        }

        const webhook = {
            id: `webhook_${Date.now()}`,
            url: url,
            events: events,
            created: new Date().toISOString(),
            status: 'active'
        };

        this.webhooks.push(webhook);
        this.updateWebhookList();
        this.showNotification('Webhook created successfully', 'success');
        this.logActivity(`Created webhook: ${url}`);

        // Clear form
        document.getElementById('webhook-url').value = '';
        document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
    }

    updateWebhookList() {
        const listDiv = document.getElementById('webhook-list');
        if (this.webhooks.length === 0) {
            listDiv.innerHTML = `
                <div class="endpoint-header">
                    <span>No webhooks configured</span>
                    <span style="color: #666; font-size: 12px;">Create your first webhook above</span>
                </div>
            `;
        } else {
            const webhookHtml = this.webhooks.map(webhook => `
                <div class="endpoint-header" style="background: rgba(0, 255, 136, 0.1);">
                    <span>${webhook.url}</span>
                    <span class="endpoint-method" style="background: #00ff88;">ACTIVE</span>
                </div>
            `).join('');
            listDiv.innerHTML = webhookHtml;
        }
    }

    logActivity(activity) {
        // Log to Purple Pages system
        if (this.ws && this.ws.readyState === WebSocket.OPEN) {
            this.ws.send(JSON.stringify({
                action: 'log_activity',
                activity: activity,
                timestamp: new Date().toISOString(),
                component: 'developer_api',
                ai_ipa_validated: true
            }));
        }
        console.log(`[Developer API] ${activity}`);
    }

    showNotification(message, type = 'info') {
        // Create notification element
        const notification = document.createElement('div');
        notification.style.cssText = `
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 15px 20px;
            border-radius: 5px;
            color: white;
            font-weight: bold;
            z-index: 10000;
            opacity: 0;
            transition: opacity 0.3s ease;
        `;
        
        switch(type) {
            case 'success':
                notification.style.background = 'linear-gradient(135deg, #00ff88, #00cc6a)';
                break;
            case 'error':
                notification.style.background = 'linear-gradient(135deg, #ff6b35, #ff4500)';
                break;
            case 'warning':
                notification.style.background = 'linear-gradient(135deg, #f7931e, #ff6b35)';
                break;
            default:
                notification.style.background = 'linear-gradient(135deg, #333, #555)';
        }
        
        notification.textContent = message;
        document.body.appendChild(notification);
        
        // Fade in
        setTimeout(() => notification.style.opacity = '1', 100);
        
        // Fade out and remove
        setTimeout(() => {
            notification.style.opacity = '0';
            setTimeout(() => document.body.removeChild(notification), 300);
        }, 3000);
    }
}

// Global functions for onclick events
let developerApiManager;

function initializeDeveloperAPI() {
    developerApiManager = new DeveloperAPIManager();
}

function showApiTab(tabName) {
    developerApiManager.showApiTab(tabName);
}

function toggleEndpoint(endpointId) {
    developerApiManager.toggleEndpoint(endpointId);
}

function generateApiKey() {
    developerApiManager.generateApiKey();
}

function sendTestRequest() {
    developerApiManager.sendTestRequest();
}

function clearTestResponse() {
    developerApiManager.clearTestResponse();
}

function downloadSDK(language) {
    developerApiManager.downloadSDK(language);
}

function downloadIDE(ide) {
    developerApiManager.downloadIDE(ide);
}

function createWebhook() {
    developerApiManager.createWebhook();
}

// Initialize when DOM is loaded
document.addEventListener('DOMContentLoaded', initializeDeveloperAPI);
</script>