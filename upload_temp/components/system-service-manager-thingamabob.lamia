<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Service Manager - PFQL Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/portal-style.css">
</head>
<body>
    <div class="portal-header">
        <h1>⚙️ System Service Manager</h1>
        <div class="portal-status" id="serviceStatus">
            <span class="status-indicator online"></span>
            Service Manager: ACTIVE
        </div>
    </div>

    <div class="service-container">
        <div class="service-controls">
            <button class="service-btn" onclick="serviceManager.refreshServices()">🔄 Refresh</button>
            <button class="service-btn" onclick="serviceManager.startService()">▶️ Start Service</button>
            <button class="service-btn" onclick="serviceManager.stopService()">⏹️ Stop Service</button>
            <button class="service-btn" onclick="serviceManager.restartService()">🔁 Restart Service</button>
        </div>

        <div class="services-grid" id="servicesGrid">
            <!-- Services will be populated here -->
        </div>

        <div class="service-output" id="serviceOutput">
            <div>[SERVICE] System service manager initialized</div>
            <div>[SERVICE] Connected to PsiForceDB on 172.236.23.54</div>
            <div>[SERVICE] Loading system services...</div>
        </div>
    </div>

    <script>
        class SystemServiceManager {
            constructor() {
                this.services = [];
                this.init();
            }

            async init() {
                await this.connectToPsiForceDB();
                await this.loadServices();
                this.startServiceMonitoring();
            }

            async connectToPsiForceDB() {
                try {
                    const response = await fetch('/api/pfql-routes/system/services/status', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            server: '172.236.23.54',
                            database: 'psiforcedb_system'
                        })
                    });
                    
                    if (response.ok) {
                        this.logOutput('[SERVICE] Connected to PsiForceDB service management system');
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Connection failed: ${error.message}`);
                }
            }

            async loadServices() {
                this.logOutput('[SERVICE] Loading system services...');
                try {
                    const response = await fetch('/api/pfql-routes/system/services/list', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://system:services:list',
                            server: '172.236.23.54'
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        this.services = result.services || this.getDefaultServices();
                        this.displayServices();
                        this.logOutput(`[SERVICE] Loaded ${this.services.length} services`);
                    } else {
                        this.services = this.getDefaultServices();
                        this.displayServices();
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Failed to load services: ${error.message}`);
                    this.services = this.getDefaultServices();
                    this.displayServices();
                }
            }

            async refreshServices() {
                await this.loadServices();
            }

            async startService() {
                const serviceName = prompt('Enter service name to start:');
                if (serviceName) {
                    await this.executeServiceAction('start', serviceName);
                }
            }

            async stopService() {
                const serviceName = prompt('Enter service name to stop:');
                if (serviceName) {
                    const confirmStop = confirm(`Stop service "${serviceName}"?`);
                    if (confirmStop) {
                        await this.executeServiceAction('stop', serviceName);
                    }
                }
            }

            async restartService() {
                const serviceName = prompt('Enter service name to restart:');
                if (serviceName) {
                    await this.executeServiceAction('restart', serviceName);
                }
            }

            async executeServiceAction(action, serviceName) {
                this.logOutput(`[SERVICE] ${action.toUpperCase()}ing service: ${serviceName}...`);
                try {
                    const response = await fetch(`/api/pfql-routes/system/services/${action}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: `pf://system:service:${action}`,
                            server: '172.236.23.54',
                            serviceName: serviceName
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        this.logOutput(`[SERVICE] Service ${serviceName} ${action}ed: ${result.status}`);
                        await this.loadServices(); // Refresh service list
                    } else {
                        throw new Error(`Failed to ${action} service`);
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Failed to ${action} service ${serviceName}: ${error.message}`);
                }
            }

            async toggleService(serviceName, currentStatus) {
                const action = currentStatus === 'running' ? 'stop' : 'start';
                await this.executeServiceAction(action, serviceName);
            }

            async restartSpecificService(serviceName) {
                await this.executeServiceAction('restart', serviceName);
            }

            displayServices() {
                const grid = document.getElementById('servicesGrid');
                grid.innerHTML = this.services.map(service => `
                    <div class="service-card ${service.status}">
                        <div class="service-header">
                            <h4>${service.name}</h4>
                            <div class="service-status-badge ${service.status}">
                                ${service.status.toUpperCase()}
                            </div>
                        </div>
                        
                        <div class="service-details">
                            <div class="service-info">
                                <div><strong>Description:</strong> ${service.description}</div>
                                <div><strong>PID:</strong> ${service.pid || 'N/A'}</div>
                                <div><strong>Uptime:</strong> ${service.uptime || 'N/A'}</div>
                                <div><strong>Memory:</strong> ${service.memory || 'N/A'}</div>
                            </div>
                        </div>
                        
                        <div class="service-actions">
                            <button class="service-action-btn ${service.status === 'running' ? 'stop' : 'start'}" 
                                    onclick="serviceManager.toggleService('${service.name}', '${service.status}')">
                                ${service.status === 'running' ? '⏹️ Stop' : '▶️ Start'}
                            </button>
                            <button class="service-action-btn restart" 
                                    onclick="serviceManager.restartSpecificService('${service.name}')">
                                🔁 Restart
                            </button>
                            <button class="service-action-btn info" 
                                    onclick="serviceManager.showServiceDetails('${service.name}')">
                                ℹ️ Details
                            </button>
                        </div>
                    </div>
                `).join('');
            }

            async showServiceDetails(serviceName) {
                this.logOutput(`[SERVICE] Getting details for service: ${serviceName}...`);
                try {
                    const response = await fetch('/api/pfql-routes/system/services/details', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://system:service:details',
                            server: '172.236.23.54',
                            serviceName: serviceName
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        this.displayServiceDetails(result);
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Failed to get service details: ${error.message}`);
                    alert(`Service Details for ${serviceName}\n\nDetailed information would be displayed here in a production environment.`);
                }
            }

            displayServiceDetails(details) {
                // Create a modal or detailed view for service information
                alert(`Service Details:\n\nName: ${details.name}\nStatus: ${details.status}\nDescription: ${details.description}\nConfiguration: ${details.configPath || 'N/A'}\nLogs: ${details.logPath || 'N/A'}`);
            }

            startServiceMonitoring() {
                setInterval(async () => {
                    try {
                        await this.loadServices();
                    } catch (error) {
                        // Silent monitoring
                    }
                }, 30000); // Every 30 seconds
            }

            getDefaultServices() {
                return [
                    {
                        name: 'psiforcedb',
                        status: 'running',
                        description: 'PsiForceDB Database Engine',
                        pid: 1234,
                        uptime: '7d 12h',
                        memory: '2.1GB'
                    },
                    {
                        name: 'nginx',
                        status: 'running',
                        description: 'Web Server',
                        pid: 5678,
                        uptime: '7d 12h',
                        memory: '245MB'
                    },
                    {
                        name: 'medusa-ce',
                        status: 'running',
                        description: 'Medusa CE AI Assistant',
                        pid: 9012,
                        uptime: '2d 8h',
                        memory: '1.8GB'
                    },
                    {
                        name: 'pfql-processor',
                        status: 'running',
                        description: 'PFQL Form Processor Engine',
                        pid: 3456,
                        uptime: '1d 4h',
                        memory: '512MB'
                    },
                    {
                        name: 'system-monitor',
                        status: 'stopped',
                        description: 'System Resource Monitor',
                        pid: null,
                        uptime: null,
                        memory: null
                    },
                    {
                        name: 'backup-service',
                        status: 'running',
                        description: 'Automated Backup Service',
                        pid: 7890,
                        uptime: '7d 12h',
                        memory: '128MB'
                    }
                ];
            }

            logOutput(message) {
                const output = document.getElementById('serviceOutput');
                const timestamp = new Date().toLocaleTimeString();
                output.innerHTML += `<div>[${timestamp}] ${message}</div>`;
                output.scrollTop = output.scrollHeight;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            window.serviceManager = new SystemServiceManager();
        });
    </script>
    
    <style>
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 15px;
            margin: 15px 0;
        }
        .service-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #64B5F6;
            border-radius: 8px;
            padding: 15px;
            transition: all 0.3s ease;
        }
        .service-card.running {
            border-color: #4CAF50;
            background: rgba(76, 175, 80, 0.1);
        }
        .service-card.stopped {
            border-color: #F44336;
            background: rgba(244, 67, 54, 0.1);
        }
        .service-card.failed {
            border-color: #FF5722;
            background: rgba(255, 87, 34, 0.1);
        }
        .service-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }
        .service-status-badge {
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: bold;
        }
        .service-status-badge.running {
            background: #4CAF50;
            color: white;
        }
        .service-status-badge.stopped {
            background: #F44336;
            color: white;
        }
        .service-status-badge.failed {
            background: #FF5722;
            color: white;
        }
        .service-details {
            margin: 10px 0;
        }
        .service-info div {
            margin: 5px 0;
            font-size: 14px;
        }
        .service-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 15px;
        }
        .service-action-btn {
            padding: 6px 12px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            font-weight: bold;
            transition: all 0.3s ease;
        }
        .service-action-btn.start {
            background: #4CAF50;
            color: white;
        }
        .service-action-btn.stop {
            background: #F44336;
            color: white;
        }
        .service-action-btn.restart {
            background: #FF9800;
            color: white;
        }
        .service-action-btn.info {
            background: #2196F3;
            color: white;
        }
        .service-action-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }
    </style>
</body>
</html>