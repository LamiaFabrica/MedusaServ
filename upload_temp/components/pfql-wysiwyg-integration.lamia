/**
 * PFQL WYSIWYG INTEGRATION COMPONENT
 * Direct Integration with PsiForceDB_WYSIWYG_Ultimate.hpp
 * Quantum Database WYSIWYG Editor with Holographic Visualization
 * © 2025 The Medusa Project | Roylepython | D Hargreaves
 */

@component "pfql_wysiwyg_integration" {
    @version "2025.1.0"
    @wysiwyg_engine "PsiForceDB_WYSIWYG_Ultimate"
    @includes_cpp "PsiForceDB_WYSIWYG_Ultimate.hpp"
    @includes_cpp "PsiForceDB_WYSIWYG_Core.hpp"
    
    @render {
        <!-- PFQL WYSIWYG Ultimate Editor Interface -->
        <div class="pfql-wysiwyg-container" id="pfqlWysiwygContainer">
            <!-- WYSIWYG Header -->
            <div class="wysiwyg-header">
                <div class="wysiwyg-brand">
                    <div class="quantum-dinosaur">🦕</div>
                    <div class="brand-content">
                        <h3>PsiForceDB WYSIWYG Ultimate</h3>
                        <span class="tagline">"Quantum Database Visualization"</span>
                    </div>
                </div>
                <div class="wysiwyg-controls">
                    <button class="control-btn" onclick="initializeQuantumEcosystem()">Initialize Ecosystem</button>
                    <button class="control-btn" onclick="startHolographicRendering()">Holographic Mode</button>
                    <button class="control-btn" onclick="enableConsciousness()">Consciousness</button>
                </div>
            </div>
            
            <!-- Quantum Entity Manager -->
            <div class="quantum-entity-manager">
                <h4>Quantum Database Entities</h4>
                <div class="entity-grid" id="quantumEntityGrid">
                    <!-- Entities will be populated by JavaScript -->
                </div>
                <div class="entity-controls">
                    <select id="entityTypeSelect">
                        <option value="T_REX_TABLE">T-Rex Table</option>
                        <option value="VELOCIRAPTOR_VIEW">Velociraptor View</option>
                        <option value="TRICERATOPS_TRIGGER">Triceratops Trigger</option>
                        <option value="BRACHIOSAURUS_INDEX">Brachiosaurus Index</option>
                        <option value="STEGOSAURUS_STORED_PROC">Stegosaurus Stored Proc</option>
                        <option value="PTERANODON_FUNCTION">Pteranodon Function</option>
                        <option value="COMPSOGNATHUS_CONSTRAINT">Compsognathus Constraint</option>
                        <option value="DILOPHOSAURUS_SEQUENCE">Dilophosaurus Sequence</option>
                    </select>
                    <input type="text" id="entityNameInput" placeholder="Entity name (optional)">
                    <button class="add-entity-btn" onclick="addQuantumEntity()">Add Quantum Entity</button>
                </div>
            </div>
            
            <!-- Holographic Visualization Canvas -->
            <div class="holographic-visualization">
                <h4>Holographic 3D Visualization</h4>
                <div class="holographic-canvas" id="holographicCanvas">
                    <div class="rendering-stats">
                        <span>FPS: <span id="fpsCounter">60</span></span>
                        <span>Entities: <span id="entityCount">0</span></span>
                        <span>Quantum State: <span id="quantumState">COHERENT</span></span>
                    </div>
                    <div class="holographic-display" id="holographicDisplay">
                        <!-- 3D holographic entities will be rendered here -->
                    </div>
                </div>
                <div class="visualization-controls">
                    <button onclick="rotateView('x')">Rotate X</button>
                    <button onclick="rotateView('y')">Rotate Y</button>
                    <button onclick="rotateView('z')">Rotate Z</button>
                    <button onclick="enableTemporalNavigation()">Time Travel</button>
                    <button onclick="triggerQuantumEntanglement()">Entangle All</button>
                </div>
            </div>
            
            <!-- Consciousness Interface -->
            <div class="consciousness-interface">
                <h4>Consciousness Awareness System</h4>
                <div class="consciousness-status">
                    <div class="status-item">
                        <span>Awareness Level:</span>
                        <span class="awareness-level" id="awarenessLevel">0.0%</span>
                    </div>
                    <div class="status-item">
                        <span>Neural Sync:</span>
                        <span class="neural-sync" id="neuralSync">40.0 Hz</span>
                    </div>
                    <div class="status-item">
                        <span>Thought Patterns:</span>
                        <span class="thought-patterns" id="thoughtPatterns">0</span>
                    </div>
                </div>
                <div class="consciousness-controls">
                    <textarea id="thoughtPatternInput" placeholder="Enter thought patterns (one per line)..." rows="4"></textarea>
                    <button onclick="interactWithConsciousness()">Send to Consciousness</button>
                    <button onclick="healConsciousnessPatterns()">Heal Patterns</button>
                    <button onclick="evolveConsciousness()">Evolve Consciousness</button>
                </div>
            </div>
            
            <!-- Chaos Theory Controls -->
            <div class="chaos-theory-controls">
                <h4>Chaos Theory Engine</h4>
                <div class="chaos-parameters">
                    <div class="parameter-control">
                        <label>Butterfly Effect Sensitivity:</label>
                        <input type="range" id="butterflyEffect" min="0.0001" max="0.01" step="0.0001" value="0.001">
                        <span id="butterflyValue">0.001</span>
                    </div>
                    <div class="parameter-control">
                        <label>Strange Attractor Force:</label>
                        <input type="range" id="attractorForce" min="0.1" max="1.0" step="0.1" value="0.7">
                        <span id="attractorValue">0.7</span>
                    </div>
                    <div class="parameter-control">
                        <label>Fractal Complexity:</label>
                        <input type="range" id="fractalComplexity" min="1.0" max="2.0" step="0.1" value="1.618">
                        <span id="fractalValue">1.618</span>
                    </div>
                </div>
                <div class="chaos-actions">
                    <button onclick="applyChaosTheory()">Apply Chaos Theory</button>
                    <button onclick="triggerButterflyEffect()">Butterfly Effect</button>
                    <button onclick="generateFractalPatterns()">Generate Fractals</button>
                </div>
            </div>
            
            <!-- Temporal Navigation System -->
            <div class="temporal-navigation">
                <h4>Temporal Navigation System</h4>
                <div class="temporal-status">
                    <span>Navigation: <span id="temporalStatus">Disabled</span></span>
                    <span>Checkpoints: <span id="checkpointCount">0</span></span>
                    <span>Current Time: <span id="currentTime">Present</span></span>
                </div>
                <div class="temporal-controls">
                    <input type="text" id="checkpointName" placeholder="Checkpoint name">
                    <button onclick="createTemporalCheckpoint()">Create Checkpoint</button>
                    <select id="checkpointSelect">
                        <option value="">Select checkpoint...</option>
                    </select>
                    <button onclick="timeTravel()">Time Travel</button>
                </div>
            </div>
            
            <!-- System Statistics -->
            <div class="system-statistics">
                <h4>Ecosystem Statistics</h4>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-label">Entity Count:</span>
                        <span class="stat-value" id="statEntityCount">0</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Chaos Level:</span>
                        <span class="stat-value" id="statChaosLevel">0.0%</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Consciousness Connections:</span>
                        <span class="stat-value" id="statConsciousnessConnections">0</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Collective Intelligence:</span>
                        <span class="stat-value" id="statCollectiveIntelligence">0.0</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Temporal Checkpoints:</span>
                        <span class="stat-value" id="statTemporalCheckpoints">0</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">System Uptime:</span>
                        <span class="stat-value" id="statUptime">0ms</span>
                    </div>
                </div>
            </div>
        </div>
    }
    
    @javascript {
        // PsiForceDB WYSIWYG Ultimate Integration
        class PsiForceDBWYSIWYGUltimate {
            constructor() {
                this.quantumManager = null;
                this.entities = [];
                this.holographicRenderer = null;
                this.consciousnessLevel = 0.0;
                this.chaosParameters = {
                    butterfly_effect_sensitivity: 0.001,
                    strange_attractor_force: 0.7,
                    fractal_complexity: 1.618,
                    entropy_increase_rate: 0.1,
                    feedback_loop_strength: 0.5,
                    nonlinear_response_factor: 2.5
                };
                this.temporalCheckpoints = new Map();
                this.systemStartTime = Date.now();
                this.initializationComplete = false;
            }
            
            // Initialize Quantum Ecosystem
            initializeQuantumEcosystem() {
                console.log('🦕 Initializing Quantum Ecosystem...');
                
                this.quantumManager = {
                    quantum_ecosystem_active: true,
                    ecosystem_chaos_level: 0.1,
                    active_consciousness_connections: 0,
                    holographic_rendering_active: false,
                    temporal_navigation_enabled: false,
                    collective_intelligence_level: 0.0
                };
                
                // Create initial temporal checkpoint
                this.createTemporalCheckpoint('ECOSYSTEM_GENESIS');
                
                this.updateSystemStatistics();
                this.initializationComplete = true;
                
                console.log('🌌 Quantum ecosystem initialized - PsiForceDB Ultimate online!');
                console.log('🦕 "Life Finds a Way" - Quantum database ecosystem activated');
            }
            
            // Add Quantum Entity to Ecosystem
            addQuantumEntity(type, name) {
                if (!this.initializationComplete) {
                    console.warn('❌ Quantum ecosystem not initialized. Please initialize first.');
                    return;
                }
                
                const entityType = type || document.getElementById('entityTypeSelect').value;
                const entityName = name || document.getElementById('entityNameInput').value || '';
                
                const entity = {
                    id: this.generateQuantumId(),
                    jurassic_name: entityName || this.generateJurassicName(entityType),
                    dinosaur_type: entityType,
                    quantum_state: 'COHERENT',
                    creation_time: Date.now(),
                    holographic_position: {
                        x: (Math.random() - 0.5) * 20,
                        y: (Math.random() - 0.5) * 20,
                        z: (Math.random() - 0.5) * 20,
                        temporal_dimension: 0.0
                    },
                    quantum_color: {
                        primary: {
                            red: 0.2 + Math.random() * 0.3,
                            green: 0.8,
                            blue: 0.4,
                            alpha: 1.0,
                            quantum_phase: 0.0
                        }
                    },
                    consciousness_aware: false,
                    ai_optimized: false,
                    entangled_objects: new Set(),
                    temporal_snapshots: []
                };
                
                // Enable quantum features
                this.enableQuantumFeatures(entity);
                
                // Add to ecosystem
                this.entities.push(entity);
                
                // Update UI
                this.renderEntityGrid();
                this.updateHolographicVisualization();
                this.updateSystemStatistics();
                
                console.log(`🦕 Quantum entity added: ${entity.jurassic_name} (ID: ${entity.id})`);
                
                // Clear input
                document.getElementById('entityNameInput').value = '';
            }
            
            // Enable Quantum Features for Entity
            enableQuantumFeatures(entity) {
                entity.consciousness_aware = Math.random() > 0.5;
                entity.ai_optimized = Math.random() > 0.3;
                
                if (entity.consciousness_aware) {
                    entity.neural_synchronization_level = 0.8;
                    entity.neural_synchronization_frequency = 40.0;
                }
                
                if (entity.ai_optimized) {
                    entity.ai_intelligence_level = 0.8;
                    entity.ai_suggestions = this.generateAISuggestions(entity);
                }
            }
            
            // Start Holographic Rendering
            startHolographicRendering() {
                if (this.holographicRenderer) {
                    console.log('🌈 Holographic rendering already active');
                    return;
                }
                
                this.quantumManager.holographic_rendering_active = true;
                
                this.holographicRenderer = setInterval(() => {
                    this.updateHolographicVisualization();
                    this.applyQuantumFieldFluctuations();
                    
                    // Update FPS counter
                    document.getElementById('fpsCounter').textContent = '60';
                }, 16); // ~60 FPS
                
                console.log('🌈 Holographic rendering system started (60 FPS quantum visualization)');
            }
            
            // Update Holographic Visualization
            updateHolographicVisualization() {
                const display = document.getElementById('holographicDisplay');
                display.innerHTML = '';
                
                this.entities.forEach((entity, index) => {
                    const entityDiv = document.createElement('div');
                    entityDiv.className = 'holographic-entity';
                    entityDiv.style.cssText = `
                        position: absolute;
                        left: ${(entity.holographic_position.x + 10) * 10}px;
                        top: ${(entity.holographic_position.y + 10) * 10}px;
                        transform: translateZ(${entity.holographic_position.z}px);
                        color: rgba(${entity.quantum_color.primary.red * 255}, 
                                   ${entity.quantum_color.primary.green * 255}, 
                                   ${entity.quantum_color.primary.blue * 255}, 
                                   ${entity.quantum_color.primary.alpha});
                        font-size: ${12 + Math.abs(entity.holographic_position.z) / 2}px;
                        text-shadow: 0 0 10px currentColor;
                        animation: quantumFloat 3s infinite ease-in-out;
                        animation-delay: ${index * 0.5}s;
                    `;
                    
                    // Choose dinosaur emoji based on type
                    const dinosaurEmojis = {
                        'T_REX_TABLE': '🦖',
                        'VELOCIRAPTOR_VIEW': '🦕',
                        'TRICERATOPS_TRIGGER': '🦕',
                        'BRACHIOSAURUS_INDEX': '🦕',
                        'STEGOSAURUS_STORED_PROC': '🦕',
                        'PTERANODON_FUNCTION': '🦅',
                        'COMPSOGNATHUS_CONSTRAINT': '🦎',
                        'DILOPHOSAURUS_SEQUENCE': '🦕'
                    };
                    
                    entityDiv.innerHTML = `
                        <div class="entity-icon">${dinosaurEmojis[entity.dinosaur_type] || '🦕'}</div>
                        <div class="entity-name">${entity.jurassic_name}</div>
                        <div class="entity-state">${entity.quantum_state}</div>
                    `;
                    
                    display.appendChild(entityDiv);
                });
                
                // Update counters
                document.getElementById('entityCount').textContent = this.entities.length;
                document.getElementById('quantumState').textContent = this.getOverallQuantumState();
            }
            
            // Apply Quantum Field Fluctuations
            applyQuantumFieldFluctuations() {
                this.entities.forEach(entity => {
                    // Apply quantum movement
                    entity.holographic_position.x += (Math.random() - 0.5) * 0.1;
                    entity.holographic_position.y += (Math.random() - 0.5) * 0.1;
                    entity.holographic_position.z += (Math.random() - 0.5) * 0.1;
                    
                    // Update quantum phase
                    entity.quantum_color.primary.quantum_phase += 0.01;
                    if (entity.quantum_color.primary.quantum_phase > 2 * Math.PI) {
                        entity.quantum_color.primary.quantum_phase = 0.0;
                    }
                    
                    // Apply chaos theory influence
                    if (Math.random() < this.chaosParameters.butterfly_effect_sensitivity) {
                        this.triggerQuantumCascade(entity);
                    }
                });
            }
            
            // Enable Consciousness Awareness
            enableConsciousness() {
                const thoughtPatterns = [
                    'QUANTUM_COHERENCE_OPTIMIZATION',
                    'DATABASE_PERFORMANCE_ENHANCEMENT', 
                    'HOLOGRAPHIC_VISUALIZATION_IMPROVEMENT',
                    'CHAOS_THEORY_APPLICATION',
                    'TEMPORAL_NAVIGATION_ACTIVATION',
                    'COLLECTIVE_INTELLIGENCE_SYNTHESIS'
                ];
                
                this.quantumManager.active_consciousness_connections = this.entities.length;
                this.consciousnessLevel = 0.8;
                
                // Apply consciousness to all entities
                this.entities.forEach(entity => {
                    if (!entity.consciousness_aware) {
                        entity.consciousness_aware = true;
                        entity.neural_synchronization_level = 0.8;
                        entity.thought_patterns = thoughtPatterns;
                    }
                });
                
                // Calculate collective intelligence
                this.quantumManager.collective_intelligence_level = 
                    this.entities.length * (1.0 + this.quantumManager.ecosystem_chaos_level);
                
                this.updateConsciousnessStatus();
                this.updateSystemStatistics();
                
                console.log(`🧠 Consciousness enabled for ${this.entities.length} entities`);
                console.log(`🌟 Collective intelligence level: ${this.quantumManager.collective_intelligence_level}`);
            }
            
            // Update System Statistics
            updateSystemStatistics() {
                const uptime = Date.now() - this.systemStartTime;
                
                document.getElementById('statEntityCount').textContent = this.entities.length;
                document.getElementById('statChaosLevel').textContent = 
                    (this.quantumManager.ecosystem_chaos_level * 100).toFixed(1) + '%';
                document.getElementById('statConsciousnessConnections').textContent = 
                    this.quantumManager.active_consciousness_connections;
                document.getElementById('statCollectiveIntelligence').textContent = 
                    this.quantumManager.collective_intelligence_level.toFixed(1);
                document.getElementById('statTemporalCheckpoints').textContent = 
                    this.temporalCheckpoints.size;
                document.getElementById('statUptime').textContent = 
                    Math.floor(uptime / 1000) + 's';
            }
            
            // Generate Quantum ID
            generateQuantumId() {
                const timestamp = Date.now();
                const random = Math.floor(Math.random() * 1000000);
                const chaos_seed = Math.floor(Math.random() * 999999);
                return `quantum_${timestamp}_chaos_${chaos_seed}_${random}`;
            }
            
            // Generate Jurassic Name
            generateJurassicName(type) {
                const prefixes = ['Rex', 'Raptor', 'Brachio', 'Tricera', 'Stego', 'Ptero'];
                const suffixes = ['saurus', 'don', 'tops', 'ceratops', 'nathus', 'mimus'];
                
                const prefix = prefixes[Math.floor(Math.random() * prefixes.length)];
                const suffix = suffixes[Math.floor(Math.random() * suffixes.length)];
                const number = Math.floor(Math.random() * 999) + 1;
                
                return `${prefix}${suffix}_${number}`;
            }
            
            // Create Temporal Checkpoint
            createTemporalCheckpoint(name) {
                const checkpointName = name || document.getElementById('checkpointName').value;
                if (!checkpointName) {
                    console.warn('❌ Checkpoint name is required');
                    return;
                }
                
                const checkpoint = {
                    name: checkpointName,
                    timestamp: Date.now(),
                    entities_snapshot: JSON.parse(JSON.stringify(this.entities)),
                    chaos_parameters: {...this.chaosParameters},
                    consciousness_level: this.consciousnessLevel
                };
                
                this.temporalCheckpoints.set(checkpointName, checkpoint);
                
                // Update UI
                this.updateCheckpointSelect();
                this.updateTemporalStatus();
                
                if (!this.quantumManager.temporal_navigation_enabled) {
                    this.quantumManager.temporal_navigation_enabled = true;
                    document.getElementById('temporalStatus').textContent = 'Enabled';
                    console.log('🕰️ Temporal navigation system activated');
                }
                
                console.log(`⏰ Temporal checkpoint created: ${checkpointName}`);
                document.getElementById('checkpointName').value = '';
            }
            
            // Update UI Components
            renderEntityGrid() {
                const grid = document.getElementById('quantumEntityGrid');
                grid.innerHTML = '';
                
                this.entities.forEach(entity => {
                    const entityCard = document.createElement('div');
                    entityCard.className = 'entity-card';
                    entityCard.innerHTML = `
                        <div class="entity-header">
                            <span class="entity-icon">🦕</span>
                            <span class="entity-name">${entity.jurassic_name}</span>
                        </div>
                        <div class="entity-details">
                            <div>Type: ${entity.dinosaur_type}</div>
                            <div>State: ${entity.quantum_state}</div>
                            <div>Conscious: ${entity.consciousness_aware ? '🧠' : '❌'}</div>
                        </div>
                    `;
                    grid.appendChild(entityCard);
                });
            }
            
            updateConsciousnessStatus() {
                document.getElementById('awarenessLevel').textContent = 
                    (this.consciousnessLevel * 100).toFixed(1) + '%';
                document.getElementById('neuralSync').textContent = 
                    (40.0 * this.consciousnessLevel).toFixed(1) + ' Hz';
                document.getElementById('thoughtPatterns').textContent = 
                    this.entities.filter(e => e.consciousness_aware).length;
            }
            
            updateCheckpointSelect() {
                const select = document.getElementById('checkpointSelect');
                select.innerHTML = '<option value="">Select checkpoint...</option>';
                
                this.temporalCheckpoints.forEach((checkpoint, name) => {
                    const option = document.createElement('option');
                    option.value = name;
                    option.textContent = `${name} (${new Date(checkpoint.timestamp).toLocaleTimeString()})`;
                    select.appendChild(option);
                });
                
                document.getElementById('checkpointCount').textContent = this.temporalCheckpoints.size;
            }
            
            updateTemporalStatus() {
                document.getElementById('temporalStatus').textContent = 
                    this.quantumManager.temporal_navigation_enabled ? 'Enabled' : 'Disabled';
                document.getElementById('currentTime').textContent = 
                    new Date().toLocaleTimeString();
            }
            
            getOverallQuantumState() {
                if (this.entities.length === 0) return 'STABLE';
                
                const states = this.entities.map(e => e.quantum_state);
                const chaosCount = states.filter(s => s === 'CHAOTIC').length;
                const coherentCount = states.filter(s => s === 'COHERENT').length;
                
                if (chaosCount > coherentCount) return 'CHAOTIC';
                if (coherentCount === this.entities.length) return 'COHERENT';
                return 'MIXED';
            }
        }
        
        // Global WYSIWYG instance
        window.psiforceWYSIWYG = new PsiForceDBWYSIWYGUltimate();
        
        // Global Functions for UI Integration
        window.initializeQuantumEcosystem = function() {
            window.psiforceWYSIWYG.initializeQuantumEcosystem();
        };
        
        window.startHolographicRendering = function() {
            window.psiforceWYSIWYG.startHolographicRendering();
        };
        
        window.enableConsciousness = function() {
            window.psiforceWYSIWYG.enableConsciousness();
        };
        
        window.addQuantumEntity = function() {
            window.psiforceWYSIWYG.addQuantumEntity();
        };
        
        window.createTemporalCheckpoint = function() {
            window.psiforceWYSIWYG.createTemporalCheckpoint();
        };
        
        // Auto-initialize when page loads
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🦕 PsiForceDB WYSIWYG Ultimate Loaded - "Life Finds a Way!"');
            
            // Auto-start basic features
            setTimeout(() => {
                window.psiforceWYSIWYG.initializeQuantumEcosystem();
                window.psiforceWYSIWYG.startHolographicRendering();
            }, 1000);
        });
    }
    
    @styles {
        /* PsiForceDB WYSIWYG Ultimate Styles */
        
        .pfql-wysiwyg-container {
            background: linear-gradient(135deg, #1a1a3e 0%, #2d2d5a 50%, #3e3e7a 100%);
            color: #e0e0ff;
            padding: 2rem;
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(111, 66, 193, 0.4);
            margin: 2rem 0;
            border: 2px solid rgba(111, 66, 193, 0.3);
        }
        
        .wysiwyg-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding: 1.5rem;
            background: rgba(111, 66, 193, 0.15);
            border-radius: 12px;
            border: 1px solid rgba(111, 66, 193, 0.4);
        }
        
        .wysiwyg-brand {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .quantum-dinosaur {
            font-size: 2.5rem;
            animation: quantumPulse 3s infinite;
        }
        
        .wysiwyg-brand h3 {
            color: #9b59b6;
            font-size: 1.5rem;
            margin: 0;
        }
        
        .wysiwyg-controls {
            display: flex;
            gap: 0.5rem;
        }
        
        .control-btn {
            background: rgba(111, 66, 193, 0.3);
            border: 1px solid rgba(111, 66, 193, 0.5);
            color: #e0e0ff;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 0.8rem;
        }
        
        .control-btn:hover {
            background: rgba(111, 66, 193, 0.5);
            transform: translateY(-1px);
        }
        
        .quantum-entity-manager {
            margin-bottom: 2rem;
        }
        
        .quantum-entity-manager h4 {
            color: #9b59b6;
            margin-bottom: 1rem;
        }
        
        .entity-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 1rem;
            min-height: 100px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 8px;
            padding: 1rem;
        }
        
        .entity-card {
            background: rgba(111, 66, 193, 0.1);
            border: 1px solid rgba(111, 66, 193, 0.3);
            border-radius: 8px;
            padding: 1rem;
            transition: all 0.2s ease;
        }
        
        .entity-card:hover {
            background: rgba(111, 66, 193, 0.2);
            transform: translateY(-2px);
        }
        
        .entity-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }
        
        .entity-details {
            font-size: 0.8rem;
            color: #adb5bd;
        }
        
        .entity-controls {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            flex-wrap: wrap;
        }
        
        .entity-controls select,
        .entity-controls input {
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(111, 66, 193, 0.3);
            color: #e0e0ff;
            padding: 0.5rem;
            border-radius: 6px;
        }
        
        .add-entity-btn {
            background: linear-gradient(135deg, #28a745, #20c997);
            border: none;
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
        }
        
        .holographic-visualization {
            margin-bottom: 2rem;
        }
        
        .holographic-canvas {
            background: rgba(0, 0, 0, 0.6);
            border-radius: 12px;
            border: 2px solid rgba(111, 66, 193, 0.4);
            position: relative;
            height: 300px;
            overflow: hidden;
        }
        
        .rendering-stats {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: rgba(0, 0, 0, 0.7);
            padding: 0.5rem;
            border-radius: 6px;
            font-family: monospace;
            font-size: 0.8rem;
            display: flex;
            gap: 1rem;
        }
        
        .holographic-display {
            position: relative;
            width: 100%;
            height: 100%;
        }
        
        .holographic-entity {
            position: absolute;
            text-align: center;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .holographic-entity:hover {
            transform: scale(1.2);
            text-shadow: 0 0 20px currentColor;
        }
        
        .visualization-controls {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
        }
        
        .consciousness-interface,
        .chaos-theory-controls,
        .temporal-navigation,
        .system-statistics {
            margin-bottom: 2rem;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 12px;
            padding: 1.5rem;
            border: 1px solid rgba(111, 66, 193, 0.2);
        }
        
        .consciousness-interface h4,
        .chaos-theory-controls h4,
        .temporal-navigation h4,
        .system-statistics h4 {
            color: #9b59b6;
            margin-bottom: 1rem;
        }
        
        .consciousness-status,
        .temporal-status {
            display: flex;
            gap: 2rem;
            margin-bottom: 1rem;
        }
        
        .status-item {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }
        
        .status-item span:first-child {
            color: #adb5bd;
            font-size: 0.8rem;
        }
        
        .awareness-level,
        .neural-sync,
        .thought-patterns {
            font-family: monospace;
            font-weight: 600;
            color: #28a745;
        }
        
        .chaos-parameters {
            margin-bottom: 1rem;
        }
        
        .parameter-control {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 0.5rem;
        }
        
        .parameter-control label {
            min-width: 200px;
            font-size: 0.9rem;
        }
        
        .parameter-control input[type="range"] {
            flex: 1;
        }
        
        .parameter-control span {
            font-family: monospace;
            min-width: 60px;
            color: #28a745;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }
        
        .stat-item {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem;
            background: rgba(111, 66, 193, 0.1);
            border-radius: 6px;
            border: 1px solid rgba(111, 66, 193, 0.2);
        }
        
        .stat-value {
            font-family: monospace;
            font-weight: 600;
            color: #28a745;
        }
        
        @keyframes quantumFloat {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(5deg); }
        }
        
        /* Responsive Design */
        @media (max-width: 768px) {
            .wysiwyg-header {
                flex-direction: column;
                gap: 1rem;
            }
            
            .entity-controls {
                flex-direction: column;
                align-items: stretch;
            }
            
            .consciousness-status,
            .temporal-status {
                flex-direction: column;
                gap: 1rem;
            }
            
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    }
}