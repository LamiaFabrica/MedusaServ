<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Log Viewer - PFQL Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/portal-style.css">
</head>
<body>
    <div class="portal-header">
        <h1>📋 System Log Viewer</h1>
        <div class="portal-status" id="logStatus">
            <span class="status-indicator online"></span>
            Log Viewer: ACTIVE
        </div>
    </div>

    <div class="service-container">
        <div class="service-controls">
            <select class="service-input" id="logType">
                <option value="system">System Logs</option>
                <option value="application">Application Logs</option>
                <option value="security">Security Logs</option>
                <option value="database">Database Logs</option>
                <option value="web">Web Server Logs</option>
                <option value="error">Error Logs</option>
            </select>
            <select class="service-input" id="logLevel">
                <option value="all">All Levels</option>
                <option value="error">Error</option>
                <option value="warning">Warning</option>
                <option value="info">Info</option>
                <option value="debug">Debug</option>
            </select>
            <button class="service-btn" onclick="logViewer.loadLogs()">📋 Load Logs</button>
            <button class="service-btn" onclick="logViewer.clearLogs()">🗑️ Clear</button>
            <button class="service-btn" onclick="logViewer.exportLogs()">💾 Export</button>
            <button class="service-btn" onclick="logViewer.toggleRealTime()">📡 Real-Time</button>
        </div>

        <div class="log-filters">
            <input type="text" class="service-input" id="searchFilter" placeholder="Search logs...">
            <input type="date" class="service-input" id="dateFilter">
            <button class="service-btn" onclick="logViewer.applyFilters()">🔍 Filter</button>
        </div>

        <div class="log-stats" id="logStats">
            <div class="stat-card">
                <h4>Total Entries</h4>
                <div id="totalEntries">0</div>
            </div>
            <div class="stat-card">
                <h4>Errors</h4>
                <div id="errorCount" class="error">0</div>
            </div>
            <div class="stat-card">
                <h4>Warnings</h4>
                <div id="warningCount" class="warning">0</div>
            </div>
            <div class="stat-card">
                <h4>Info</h4>
                <div id="infoCount" class="info">0</div>
            </div>
        </div>

        <div class="log-viewer" id="logViewer">
            <div class="log-header">
                <span class="col-timestamp">Timestamp</span>
                <span class="col-level">Level</span>
                <span class="col-source">Source</span>
                <span class="col-message">Message</span>
            </div>
            <div class="log-content" id="logContent">
                <!-- Log entries will be populated here -->
            </div>
        </div>

        <div class="service-output" id="logOutput">
            <div>[LOG] System log viewer initialized</div>
            <div>[LOG] Connected to PsiForceDB on 172.236.23.54</div>
            <div>[LOG] Ready to view system logs...</div>
        </div>
    </div>

    <script>
        class SystemLogViewer {
            constructor() {
                this.logs = [];
                this.filteredLogs = [];
                this.realTimeEnabled = false;
                this.realTimeInterval = null;
                this.logStats = {
                    total: 0,
                    error: 0,
                    warning: 0,
                    info: 0
                };
                this.init();
            }

            async init() {
                await this.connectToPsiForceDB();
                await this.loadLogs();
                this.setupEventListeners();
            }

            async connectToPsiForceDB() {
                try {
                    const response = await fetch('/api/pfql-routes/system/logs/status', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            server: '172.236.23.54',
                            database: 'psiforcedb_system'
                        })
                    });
                    
                    if (response.ok) {
                        this.logOutput('[LOG] Connected to PsiForceDB log management system');
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Connection failed: ${error.message}`);
                }
            }

            async loadLogs() {
                const logType = document.getElementById('logType').value;
                const logLevel = document.getElementById('logLevel').value;
                
                this.logOutput(`[LOG] Loading ${logType} logs (level: ${logLevel})...`);
                
                try {
                    const response = await fetch('/api/pfql-routes/system/logs/fetch', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://system:logs:fetch',
                            server: '172.236.23.54',
                            logType: logType,
                            logLevel: logLevel,
                            limit: 1000
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        this.logs = result.logs || this.generateSampleLogs();
                        this.filteredLogs = [...this.logs];
                        this.displayLogs();
                        this.updateLogStats();
                        this.logOutput(`[LOG] Loaded ${this.logs.length} log entries`);
                    } else {
                        this.logs = this.generateSampleLogs();
                        this.filteredLogs = [...this.logs];
                        this.displayLogs();
                        this.updateLogStats();
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Failed to load logs: ${error.message}`);
                    this.logs = this.generateSampleLogs();
                    this.filteredLogs = [...this.logs];
                    this.displayLogs();
                    this.updateLogStats();
                }
            }

            clearLogs() {
                document.getElementById('logContent').innerHTML = '';
                this.logs = [];
                this.filteredLogs = [];
                this.updateLogStats();
                this.logOutput('[LOG] Log viewer cleared');
            }

            async exportLogs() {
                this.logOutput('[LOG] Exporting logs...');
                try {
                    const logData = this.filteredLogs.map(log => 
                        `${log.timestamp} [${log.level.toUpperCase()}] ${log.source}: ${log.message}`
                    ).join('\n');
                    
                    const blob = new Blob([logData], { type: 'text/plain' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `system-logs-${new Date().toISOString().split('T')[0]}.txt`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                    
                    this.logOutput('[LOG] Logs exported successfully');
                } catch (error) {
                    this.logOutput(`[ERROR] Export failed: ${error.message}`);
                }
            }

            toggleRealTime() {
                if (this.realTimeEnabled) {
                    this.stopRealTime();
                } else {
                    this.startRealTime();
                }
            }

            startRealTime() {
                this.realTimeEnabled = true;
                this.logOutput('[LOG] Real-time monitoring started');
                document.querySelector('button[onclick="logViewer.toggleRealTime()"]').textContent = '⏸️ Pause';
                document.getElementById('logStatus').innerHTML = 
                    '<span class="status-indicator online pulse"></span>Log Viewer: REAL-TIME';
                
                this.realTimeInterval = setInterval(async () => {
                    await this.loadLatestLogs();
                }, 2000);
            }

            stopRealTime() {
                this.realTimeEnabled = false;
                if (this.realTimeInterval) {
                    clearInterval(this.realTimeInterval);
                    this.realTimeInterval = null;
                }
                this.logOutput('[LOG] Real-time monitoring stopped');
                document.querySelector('button[onclick="logViewer.toggleRealTime()"]').textContent = '📡 Real-Time';
                document.getElementById('logStatus').innerHTML = 
                    '<span class="status-indicator online"></span>Log Viewer: ACTIVE';
            }

            async loadLatestLogs() {
                try {
                    const response = await fetch('/api/pfql-routes/system/logs/latest', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://system:logs:latest',
                            server: '172.236.23.54',
                            since: this.logs.length > 0 ? this.logs[0].timestamp : null
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        if (result.logs && result.logs.length > 0) {
                            this.logs = [...result.logs, ...this.logs];
                            this.applyFilters();
                            this.updateLogStats();
                        }
                    }
                } catch (error) {
                    // Add simulated new log entry for demo
                    if (Math.random() > 0.7) {
                        const newLog = this.generateRandomLogEntry();
                        this.logs.unshift(newLog);
                        this.applyFilters();
                        this.updateLogStats();
                    }
                }
            }

            applyFilters() {
                const searchTerm = document.getElementById('searchFilter').value.toLowerCase();
                const dateFilter = document.getElementById('dateFilter').value;
                const logLevel = document.getElementById('logLevel').value;
                
                this.filteredLogs = this.logs.filter(log => {
                    const matchesSearch = !searchTerm || 
                        log.message.toLowerCase().includes(searchTerm) ||
                        log.source.toLowerCase().includes(searchTerm);
                    
                    const matchesDate = !dateFilter || 
                        log.timestamp.startsWith(dateFilter);
                    
                    const matchesLevel = logLevel === 'all' || 
                        log.level === logLevel;
                    
                    return matchesSearch && matchesDate && matchesLevel;
                });
                
                this.displayLogs();
                this.updateLogStats();
                this.logOutput(`[LOG] Applied filters: ${this.filteredLogs.length} entries shown`);
            }

            displayLogs() {
                const content = document.getElementById('logContent');
                content.innerHTML = this.filteredLogs.map(log => `
                    <div class="log-entry ${log.level}">
                        <span class="col-timestamp">${log.timestamp}</span>
                        <span class="col-level ${log.level}">${log.level.toUpperCase()}</span>
                        <span class="col-source">${log.source}</span>
                        <span class="col-message">${log.message}</span>
                    </div>
                `).join('');
            }

            updateLogStats() {
                this.logStats = {
                    total: this.filteredLogs.length,
                    error: this.filteredLogs.filter(log => log.level === 'error').length,
                    warning: this.filteredLogs.filter(log => log.level === 'warning').length,
                    info: this.filteredLogs.filter(log => log.level === 'info').length
                };
                
                document.getElementById('totalEntries').textContent = this.logStats.total;
                document.getElementById('errorCount').textContent = this.logStats.error;
                document.getElementById('warningCount').textContent = this.logStats.warning;
                document.getElementById('infoCount').textContent = this.logStats.info;
            }

            generateSampleLogs() {
                const logs = [];
                const sources = ['psiforcedb', 'nginx', 'medusa-ce', 'pfql-processor', 'system', 'security'];
                const levels = ['info', 'warning', 'error'];
                
                for (let i = 0; i < 50; i++) {
                    logs.push({
                        timestamp: new Date(Date.now() - Math.random() * 86400000).toISOString(),
                        level: levels[Math.floor(Math.random() * levels.length)],
                        source: sources[Math.floor(Math.random() * sources.length)],
                        message: this.generateRandomMessage()
                    });
                }
                
                return logs.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
            }

            generateRandomLogEntry() {
                const sources = ['psiforcedb', 'nginx', 'medusa-ce', 'pfql-processor'];
                const levels = ['info', 'warning', 'error'];
                
                return {
                    timestamp: new Date().toISOString(),
                    level: levels[Math.floor(Math.random() * levels.length)],
                    source: sources[Math.floor(Math.random() * sources.length)],
                    message: this.generateRandomMessage()
                };
            }

            generateRandomMessage() {
                const messages = [
                    'Database connection established successfully',
                    'Query executed in 0.023ms',
                    'User authentication successful',
                    'System backup completed',
                    'Warning: High memory usage detected',
                    'Error: Connection timeout to external service',
                    'PFQL command processed successfully',
                    'Security scan completed - no threats found',
                    'Performance optimization task completed',
                    'System health check passed'
                ];
                return messages[Math.floor(Math.random() * messages.length)];
            }

            setupEventListeners() {
                document.getElementById('searchFilter').addEventListener('keyup', (e) => {
                    if (e.key === 'Enter') {
                        this.applyFilters();
                    }
                });
                
                document.getElementById('dateFilter').addEventListener('change', () => {
                    this.applyFilters();
                });
            }

            logOutput(message) {
                const output = document.getElementById('logOutput');
                const timestamp = new Date().toLocaleTimeString();
                output.innerHTML += `<div>[${timestamp}] ${message}</div>`;
                output.scrollTop = output.scrollHeight;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            window.logViewer = new SystemLogViewer();
        });
    </script>
    
    <style>
        .log-filters {
            display: flex;
            gap: 10px;
            margin: 15px 0;
            flex-wrap: wrap;
        }
        .log-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 10px;
            margin: 15px 0;
        }
        .stat-card {
            background: rgba(100, 181, 246, 0.1);
            border: 1px solid #64B5F6;
            border-radius: 4px;
            padding: 10px;
            text-align: center;
        }
        .stat-card h4 {
            margin: 0 0 5px 0;
            font-size: 14px;
        }
        .stat-card div {
            font-size: 20px;
            font-weight: bold;
        }
        .stat-card .error {
            color: #F44336;
        }
        .stat-card .warning {
            color: #FF9800;
        }
        .stat-card .info {
            color: #4CAF50;
        }
        .log-viewer {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #64B5F6;
            border-radius: 6px;
            margin: 15px 0;
            max-height: 600px;
            overflow: hidden;
        }
        .log-header {
            background: rgba(100, 181, 246, 0.2);
            padding: 10px;
            display: grid;
            grid-template-columns: 180px 80px 120px 1fr;
            gap: 10px;
            font-weight: bold;
            border-bottom: 1px solid #64B5F6;
        }
        .log-content {
            max-height: 500px;
            overflow-y: auto;
        }
        .log-entry {
            padding: 8px 10px;
            display: grid;
            grid-template-columns: 180px 80px 120px 1fr;
            gap: 10px;
            border-bottom: 1px solid rgba(100, 181, 246, 0.1);
            font-family: monospace;
            font-size: 12px;
        }
        .log-entry:hover {
            background: rgba(255, 255, 255, 0.05);
        }
        .log-entry.error {
            background: rgba(244, 67, 54, 0.1);
            border-left: 3px solid #F44336;
        }
        .log-entry.warning {
            background: rgba(255, 152, 0, 0.1);
            border-left: 3px solid #FF9800;
        }
        .log-entry.info {
            background: rgba(76, 175, 80, 0.05);
            border-left: 3px solid #4CAF50;
        }
        .col-level.error {
            color: #F44336;
            font-weight: bold;
        }
        .col-level.warning {
            color: #FF9800;
            font-weight: bold;
        }
        .col-level.info {
            color: #4CAF50;
            font-weight: bold;
        }
        .col-timestamp {
            color: #999;
        }
        .col-source {
            color: #64B5F6;
            font-weight: bold;
        }
        .pulse {
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }
    </style>
</body>
</html>