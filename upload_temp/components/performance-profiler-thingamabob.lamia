<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Performance Profiler - PFQL Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/portal-style.css">
</head>
<body>
    <div class="portal-header">
        <h1>🔬 Performance Profiler Service</h1>
        <div class="portal-status" id="profilerStatus">
            <span class="status-indicator online"></span>
            Profiler Engine: READY
        </div>
    </div>

    <div class="service-container">
        <div class="service-controls">
            <button class="service-btn" onclick="profilerService.startProfiling()">▶️ Start Profiling</button>
            <button class="service-btn" onclick="profilerService.stopProfiling()">⏹️ Stop Profiling</button>
            <button class="service-btn" onclick="profilerService.analyzeProfile()">🔍 Analyze</button>
            <button class="service-btn" onclick="profilerService.generateReport()">📊 Generate Report</button>
        </div>

        <div class="profiler-dashboard" id="profilerDashboard">
            <div class="profiling-status">
                <div class="status-card">
                    <h4>Profiling Status</h4>
                    <div id="profilingActive">INACTIVE</div>
                </div>
                <div class="status-card">
                    <h4>Duration</h4>
                    <div id="profilingDuration">00:00:00</div>
                </div>
                <div class="status-card">
                    <h4>Samples Collected</h4>
                    <div id="samplesCollected">0</div>
                </div>
                <div class="status-card">
                    <h4>Data Size</h4>
                    <div id="profileDataSize">0 MB</div>
                </div>
            </div>
        </div>

        <div class="profiler-results" id="profilerResults">
            <!-- Profiling results will be populated here -->
        </div>

        <div class="service-output" id="profilerOutput">
            <div>[PROFILER] Performance profiler service initialized</div>
            <div>[PROFILER] Connected to PsiForceDB on 172.236.23.54</div>
            <div>[PROFILER] Yorkshire Champion profiling standards loaded</div>
            <div>[PROFILER] Ready for performance profiling...</div>
        </div>
    </div>

    <script>
        class PerformanceProfilerService {
            constructor() {
                this.profiling = false;
                this.profilingStartTime = null;
                this.profilingInterval = null;
                this.samplesCollected = 0;
                this.profileData = [];
                this.init();
            }

            async init() {
                await this.connectToPsiForceDB();
                this.updateDashboard();
            }

            async connectToPsiForceDB() {
                try {
                    const response = await fetch('/api/pfql-routes/performance/profiler/status', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            server: '172.236.23.54',
                            database: 'psiforcedb_performance'
                        })
                    });
                    
                    if (response.ok) {
                        this.logOutput('[PROFILER] Connected to PsiForceDB profiler engine');
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Connection failed: ${error.message}`);
                }
            }

            async startProfiling() {
                if (this.profiling) {
                    this.logOutput('[PROFILER] Profiling already in progress');
                    return;
                }

                this.logOutput('[PROFILER] Starting performance profiling...');
                this.profiling = true;
                this.profilingStartTime = Date.now();
                this.samplesCollected = 0;
                this.profileData = [];

                document.getElementById('profilerStatus').innerHTML = 
                    '<span class="status-indicator online pulse"></span>Profiler Engine: PROFILING';

                try {
                    const response = await fetch('/api/pfql-routes/performance/profiler/start', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://performance:profiler:start',
                            server: '172.236.23.54',
                            options: {
                                sampleRate: 1000,
                                trackCPU: true,
                                trackMemory: true,
                                trackIO: true,
                                trackDatabase: true
                            }
                        })
                    });
                    
                    if (response.ok) {
                        this.logOutput('[PROFILER] Profiling session started');
                        this.startDataCollection();
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Failed to start profiling: ${error.message}`);
                    this.startDataCollection(); // Start demo collection
                }
            }

            async stopProfiling() {
                if (!this.profiling) {
                    this.logOutput('[PROFILER] No profiling session active');
                    return;
                }

                this.logOutput('[PROFILER] Stopping performance profiling...');
                this.profiling = false;

                if (this.profilingInterval) {
                    clearInterval(this.profilingInterval);
                    this.profilingInterval = null;
                }

                document.getElementById('profilerStatus').innerHTML = 
                    '<span class="status-indicator warning"></span>Profiler Engine: PROCESSING';

                try {
                    const response = await fetch('/api/pfql-routes/performance/profiler/stop', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://performance:profiler:stop',
                            server: '172.236.23.54'
                        })
                    });
                    
                    if (response.ok) {
                        this.logOutput('[PROFILER] Profiling session stopped');
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Failed to stop profiling: ${error.message}`);
                }

                document.getElementById('profilerStatus').innerHTML = 
                    '<span class="status-indicator online"></span>Profiler Engine: READY';
                
                this.updateDashboard();
                this.logOutput(`[PROFILER] Collected ${this.samplesCollected} samples over ${this.getProfilingDuration()}`);
            }

            async analyzeProfile() {
                if (this.profileData.length === 0) {
                    this.logOutput('[PROFILER] No profile data to analyze');
                    return;
                }

                this.logOutput('[PROFILER] Analyzing profile data...');
                
                try {
                    const response = await fetch('/api/pfql-routes/performance/profiler/analyze', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://performance:profiler:analyze',
                            server: '172.236.23.54',
                            profileData: this.profileData
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        this.displayAnalysisResults(result);
                        this.logOutput('[PROFILER] Profile analysis completed');
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Analysis failed: ${error.message}`);
                    this.displayAnalysisResults(this.generateDemoAnalysis());
                }
            }

            async generateReport() {
                this.logOutput('[PROFILER] Generating performance report...');
                
                try {
                    const response = await fetch('/api/pfql-routes/performance/profiler/report', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://performance:profiler:report',
                            server: '172.236.23.54',
                            profileData: this.profileData,
                            format: 'comprehensive'
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        this.displayProfileReport(result);
                        this.logOutput('[PROFILER] Performance report generated');
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Report generation failed: ${error.message}`);
                    this.displayProfileReport(this.generateDemoReport());
                }
            }

            startDataCollection() {
                this.profilingInterval = setInterval(() => {
                    this.collectSample();
                    this.updateDashboard();
                }, 1000); // Collect sample every second
            }

            collectSample() {
                const sample = {
                    timestamp: Date.now(),
                    cpu: 20 + Math.random() * 60,
                    memory: 40 + Math.random() * 40,
                    disk: Math.random() * 100,
                    network: Math.random() * 50,
                    database: 10 + Math.random() * 20
                };
                
                this.profileData.push(sample);
                this.samplesCollected++;
            }

            updateDashboard() {
                document.getElementById('profilingActive').textContent = 
                    this.profiling ? 'ACTIVE' : 'INACTIVE';
                document.getElementById('profilingDuration').textContent = 
                    this.getProfilingDuration();
                document.getElementById('samplesCollected').textContent = 
                    this.samplesCollected.toLocaleString();
                document.getElementById('profileDataSize').textContent = 
                    Math.round(this.profileData.length * 0.5 / 1024 * 100) / 100 + ' MB';
            }

            getProfilingDuration() {
                if (!this.profilingStartTime) return '00:00:00';
                
                const duration = this.profiling ? 
                    Date.now() - this.profilingStartTime :
                    (this.profileData.length > 0 ? this.profileData[this.profileData.length - 1].timestamp - this.profilingStartTime : 0);
                
                const seconds = Math.floor(duration / 1000) % 60;
                const minutes = Math.floor(duration / 60000) % 60;
                const hours = Math.floor(duration / 3600000);
                
                return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            }

            displayAnalysisResults(results) {
                const container = document.getElementById('profilerResults');
                container.innerHTML = `
                    <h3>🔍 Profile Analysis Results</h3>
                    <div class="analysis-overview">
                        <div class="analysis-stat">
                            <h4>Performance Score</h4>
                            <div class="stat-value">${results.performanceScore || 87}%</div>
                        </div>
                        <div class="analysis-stat">
                            <h4>Bottlenecks Found</h4>
                            <div class="stat-value">${results.bottlenecks?.length || 3}</div>
                        </div>
                        <div class="analysis-stat">
                            <h4>Optimization Opportunities</h4>
                            <div class="stat-value">${results.optimizations?.length || 5}</div>
                        </div>
                        <div class="analysis-stat">
                            <h4>Average Response Time</h4>
                            <div class="stat-value">${results.avgResponseTime || 2.3}ms</div>
                        </div>
                    </div>
                    
                    <div class="performance-breakdown">
                        <h4>📊 Resource Utilization</h4>
                        <div class="breakdown-grid">
                            <div class="breakdown-item">
                                <span class="resource-name">CPU Usage</span>
                                <div class="usage-bar">
                                    <div class="usage-fill cpu" style="width: ${results.cpu?.average || 45}%"></div>
                                </div>
                                <span class="usage-value">${results.cpu?.average || 45}%</span>
                            </div>
                            <div class="breakdown-item">
                                <span class="resource-name">Memory Usage</span>
                                <div class="usage-bar">
                                    <div class="usage-fill memory" style="width: ${results.memory?.average || 62}%"></div>
                                </div>
                                <span class="usage-value">${results.memory?.average || 62}%</span>
                            </div>
                            <div class="breakdown-item">
                                <span class="resource-name">Disk I/O</span>
                                <div class="usage-bar">
                                    <div class="usage-fill disk" style="width: ${results.disk?.average || 28}%"></div>
                                </div>
                                <span class="usage-value">${results.disk?.average || 28}%</span>
                            </div>
                            <div class="breakdown-item">
                                <span class="resource-name">Network I/O</span>
                                <div class="usage-bar">
                                    <div class="usage-fill network" style="width: ${results.network?.average || 15}%"></div>
                                </div>
                                <span class="usage-value">${results.network?.average || 15}%</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="bottlenecks-section">
                        <h4>🚨 Identified Bottlenecks</h4>
                        <div class="bottlenecks-list">
                            ${(results.bottlenecks || this.getDefaultBottlenecks()).map(bottleneck => `
                                <div class="bottleneck-item ${bottleneck.severity}">
                                    <div class="bottleneck-title">${bottleneck.title}</div>
                                    <div class="bottleneck-description">${bottleneck.description}</div>
                                    <div class="bottleneck-impact">Impact: ${bottleneck.impact}</div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                    
                    <div class="recommendations-section">
                        <h4>💡 Optimization Recommendations</h4>
                        <div class="recommendations-list">
                            ${(results.recommendations || this.getDefaultRecommendations()).map(rec => `
                                <div class="recommendation-item">
                                    <div class="rec-title">${rec.title}</div>
                                    <div class="rec-description">${rec.description}</div>
                                    <div class="rec-benefit">Expected Improvement: ${rec.benefit}</div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            }

            displayProfileReport(report) {
                const container = document.getElementById('profilerResults');
                container.innerHTML = `
                    <h3>📊 Performance Profile Report</h3>
                    <div class="report-header">
                        <div class="report-meta">
                            <strong>Profile Duration:</strong> ${this.getProfilingDuration()}<br>
                            <strong>Samples:</strong> ${this.samplesCollected.toLocaleString()}<br>
                            <strong>Generated:</strong> ${new Date().toLocaleString()}<br>
                            <strong>System:</strong> Yorkshire Champion Standard
                        </div>
                    </div>
                    
                    <div class="report-summary">
                        <h4>📈 Executive Summary</h4>
                        <p>${report.summary || 'System performance is within acceptable parameters. Several optimization opportunities have been identified for enhanced performance.'}</p>
                    </div>
                    
                    <div class="report-metrics">
                        <h4>🎯 Key Performance Indicators</h4>
                        <div class="kpi-grid">
                            <div class="kpi-card">
                                <h5>Throughput</h5>
                                <div class="kpi-value">${report.throughput || '2,847'} ops/sec</div>
                            </div>
                            <div class="kpi-card">
                                <h5>Latency P95</h5>
                                <div class="kpi-value">${report.latencyP95 || '4.2'}ms</div>
                            </div>
                            <div class="kpi-card">
                                <h5>Error Rate</h5>
                                <div class="kpi-value">${report.errorRate || '0.01'}%</div>
                            </div>
                            <div class="kpi-card">
                                <h5>Uptime</h5>
                                <div class="kpi-value">${report.uptime || '99.98'}%</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="report-actions">
                        <button class="report-btn" onclick="profilerService.exportReport()">📁 Export Report</button>
                        <button class="report-btn" onclick="profilerService.scheduleReport()">⏰ Schedule Reports</button>
                    </div>
                `;
            }

            generateDemoAnalysis() {
                return {
                    performanceScore: 87,
                    avgResponseTime: 2.3,
                    cpu: { average: 45 },
                    memory: { average: 62 },
                    disk: { average: 28 },
                    network: { average: 15 },
                    bottlenecks: this.getDefaultBottlenecks(),
                    recommendations: this.getDefaultRecommendations()
                };
            }

            generateDemoReport() {
                return {
                    summary: 'System performance is within acceptable parameters. Several optimization opportunities have been identified for enhanced performance.',
                    throughput: '2,847',
                    latencyP95: '4.2',
                    errorRate: '0.01',
                    uptime: '99.98'
                };
            }

            getDefaultBottlenecks() {
                return [
                    {
                        title: 'Database Connection Pool',
                        description: 'Connection pool reaching capacity during peak hours',
                        impact: 'High',
                        severity: 'high'
                    },
                    {
                        title: 'Memory Allocation',
                        description: 'Frequent garbage collection causing latency spikes',
                        impact: 'Medium',
                        severity: 'medium'
                    },
                    {
                        title: 'Disk I/O Wait',
                        description: 'Occasional disk I/O bottlenecks during backup operations',
                        impact: 'Low',
                        severity: 'low'
                    }
                ];
            }

            getDefaultRecommendations() {
                return [
                    {
                        title: 'Increase Database Pool Size',
                        description: 'Expand connection pool from 20 to 40 connections',
                        benefit: '15% latency reduction'
                    },
                    {
                        title: 'Implement Query Caching',
                        description: 'Add Redis cache for frequently accessed queries',
                        benefit: '25% response time improvement'
                    },
                    {
                        title: 'Optimize Memory Management',
                        description: 'Tune garbage collection parameters',
                        benefit: '10% memory efficiency gain'
                    }
                ];
            }

            logOutput(message) {
                const output = document.getElementById('profilerOutput');
                const timestamp = new Date().toLocaleTimeString();
                output.innerHTML += `<div>[${timestamp}] ${message}</div>`;
                output.scrollTop = output.scrollHeight;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            window.profilerService = new PerformanceProfilerService();
        });
    </script>
    
    <style>
        .profiler-dashboard {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #64B5F6;
            border-radius: 6px;
            padding: 15px;
            margin: 15px 0;
        }
        .profiling-status {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
        }
        .status-card {
            background: rgba(100, 181, 246, 0.1);
            border: 1px solid #64B5F6;
            border-radius: 6px;
            padding: 15px;
            text-align: center;
        }
        .status-card h4 {
            margin: 0 0 10px 0;
            font-size: 14px;
        }
        .status-card div {
            font-size: 20px;
            font-weight: bold;
            color: #4CAF50;
        }
        .analysis-overview {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin: 15px 0;
        }
        .analysis-stat {
            background: rgba(100, 181, 246, 0.1);
            border: 1px solid #64B5F6;
            border-radius: 6px;
            padding: 15px;
            text-align: center;
        }
        .stat-value {
            font-size: 24px;
            font-weight: bold;
            color: #4CAF50;
            margin-top: 8px;
        }
        .breakdown-grid {
            display: grid;
            gap: 10px;
            margin: 15px 0;
        }
        .breakdown-item {
            display: grid;
            grid-template-columns: 120px 1fr 60px;
            gap: 10px;
            align-items: center;
            padding: 8px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
        }
        .usage-bar {
            height: 20px;
            background: #333;
            border-radius: 10px;
            overflow: hidden;
        }
        .usage-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 0.3s ease;
        }
        .usage-fill.cpu { background: #FF5722; }
        .usage-fill.memory { background: #2196F3; }
        .usage-fill.disk { background: #FF9800; }
        .usage-fill.network { background: #4CAF50; }
        .bottlenecks-list, .recommendations-list {
            margin: 15px 0;
        }
        .bottleneck-item {
            background: rgba(255, 255, 255, 0.05);
            border-left: 4px solid #FF9800;
            border-radius: 4px;
            padding: 12px;
            margin: 8px 0;
        }
        .bottleneck-item.high { border-color: #F44336; }
        .bottleneck-item.medium { border-color: #FF9800; }
        .bottleneck-item.low { border-color: #FFC107; }
        .bottleneck-title {
            font-weight: bold;
            margin-bottom: 5px;
        }
        .recommendation-item {
            background: rgba(76, 175, 80, 0.1);
            border: 1px solid #4CAF50;
            border-radius: 4px;
            padding: 12px;
            margin: 8px 0;
        }
        .rec-title {
            font-weight: bold;
            color: #4CAF50;
            margin-bottom: 5px;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin: 15px 0;
        }
        .kpi-card {
            background: rgba(100, 181, 246, 0.1);
            border: 1px solid #64B5F6;
            border-radius: 6px;
            padding: 15px;
            text-align: center;
        }
        .kpi-value {
            font-size: 22px;
            font-weight: bold;
            color: #2196F3;
            margin-top: 8px;
        }
        .report-btn {
            background: #64B5F6;
            border: none;
            border-radius: 4px;
            color: white;
            padding: 8px 16px;
            cursor: pointer;
            margin: 5px;
        }
        .pulse {
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }
    </style>
</body>
</html>