/*
 * Update Manager Thingamabob - v0.4.0
 * Yorkshire Champion Standards - Automatic Update Management System
 * 
 * Features:
 * - Automatic update detection
 * - Staged rollout support
 * - Rollback capabilities
 * - Update scheduling
 * - Dependency resolution
 * - Purple Pages auto-documentation
 * 
 * © 2025 The Medusa Project | Roylepython | D Hargreaves
 */

@component "update_manager_thingamabob" {
    @version "0.4.0"
    @theme "enterprise_update_manager"
    @security_level "quantum_resistant"
    @encryption "AES_256_PQC"
    @session_management "JWT_PsiForceDB"
    @auto_update_enabled true
    @purple_pages_integration true
    
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Update Manager v0.4.0 - Yorkshire Champion Standards</title>
        <style>
            :root {
                --yorkshire-gold: #FFD700;
                --yorkshire-green: #228B22;
                --medusa-purple: #6B46C1;
                --quantum-blue: #00D4FF;
                --success: #10B981;
                --warning: #F59E0B;
                --danger: #EF4444;
                --update-blue: #3B82F6;
            }

            .update-manager-container {
                background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
                color: white;
                padding: 30px;
                border-radius: 12px;
                font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;
            }

            .cuppa-ascii-container {
                background: #000;
                border: 3px solid var(--yorkshire-gold);
                border-radius: 15px;
                padding: 20px;
                margin: 20px 0;
                font-family: 'Courier New', monospace;
                font-size: 12px;
                color: var(--yorkshire-gold);
                text-align: center;
                position: relative;
                overflow: hidden;
                display: none;
            }

            .cuppa-ascii-container.show {
                display: block;
                animation: slideDown 0.5s ease-out;
            }

            @keyframes slideDown {
                from {
                    opacity: 0;
                    transform: translateY(-20px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .cuppa-ascii {
                line-height: 1.2;
                white-space: pre;
                animation: textGlow 2s ease-in-out infinite alternate;
            }

            @keyframes textGlow {
                from {
                    text-shadow: 0 0 5px var(--yorkshire-gold);
                }
                to {
                    text-shadow: 0 0 15px var(--yorkshire-gold), 0 0 25px rgba(255, 215, 0, 0.5);
                }
            }

            .progress-container {
                margin: 30px 0;
                background: rgba(0, 0, 0, 0.3);
                border: 2px solid var(--yorkshire-gold);
                border-radius: 10px;
                padding: 20px;
                display: none;
            }

            .progress-container.show {
                display: block;
                animation: fadeIn 0.5s ease-out;
            }

            @keyframes fadeIn {
                from { opacity: 0; }
                to { opacity: 1; }
            }

            .progress-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px;
            }

            .progress-title {
                color: var(--yorkshire-gold);
                font-size: 18px;
                font-weight: bold;
            }

            .progress-percentage {
                color: var(--yorkshire-gold);
                font-size: 24px;
                font-weight: bold;
            }

            .progress-bar {
                width: 100%;
                height: 25px;
                background: rgba(255, 255, 255, 0.1);
                border-radius: 12px;
                overflow: hidden;
                position: relative;
                border: 1px solid var(--yorkshire-gold);
            }

            .progress-fill {
                height: 100%;
                background: linear-gradient(90deg, var(--yorkshire-gold), var(--update-blue), var(--yorkshire-gold));
                background-size: 200% 100%;
                border-radius: 12px;
                transition: width 0.3s ease;
                animation: progressShine 2s linear infinite;
                position: relative;
            }

            @keyframes progressShine {
                0% { background-position: -200% 0; }
                100% { background-position: 200% 0; }
            }

            .progress-fill::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
                animation: progressGlow 1.5s ease-in-out infinite;
            }

            @keyframes progressGlow {
                0%, 100% { opacity: 0; }
                50% { opacity: 1; }
            }

            .progress-steps {
                margin-top: 20px;
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
                gap: 10px;
            }

            .progress-step {
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid #444;
                border-radius: 8px;
                padding: 10px;
                text-align: center;
                font-size: 14px;
                color: #ccc;
                transition: all 0.3s ease;
            }

            .progress-step.active {
                background: var(--yorkshire-gold);
                color: #000;
                font-weight: bold;
                animation: stepPulse 1s infinite;
            }

            .progress-step.completed {
                background: var(--yorkshire-green);
                color: white;
                border-color: var(--yorkshire-green);
            }

            @keyframes stepPulse {
                0%, 100% { transform: scale(1); }
                50% { transform: scale(1.05); }
            }

            .database-install-btn {
                background: linear-gradient(135deg, var(--yorkshire-gold), var(--update-blue));
                color: #000;
                border: none;
                padding: 15px 30px;
                border-radius: 8px;
                font-size: 16px;
                font-weight: bold;
                cursor: pointer;
                transition: all 0.3s ease;
                margin: 20px 0;
            }

            .database-install-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(255, 215, 0, 0.4);
            }

            .database-install-btn:disabled {
                background: #666;
                cursor: not-allowed;
                transform: none;
                box-shadow: none;
            }

            .manager-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 30px;
                padding-bottom: 20px;
                border-bottom: 2px solid var(--yorkshire-gold);
            }

            .manager-title {
                font-size: 32px;
                font-weight: bold;
                background: linear-gradient(90deg, var(--yorkshire-gold), var(--update-blue));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .update-summary {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 20px;
                margin-bottom: 30px;
            }

            .summary-card {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 215, 0, 0.2);
                border-radius: 12px;
                padding: 20px;
                text-align: center;
                transition: all 0.3s ease;
            }

            .summary-card:hover {
                transform: translateY(-3px);
                border-color: var(--yorkshire-gold);
                box-shadow: 0 10px 20px rgba(255, 215, 0, 0.1);
            }

            .summary-icon {
                font-size: 32px;
                margin-bottom: 10px;
            }

            .summary-value {
                font-size: 28px;
                font-weight: bold;
                color: var(--yorkshire-gold);
                margin-bottom: 5px;
            }

            .summary-label {
                font-size: 14px;
                color: rgba(255, 255, 255, 0.7);
            }

            .update-alert {
                background: linear-gradient(135deg, var(--warning), var(--yorkshire-gold));
                border-radius: 12px;
                padding: 20px;
                margin-bottom: 30px;
                display: flex;
                align-items: center;
                gap: 20px;
                color: black;
                animation: pulse-alert 2s infinite;
            }

            @keyframes pulse-alert {
                0%, 100% { opacity: 1; }
                50% { opacity: 0.9; }
            }

            .alert-icon {
                font-size: 48px;
                animation: bounce 2s infinite;
            }

            @keyframes bounce {
                0%, 100% { transform: translateY(0); }
                50% { transform: translateY(-5px); }
            }

            .alert-content {
                flex: 1;
            }

            .alert-title {
                font-size: 20px;
                font-weight: bold;
                margin-bottom: 5px;
            }

            .alert-description {
                font-size: 14px;
            }

            .alert-actions {
                display: flex;
                gap: 10px;
            }

            .update-button {
                background: black;
                color: var(--yorkshire-gold);
                border: none;
                border-radius: 8px;
                padding: 12px 24px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.3s ease;
            }

            .update-button:hover {
                transform: scale(1.05);
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
            }

            .update-button.secondary {
                background: rgba(0, 0, 0, 0.3);
                color: white;
            }

            .update-timeline {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 215, 0, 0.2);
                border-radius: 12px;
                padding: 25px;
                margin-bottom: 30px;
            }

            .timeline-header {
                font-size: 20px;
                font-weight: 600;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .timeline-items {
                position: relative;
                padding-left: 40px;
            }

            .timeline-items::before {
                content: '';
                position: absolute;
                left: 15px;
                top: 0;
                bottom: 0;
                width: 2px;
                background: linear-gradient(180deg, var(--yorkshire-gold), var(--update-blue));
            }

            .timeline-item {
                position: relative;
                margin-bottom: 30px;
                animation: slideIn 0.5s ease;
            }

            @keyframes slideIn {
                from {
                    opacity: 0;
                    transform: translateX(-20px);
                }
                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            .timeline-marker {
                position: absolute;
                left: -30px;
                top: 5px;
                width: 16px;
                height: 16px;
                border-radius: 50%;
                background: var(--yorkshire-gold);
                border: 3px solid #1a1a2e;
                z-index: 1;
            }

            .timeline-marker.pending {
                background: var(--warning);
            }

            .timeline-marker.completed {
                background: var(--success);
            }

            .timeline-marker.failed {
                background: var(--danger);
            }

            .timeline-content {
                background: rgba(255, 255, 255, 0.05);
                border-radius: 8px;
                padding: 15px;
            }

            .timeline-title {
                font-size: 16px;
                font-weight: 600;
                margin-bottom: 5px;
            }

            .timeline-meta {
                font-size: 12px;
                color: rgba(255, 255, 255, 0.6);
                margin-bottom: 10px;
            }

            .timeline-description {
                font-size: 14px;
                color: rgba(255, 255, 255, 0.8);
                line-height: 1.5;
            }

            .update-packages {
                display: grid;
                gap: 20px;
                margin-bottom: 30px;
            }

            .package-card {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 215, 0, 0.2);
                border-radius: 12px;
                padding: 20px;
                transition: all 0.3s ease;
            }

            .package-card:hover {
                transform: translateY(-3px);
                border-color: var(--yorkshire-gold);
                box-shadow: 0 15px 30px rgba(255, 215, 0, 0.1);
            }

            .package-header {
                display: flex;
                justify-content: space-between;
                align-items: start;
                margin-bottom: 15px;
            }

            .package-info {
                flex: 1;
            }

            .package-name {
                font-size: 18px;
                font-weight: 600;
                margin-bottom: 5px;
            }

            .package-version {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 14px;
                color: rgba(255, 255, 255, 0.7);
            }

            .version-arrow {
                color: var(--yorkshire-gold);
            }

            .package-badge {
                background: var(--danger);
                color: white;
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 600;
            }

            .package-badge.critical {
                background: var(--danger);
                animation: pulse-alert 1s infinite;
            }

            .package-badge.optional {
                background: var(--update-blue);
            }

            .package-badge.security {
                background: var(--warning);
                color: black;
            }

            .package-changelog {
                background: rgba(0, 0, 0, 0.2);
                border-radius: 8px;
                padding: 12px;
                margin-bottom: 15px;
                font-size: 14px;
                line-height: 1.5;
            }

            .package-actions {
                display: flex;
                gap: 10px;
            }

            .package-button {
                flex: 1;
                background: linear-gradient(135deg, var(--update-blue), #2563EB);
                border: none;
                border-radius: 8px;
                padding: 10px;
                color: white;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.3s ease;
            }

            .package-button:hover {
                transform: scale(1.02);
                box-shadow: 0 5px 15px rgba(59, 130, 246, 0.3);
            }

            .package-button.secondary {
                background: rgba(255, 255, 255, 0.1);
            }

            .update-settings {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 215, 0, 0.2);
                border-radius: 12px;
                padding: 25px;
            }

            .settings-title {
                font-size: 20px;
                font-weight: 600;
                margin-bottom: 20px;
            }

            .setting-item {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 15px 0;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }

            .setting-item:last-child {
                border-bottom: none;
            }

            .setting-label {
                font-size: 14px;
                color: rgba(255, 255, 255, 0.9);
            }

            .setting-control {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .toggle-switch {
                position: relative;
                width: 50px;
                height: 26px;
                background: rgba(255, 255, 255, 0.2);
                border-radius: 13px;
                cursor: pointer;
                transition: background 0.3s ease;
            }

            .toggle-switch.active {
                background: var(--success);
            }

            .toggle-slider {
                position: absolute;
                top: 3px;
                left: 3px;
                width: 20px;
                height: 20px;
                background: white;
                border-radius: 50%;
                transition: transform 0.3s ease;
            }

            .toggle-switch.active .toggle-slider {
                transform: translateX(24px);
            }

            .progress-tracker {
                display: none;
                background: rgba(0, 0, 0, 0.9);
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                border-radius: 12px;
                padding: 30px;
                min-width: 400px;
                z-index: 1000;
            }

            .progress-tracker.active {
                display: block;
            }

            .progress-title {
                font-size: 20px;
                font-weight: 600;
                margin-bottom: 20px;
                text-align: center;
            }

            .progress-steps {
                margin-bottom: 20px;
            }

            .progress-step {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 10px;
                margin-bottom: 10px;
                background: rgba(255, 255, 255, 0.05);
                border-radius: 8px;
            }

            .step-icon {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.1);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .step-icon.completed {
                background: var(--success);
            }

            .step-icon.active {
                background: var(--update-blue);
                animation: pulse-status 1s infinite;
            }

            .step-name {
                flex: 1;
                font-size: 14px;
            }

            .step-status {
                font-size: 12px;
                color: rgba(255, 255, 255, 0.6);
            }

            .progress-bar-container {
                background: rgba(255, 255, 255, 0.1);
                border-radius: 10px;
                height: 10px;
                overflow: hidden;
                margin-bottom: 20px;
            }

            .progress-bar {
                background: linear-gradient(90deg, var(--update-blue), var(--yorkshire-gold));
                height: 100%;
                border-radius: 10px;
                transition: width 0.3s ease;
                position: relative;
                overflow: hidden;
            }

            .progress-bar::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(90deg, 
                    transparent, 
                    rgba(255, 255, 255, 0.3), 
                    transparent);
                animation: shimmer 2s infinite;
            }

            @keyframes shimmer {
                0% { transform: translateX(-100%); }
                100% { transform: translateX(100%); }
            }

            @keyframes pulse-status {
                0%, 100% { opacity: 1; }
                50% { opacity: 0.5; }
            }
        </style>
    </head>
    <body>
        <div class="update-manager-container">
            <div class="manager-header">
                <h1 class="manager-title">🔄 Update Manager</h1>
                <div class="header-actions">
                    <button class="update-button secondary" onclick="checkForUpdates()">
                        🔍 Check Now
                    </button>
                    <button class="update-button" onclick="openUpdateSettings()">
                        ⚙️ Settings
                    </button>
                </div>
            </div>

            <div class="update-summary">
                <div class="summary-card">
                    <div class="summary-icon">📦</div>
                    <div class="summary-value" id="totalPackages">24</div>
                    <div class="summary-label">Total Packages</div>
                </div>
                <div class="summary-card">
                    <div class="summary-icon">🔄</div>
                    <div class="summary-value" id="availableUpdates">7</div>
                    <div class="summary-label">Available Updates</div>
                </div>
                <div class="summary-card">
                    <div class="summary-icon">🔒</div>
                    <div class="summary-value" id="securityUpdates">2</div>
                    <div class="summary-label">Security Updates</div>
                </div>
                <div class="summary-card">
                    <div class="summary-icon">✅</div>
                    <div class="summary-value" id="upToDate">17</div>
                    <div class="summary-label">Up to Date</div>
                </div>
            </div>

            <!-- Get a CuPPA ASCII Art Section -->
            <div id="cuppa-ascii-container" class="cuppa-ascii-container">
                <div class="cuppa-ascii">
╔══════════════════════════════════════════════════════════════════════════════════════╗
║                                    GET A CUPPA                                      ║
║                           Yorkshire Champion Database Installation                   ║
╚══════════════════════════════════════════════════════════════════════════════════════╝

                    ████████                  ████████
                  ██        ██              ██        ██
                 ██    ☕    ██    CUPPA   ██    ☕    ██
                  ██        ██              ██        ██
                    ████████                  ████████
                       ██                        ██
                    ████████               ████████████
                  ██        ██           ██            ██
                 ██    TEA   ██         ██   YORKSHIRE  ██
                  ██        ██           ██            ██
                    ████████               ████████████

              ┌─────────────────────────────────────────────────────────┐
              │  "Right then, let's get this database sorted proper!"  │
              │                                                         │
              │  Database Installation Progress - Yorkshire Style       │
              │  Brew strength: CHAMPION GOLD STANDARD                  │
              │                                                         │
              │  ☕ Preparing the perfect cuppa while we wait...        │
              └─────────────────────────────────────────────────────────┘
                </div>
            </div>

            <!-- Database Installation Progress -->
            <div id="progress-container" class="progress-container">
                <div class="progress-header">
                    <div class="progress-title">Database Installation Progress</div>
                    <div class="progress-percentage" id="progress-percentage">0%</div>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" id="progress-fill" style="width: 0%"></div>
                </div>
                <div class="progress-steps">
                    <div class="progress-step" id="step-init">Initialize</div>
                    <div class="progress-step" id="step-tables">Create Tables</div>
                    <div class="progress-step" id="step-data">Load Data</div>
                    <div class="progress-step" id="step-indexes">Build Indexes</div>
                    <div class="progress-step" id="step-optimize">Optimize</div>
                    <div class="progress-step" id="step-validate">Validate</div>
                    <div class="progress-step" id="step-finalize">Finalize</div>
                </div>
                <div id="progress-status" style="color: var(--yorkshire-gold); margin-top: 15px; text-align: center; font-weight: bold;">
                    Preparing Yorkshire Champion Database Installation...
                </div>
            </div>

            <!-- Database Install Button -->
            <button id="database-install-btn" class="database-install-btn" onclick="startDatabaseInstall()">
                ☕ Install Database & Get a CuPPA (3 mins)
            </button>

            <div class="update-alert" id="criticalAlert" style="display: none;">
                <div class="alert-icon">⚠️</div>
                <div class="alert-content">
                    <div class="alert-title">Critical Security Updates Available</div>
                    <div class="alert-description">2 critical security updates require immediate installation</div>
                </div>
                <div class="alert-actions">
                    <button class="update-button" onclick="installCriticalUpdates()">
                        Install Now
                    </button>
                    <button class="update-button secondary" onclick="viewDetails()">
                        View Details
                    </button>
                </div>
            </div>

            <div class="update-timeline">
                <h2 class="timeline-header">
                    <span>📅</span>
                    Update History
                </h2>
                <div class="timeline-items" id="updateTimeline">
                    <!-- Timeline items will be loaded here -->
                </div>
            </div>

            <h2 style="margin-bottom: 20px;">Available Updates</h2>
            <div class="update-packages" id="updatePackages">
                <!-- Update packages will be loaded here -->
            </div>

            <div class="update-settings">
                <h3 class="settings-title">Update Settings</h3>
                <div class="setting-item">
                    <span class="setting-label">Automatic Updates</span>
                    <div class="setting-control">
                        <div class="toggle-switch active" onclick="toggleSetting(this, 'autoUpdate')">
                            <div class="toggle-slider"></div>
                        </div>
                    </div>
                </div>
                <div class="setting-item">
                    <span class="setting-label">Install Security Updates Automatically</span>
                    <div class="setting-control">
                        <div class="toggle-switch active" onclick="toggleSetting(this, 'autoSecurity')">
                            <div class="toggle-slider"></div>
                        </div>
                    </div>
                </div>
                <div class="setting-item">
                    <span class="setting-label">Check for Updates Daily</span>
                    <div class="setting-control">
                        <div class="toggle-switch active" onclick="toggleSetting(this, 'dailyCheck')">
                            <div class="toggle-slider"></div>
                        </div>
                    </div>
                </div>
                <div class="setting-item">
                    <span class="setting-label">Enable Rollback Support</span>
                    <div class="setting-control">
                        <div class="toggle-switch active" onclick="toggleSetting(this, 'rollback')">
                            <div class="toggle-slider"></div>
                        </div>
                    </div>
                </div>
                <div class="setting-item">
                    <span class="setting-label">Auto-Document in Purple Pages</span>
                    <div class="setting-control">
                        <div class="toggle-switch active" onclick="toggleSetting(this, 'purplePages')">
                            <div class="toggle-slider"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Progress Tracker Modal -->
        <div class="progress-tracker" id="progressTracker">
            <h3 class="progress-title">Installing Updates...</h3>
            <div class="progress-steps" id="progressSteps">
                <!-- Steps will be added dynamically -->
            </div>
            <div class="progress-bar-container">
                <div class="progress-bar" id="updateProgressBar" style="width: 0%"></div>
            </div>
            <div style="text-align: center;">
                <span id="progressStatus">Preparing installation...</span>
            </div>
        </div>

        <script>
            class UpdateManager {
                constructor() {
                    this.packages = new Map();
                    this.availableUpdates = [];
                    this.updateHistory = [];
                    this.settings = {
                        autoUpdate: true,
                        autoSecurity: true,
                        dailyCheck: true,
                        rollback: true,
                        purplePages: true
                    };
                    this.updateQueue = [];
                    this.currentUpdate = null;
                    this.initializeWebSocket();
                    this.loadPackages();
                    this.loadUpdateHistory();
                    this.startAutoCheck();
                }

                initializeWebSocket() {
                    this.ws = new WebSocket('wss://localhost:8443/update-manager');
                    
                    this.ws.onmessage = (event) => {
                        const data = JSON.parse(event.data);
                        this.handleWebSocketMessage(data);
                    };

                    this.ws.onerror = (error) => {
                        console.error('WebSocket error:', error);
                        this.reconnectWebSocket();
                    };
                }

                handleWebSocketMessage(data) {
                    switch(data.type) {
                        case 'update_available':
                            this.onUpdateAvailable(data.package);
                            break;
                        case 'update_progress':
                            this.updateInstallProgress(data.progress, data.status);
                            break;
                        case 'update_complete':
                            this.onUpdateComplete(data.package);
                            break;
                        case 'update_failed':
                            this.onUpdateFailed(data.package, data.error);
                            break;
                    }
                }

                async loadPackages() {
                    try {
                        const response = await fetch('/api/update-manager/packages');
                        const data = await response.json();
                        
                        data.packages.forEach(pkg => {
                            this.packages.set(pkg.id, pkg);
                        });
                        
                        this.availableUpdates = data.updates || [];
                        this.renderPackages();
                        this.updateSummary();
                        
                        if (this.hasCriticalUpdates()) {
                            document.getElementById('criticalAlert').style.display = 'flex';
                        }
                    } catch (error) {
                        console.error('Failed to load packages:', error);
                    }
                }

                async loadUpdateHistory() {
                    try {
                        const response = await fetch('/api/update-manager/history');
                        this.updateHistory = await response.json();
                        this.renderTimeline();
                    } catch (error) {
                        console.error('Failed to load update history:', error);
                    }
                }

                renderPackages() {
                    const container = document.getElementById('updatePackages');
                    
                    if (this.availableUpdates.length === 0) {
                        container.innerHTML = '<div class="no-updates">All packages are up to date!</div>';
                        return;
                    }

                    container.innerHTML = this.availableUpdates
                        .map(update => this.createPackageCard(update))
                        .join('');
                }

                createPackageCard(update) {
                    const badgeClass = update.critical ? 'critical' : 
                                      update.security ? 'security' : 'optional';
                    const badgeText = update.critical ? 'CRITICAL' : 
                                     update.security ? 'SECURITY' : 'OPTIONAL';

                    return `
                        <div class="package-card" data-package-id="${update.id}">
                            <div class="package-header">
                                <div class="package-info">
                                    <div class="package-name">${update.name}</div>
                                    <div class="package-version">
                                        v${update.currentVersion} 
                                        <span class="version-arrow">→</span> 
                                        v${update.newVersion}
                                    </div>
                                </div>
                                <span class="package-badge ${badgeClass}">${badgeText}</span>
                            </div>
                            <div class="package-changelog">
                                ${update.changelog || 'No changelog available'}
                            </div>
                            <div class="package-actions">
                                <button class="package-button" onclick="updateManager.installUpdate('${update.id}')">
                                    Install Update
                                </button>
                                <button class="package-button secondary" onclick="updateManager.viewDetails('${update.id}')">
                                    View Details
                                </button>
                                ${update.canDefer ? `
                                    <button class="package-button secondary" onclick="updateManager.deferUpdate('${update.id}')">
                                        Later
                                    </button>
                                ` : ''}
                            </div>
                        </div>
                    `;
                }

                renderTimeline() {
                    const container = document.getElementById('updateTimeline');
                    
                    if (this.updateHistory.length === 0) {
                        container.innerHTML = '<div class="no-history">No update history available</div>';
                        return;
                    }

                    container.innerHTML = this.updateHistory
                        .slice(0, 5)
                        .map(item => this.createTimelineItem(item))
                        .join('');
                }

                createTimelineItem(item) {
                    const markerClass = item.status === 'completed' ? 'completed' :
                                       item.status === 'failed' ? 'failed' : 'pending';

                    return `
                        <div class="timeline-item">
                            <div class="timeline-marker ${markerClass}"></div>
                            <div class="timeline-content">
                                <div class="timeline-title">${item.packageName} v${item.version}</div>
                                <div class="timeline-meta">${this.formatDate(item.timestamp)}</div>
                                <div class="timeline-description">${item.description || 'Update installed successfully'}</div>
                            </div>
                        </div>
                    `;
                }

                async installUpdate(packageId) {
                    const update = this.availableUpdates.find(u => u.id === packageId);
                    if (!update) return;

                    this.showProgressTracker();
                    this.currentUpdate = update;
                    
                    const steps = [
                        { name: 'Downloading package', status: 'active' },
                        { name: 'Verifying integrity', status: 'pending' },
                        { name: 'Creating backup', status: 'pending' },
                        { name: 'Installing update', status: 'pending' },
                        { name: 'Running tests', status: 'pending' },
                        { name: 'Finalizing', status: 'pending' }
                    ];
                    
                    this.updateProgressSteps(steps);

                    try {
                        const response = await fetch('/api/update-manager/install', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ packageId })
                        });

                        if (response.ok) {
                            // Installation started, progress will be updated via WebSocket
                        } else {
                            throw new Error('Installation failed');
                        }
                    } catch (error) {
                        this.onUpdateFailed(update, error.message);
                    }
                }

                async installAllUpdates() {
                    this.updateQueue = [...this.availableUpdates];
                    this.processUpdateQueue();
                }

                async installCriticalUpdates() {
                    this.updateQueue = this.availableUpdates.filter(u => u.critical || u.security);
                    this.processUpdateQueue();
                }

                async processUpdateQueue() {
                    if (this.updateQueue.length === 0) {
                        this.hideProgressTracker();
                        this.showNotification('All updates installed successfully!', 'success');
                        this.loadPackages();
                        return;
                    }

                    const nextUpdate = this.updateQueue.shift();
                    await this.installUpdate(nextUpdate.id);
                }

                showProgressTracker() {
                    document.getElementById('progressTracker').classList.add('active');
                }

                hideProgressTracker() {
                    document.getElementById('progressTracker').classList.remove('active');
                }

                updateProgressSteps(steps) {
                    const container = document.getElementById('progressSteps');
                    container.innerHTML = steps.map(step => `
                        <div class="progress-step">
                            <div class="step-icon ${step.status}">
                                ${step.status === 'completed' ? '✓' : 
                                  step.status === 'active' ? '⚡' : '○'}
                            </div>
                            <div class="step-name">${step.name}</div>
                            <div class="step-status">
                                ${step.status === 'completed' ? 'Done' :
                                  step.status === 'active' ? 'In progress...' : 'Pending'}
                            </div>
                        </div>
                    `).join('');
                }

                updateInstallProgress(percent, status) {
                    const progressBar = document.getElementById('updateProgressBar');
                    progressBar.style.width = percent + '%';
                    
                    const statusText = document.getElementById('progressStatus');
                    statusText.textContent = status;
                }

                onUpdateComplete(packageInfo) {
                    // Log to update history
                    this.updateHistory.unshift({
                        packageName: packageInfo.name,
                        version: packageInfo.version,
                        timestamp: new Date(),
                        status: 'completed'
                    });

                    // Document in Purple Pages if enabled
                    if (this.settings.purplePages) {
                        this.documentUpdate(packageInfo);
                    }

                    // Remove from available updates
                    this.availableUpdates = this.availableUpdates.filter(u => u.id !== packageInfo.id);
                    
                    // Continue with queue
                    if (this.updateQueue.length > 0) {
                        this.processUpdateQueue();
                    } else {
                        this.hideProgressTracker();
                        this.showNotification(`${packageInfo.name} updated successfully!`, 'success');
                        this.renderPackages();
                        this.renderTimeline();
                        this.updateSummary();
                    }
                }

                onUpdateFailed(packageInfo, error) {
                    this.hideProgressTracker();
                    this.showNotification(`Failed to update ${packageInfo.name}: ${error}`, 'error');
                    
                    // Offer rollback if available
                    if (this.settings.rollback) {
                        if (confirm(`Update failed. Would you like to rollback ${packageInfo.name}?`)) {
                            this.rollbackPackage(packageInfo.id);
                        }
                    }
                }

                async rollbackPackage(packageId) {
                    try {
                        const response = await fetch(`/api/update-manager/rollback/${packageId}`, {
                            method: 'POST'
                        });
                        
                        if (response.ok) {
                            this.showNotification('Rollback successful', 'success');
                        } else {
                            throw new Error('Rollback failed');
                        }
                    } catch (error) {
                        this.showNotification('Rollback failed: ' + error.message, 'error');
                    }
                }

                async documentUpdate(packageInfo) {
                    // Auto-document in Purple Pages
                    await fetch('/api/purple-pages/document', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            type: 'system_update',
                            package: packageInfo,
                            timestamp: new Date().toISOString(),
                            changelog: packageInfo.changelog
                        })
                    });
                }

                hasCriticalUpdates() {
                    return this.availableUpdates.some(u => u.critical || u.security);
                }

                updateSummary() {
                    const totalPackages = this.packages.size;
                    const availableUpdates = this.availableUpdates.length;
                    const securityUpdates = this.availableUpdates.filter(u => u.security || u.critical).length;
                    const upToDate = totalPackages - availableUpdates;

                    document.getElementById('totalPackages').textContent = totalPackages;
                    document.getElementById('availableUpdates').textContent = availableUpdates;
                    document.getElementById('securityUpdates').textContent = securityUpdates;
                    document.getElementById('upToDate').textContent = upToDate;
                }

                startAutoCheck() {
                    if (this.settings.dailyCheck) {
                        // Check every hour (in production, this would be daily)
                        setInterval(() => {
                            this.checkForUpdates();
                        }, 3600000); // 1 hour
                    }
                }

                async checkForUpdates() {
                    this.showNotification('Checking for updates...', 'info');
                    await this.loadPackages();
                    
                    if (this.availableUpdates.length > 0) {
                        this.showNotification(`${this.availableUpdates.length} updates available`, 'info');
                        
                        if (this.settings.autoSecurity && this.hasCriticalUpdates()) {
                            this.installCriticalUpdates();
                        }
                    } else {
                        this.showNotification('All packages are up to date', 'success');
                    }
                }

                formatDate(date) {
                    const d = new Date(date);
                    const now = new Date();
                    const diff = now - d;
                    
                    if (diff < 3600000) {
                        return `${Math.floor(diff / 60000)} minutes ago`;
                    } else if (diff < 86400000) {
                        return `${Math.floor(diff / 3600000)} hours ago`;
                    } else if (diff < 604800000) {
                        return `${Math.floor(diff / 86400000)} days ago`;
                    } else {
                        return d.toLocaleDateString();
                    }
                }

                showNotification(message, type = 'info') {
                    console.log(`[${type}] ${message}`);
                    // Implement actual notification UI
                }

                viewDetails(packageId) {
                    window.location.href = `/updates/details/${packageId}`;
                }

                deferUpdate(packageId) {
                    this.availableUpdates = this.availableUpdates.filter(u => u.id !== packageId);
                    this.renderPackages();
                    this.updateSummary();
                    this.showNotification('Update deferred', 'info');
                }

                // Database Installation with CuPPA ASCII Art
                async startDatabaseInstall() {
                    const button = document.getElementById('database-install-btn');
                    const asciiContainer = document.getElementById('cuppa-ascii-container');
                    const progressContainer = document.getElementById('progress-container');
                    
                    // Show ASCII art and progress container
                    asciiContainer.classList.add('show');
                    progressContainer.classList.add('show');
                    
                    // Disable button
                    button.disabled = true;
                    button.textContent = '☕ Installing Database... (3 mins)';
                    
                    // Define installation steps
                    const steps = [
                        { id: 'step-init', name: 'Initialize', duration: 15000, message: 'Initializing Yorkshire Champion Database...' },
                        { id: 'step-tables', name: 'Create Tables', duration: 30000, message: 'Creating database tables with pfSQL support...' },
                        { id: 'step-data', name: 'Load Data', duration: 45000, message: 'Loading initial data and configurations...' },
                        { id: 'step-indexes', name: 'Build Indexes', duration: 30000, message: 'Building database indexes for optimal performance...' },
                        { id: 'step-optimize', name: 'Optimize', duration: 25000, message: 'Optimizing database performance settings...' },
                        { id: 'step-validate', name: 'Validate', duration: 20000, message: 'Validating database integrity and connections...' },
                        { id: 'step-finalize', name: 'Finalize', duration: 15000, message: 'Finalizing installation and enabling AI IPA...' }
                    ];
                    
                    const totalDuration = steps.reduce((sum, step) => sum + step.duration, 0);
                    let elapsedTime = 0;
                    
                    // Process each step
                    for (let i = 0; i < steps.length; i++) {
                        const step = steps[i];
                        const stepElement = document.getElementById(step.id);
                        const statusElement = document.getElementById('progress-status');
                        
                        // Mark current step as active
                        stepElement.classList.add('active');
                        statusElement.textContent = step.message;
                        
                        // Simulate step progress
                        const startTime = elapsedTime;
                        const endTime = elapsedTime + step.duration;
                        
                        await new Promise(resolve => {
                            const stepInterval = setInterval(() => {
                                elapsedTime += 100;
                                
                                const totalProgress = (elapsedTime / totalDuration) * 100;
                                this.updateDatabaseProgress(Math.min(totalProgress, 100));
                                
                                if (elapsedTime >= endTime) {
                                    clearInterval(stepInterval);
                                    
                                    // Mark step as completed
                                    stepElement.classList.remove('active');
                                    stepElement.classList.add('completed');
                                    
                                    resolve();
                                }
                            }, 100);
                        });
                    }
                    
                    // Installation complete
                    document.getElementById('progress-status').innerHTML = `
                        <span style="color: var(--yorkshire-green);">✅ Database Installation Complete!</span><br>
                        <span style="color: var(--yorkshire-gold);">Yorkshire Champion Database is now ready with AI IPA integration</span>
                    `;
                    
                    // Update button
                    button.textContent = '✅ Database Installed Successfully';
                    button.style.background = 'var(--yorkshire-green)';
                    
                    // Add completion message to ASCII art
                    setTimeout(() => {
                        const asciiDiv = document.querySelector('.cuppa-ascii');
                        asciiDiv.innerHTML += `

              ┌─────────────────────────────────────────────────────────┐
              │                    INSTALLATION COMPLETE!               │
              │                                                         │
              │  ✅ Database: Yorkshire Champion Gold Standard         │
              │  ✅ AI IPA: Injection-Proof API Active                │
              │  ✅ Security: Military-Grade Encryption                │
              │  ✅ Performance: Optimized for Speed                   │
              │                                                         │
              │  Your cuppa is ready! Database operational in 3 mins   │
              └─────────────────────────────────────────────────────────┘`;
                    }, 2000);
                    
                    // Log to Purple Pages
                    this.logToPurplePages('Database installation completed successfully');
                    this.showNotification('Database installation completed successfully!', 'success');
                }

                updateDatabaseProgress(percentage) {
                    const progressFill = document.getElementById('progress-fill');
                    const progressPercentage = document.getElementById('progress-percentage');
                    
                    progressFill.style.width = `${percentage}%`;
                    progressPercentage.textContent = `${Math.round(percentage)}%`;
                }

                logToPurplePages(message) {
                    // Log to Purple Pages documentation system
                    const logEntry = {
                        timestamp: new Date().toISOString(),
                        component: 'update_manager',
                        action: 'database_install',
                        message: message,
                        yorkshire_champion: true
                    };
                    
                    if (this.ws && this.ws.readyState === WebSocket.OPEN) {
                        this.ws.send(JSON.stringify({
                            type: 'purple_pages_log',
                            data: logEntry
                        }));
                    }
                }
            }

            // Initialize Update Manager
            const updateManager = new UpdateManager();

            // Global functions
            function checkForUpdates() {
                updateManager.checkForUpdates();
            }

            function installCriticalUpdates() {
                updateManager.installCriticalUpdates();
            }

            function viewDetails() {
                // Show details of critical updates
                const criticalUpdates = updateManager.availableUpdates.filter(u => u.critical || u.security);
                console.log('Critical updates:', criticalUpdates);
            }

            function toggleSetting(element, setting) {
                element.classList.toggle('active');
                updateManager.settings[setting] = element.classList.contains('active');
                
                // Save settings
                fetch('/api/update-manager/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(updateManager.settings)
                });
            }

            function openUpdateSettings() {
                // Scroll to settings section
                document.querySelector('.update-settings').scrollIntoView({ behavior: 'smooth' });
            }

            function startDatabaseInstall() {
                updateManager.startDatabaseInstall();
            }

            // Load initial data
            updateManager.renderTimeline();
        </script>
    </body>
    </html>
}