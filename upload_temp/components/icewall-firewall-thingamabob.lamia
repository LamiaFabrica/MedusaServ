                    </div>
                </div>
                
            </div>
        </div>
        
        <!-- Thingamabobs Protection Tab -->
        <div id="thingamabobs-tab" class="tab-content">
            <div class="thingamabobs-section">
                
                <h3 class="section-title">
                    <i class="fas fa-shield-virus"></i>
                    Thingamabob Protection Management
                </h3>
                
                <div class="thingamabobs-grid">
                    
                    <!-- Webmail Thingamabob -->
                    <div class="thingamabob-protection-card webmail">
                        <div class="card-header">
                            <div class="thingamabob-icon">
                                <i class="fas fa-envelope-open-text"></i>
                            </div>
                            <div class="thingamabob-info">
                                <h4>Webmail Thingamabob</h4>
                                <p>Email service protection</p>
                            </div>
