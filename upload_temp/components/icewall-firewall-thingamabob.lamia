@component "thingamabob" {
    @version "0.4.0"
    @theme "enterprise"
    @security_level "quantum_resistant"
    @encryption "AES_256_PQC"
    
<%--
ICEWALL FIREWALL DADDY THINGAMABOB - THE ULTIMATE SECURITY MANAGEMENT INTERFACE! 🛡️🔥
================================================================================
Revolutionary web interface for managing the Icewall Firewall Daddy
Complete policy management, IP listing, and security monitoring
Yorkshire Champion Standards with 15.0x security multiplier
© 2025 The Medusa Project | Roylepython | D Hargreaves
--%>

<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="java.util.*" %>
<%@ page import="java.text.*" %>

<!-- Revolutionary Icewall Firewall Daddy Management Dashboard -->
<div id="icewall-firewall-thingamabob" class="thingamabob-container revolutionary-security">
    
    <!-- Yorkshire Champion Header -->
    <div class="thingamabob-header firewall-daddy-header">
        <div class="header-title-section">
            <i class="fas fa-shield-alt firewall-daddy-icon"></i>
            <div class="title-content">
                <h2 class="thingamabob-title">🛡️ ICEWALL FIREWALL DADDY 🔥</h2>
                <p class="thingamabob-subtitle">Ultimate Quantum Security Management • Yorkshire Champion Standards</p>
            </div>
        </div>
        
        <div class="header-status-section">
            <div class="firewall-status-indicator" id="firewall-status">
                <span class="status-dot active"></span>
                <span class="status-text">DADDY ON DUTY!</span>
            </div>
            <div class="yorkshire-multiplier">
                <span class="multiplier-label">Yorkshire Multiplier:</span>
                <span class="multiplier-value">15.0x</span>
            </div>
        </div>
    </div>
    
    <!-- Real-time Security Metrics Dashboard -->
    <div class="security-metrics-dashboard">
        <div class="metrics-grid">
            
            <!-- Total Requests Processed -->
            <div class="metric-card requests-processed">
                <div class="metric-icon">
                    <i class="fas fa-tachometer-alt"></i>
                </div>
                <div class="metric-content">
                    <h3 class="metric-value" id="total-requests">0</h3>
                    <p class="metric-label">Total Requests</p>
                    <div class="metric-trend">
                        <span class="trend-indicator up">
                            <i class="fas fa-arrow-up"></i> +15.3%
                        </span>
                    </div>
                </div>
            </div>
            
            <!-- Threats Blocked -->
            <div class="metric-card threats-blocked">
                <div class="metric-icon">
                    <i class="fas fa-shield-virus"></i>
                </div>
                <div class="metric-content">
                    <h3 class="metric-value" id="threats-blocked">0</h3>
                    <p class="metric-label">Threats Blocked</p>
                    <div class="metric-trend">
                        <span class="trend-indicator up">
                            <i class="fas fa-arrow-up"></i> Yorkshire Champion!
                        </span>
                    </div>
                </div>
            </div>
            
            <!-- Active Policies -->
            <div class="metric-card active-policies">
                <div class="metric-icon">
                    <i class="fas fa-cogs"></i>
                </div>
                <div class="metric-content">
                    <h3 class="metric-value" id="active-policies">0</h3>
                    <p class="metric-label">Active Policies</p>
                    <div class="metric-trend">
                        <span class="trend-indicator stable">
                            <i class="fas fa-minus"></i> Stable
                        </span>
                    </div>
                </div>
            </div>
            
            <!-- Blocked IPs -->
            <div class="metric-card blocked-ips">
                <div class="metric-icon">
                    <i class="fas fa-ban"></i>
                </div>
                <div class="metric-content">
                    <h3 class="metric-value" id="blocked-ips">0</h3>
                    <p class="metric-label">Blocked IPs</p>
                    <div class="metric-trend">
                        <span class="trend-indicator down">
                            <i class="fas fa-arrow-down"></i> -2.1%
                        </span>
                    </div>
                </div>
            </div>
            
        </div>
        
        <!-- Real-time Threat Level Indicator -->
        <div class="threat-level-indicator">
            <div class="threat-level-header">
                <h3>🚨 Current Threat Level</h3>
            </div>
            <div class="threat-level-display" id="threat-level-display">
                <div class="threat-gauge">
                    <div class="gauge-background">
                        <div class="gauge-fill" id="threat-gauge-fill" style="width: 15%;"></div>
                    </div>
                    <div class="gauge-labels">
                        <span class="gauge-label minimal">Minimal</span>
                        <span class="gauge-label low">Low</span>
                        <span class="gauge-label medium">Medium</span>
                        <span class="gauge-label high">High</span>
                        <span class="gauge-label critical">Critical</span>
                        <span class="gauge-label yorkshire">Yorkshire Champion</span>
                    </div>
                </div>
                <div class="current-threat-info">
                    <span class="threat-text" id="current-threat-text">LOW - All Systems Secure</span>
                    <span class="daddy-status">🛡️ DADDY IS WATCHING!</span>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Management Tabs Interface -->
    <div class="icewall-tabs-container">
        <div class="tab-navigation">
            <button class="tab-button active" data-tab="overview">📊 Overview</button>
            <button class="tab-button" data-tab="policies">📋 Policy Management</button>
            <button class="tab-button" data-tab="ip-management">🌐 IP Management</button>
            <button class="tab-button" data-tab="threat-analysis">🔍 Threat Analysis</button>
            <button class="tab-button" data-tab="thingamabobs">🔧 Thingamabobs</button>
            <button class="tab-button" data-tab="settings">⚙️ Settings</button>
        </div>
        
        <!-- Overview Tab -->
        <div id="overview-tab" class="tab-content active">
            <div class="overview-section">
                
                <!-- Live Activity Feed -->
                <div class="activity-feed-container">
                    <h3 class="section-title">
                        <i class="fas fa-stream"></i>
                        Live Security Activity Feed
                    </h3>
                    <div class="activity-feed" id="security-activity-feed">
                        <div class="activity-item blocked">
                            <div class="activity-icon">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-header">
                                    <span class="activity-type">SQL Injection Blocked</span>
                                    <span class="activity-time">2 minutes ago</span>
                                </div>
                                <div class="activity-details">
                                    IP: 192.168.1.100 • Target: /webmail/login.php • Threat Level: Critical
                                </div>
                            </div>
                        </div>
                        
                        <div class="activity-item allowed">
                            <div class="activity-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-header">
                                    <span class="activity-type">Jupyter Session Started</span>
                                    <span class="activity-time">5 minutes ago</span>
                                </div>
                                <div class="activity-details">
                                    IP: 172.16.0.50 • Target: /jupyter/lab • Status: Verified & Secured
                                </div>
                            </div>
                        </div>
                        
                        <div class="activity-item challenged">
                            <div class="activity-icon">
                                <i class="fas fa-exclamation-triangle"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-header">
                                    <span class="activity-type">Suspicious Pattern Detected</span>
                                    <span class="activity-time">8 minutes ago</span>
                                </div>
                                <div class="activity-details">
                                    IP: 10.0.0.25 • Target: /files/upload • Action: Challenge Required
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="activity-controls">
                        <button class="btn btn-secondary" onclick="pauseActivityFeed()">
                            <i class="fas fa-pause"></i> Pause Feed
                        </button>
                        <button class="btn btn-primary" onclick="exportActivityLog()">
                            <i class="fas fa-download"></i> Export Log
                        </button>
                    </div>
                </div>
                
                <!-- Thingamabob Protection Status -->
                <div class="thingamabob-protection-status">
                    <h3 class="section-title">
                        <i class="fas fa-shield-check"></i>
                        Thingamabob Protection Status
                    </h3>
                    <div class="protection-grid">
                        
                        <div class="protection-item webmail">
                            <div class="protection-icon">
                                <i class="fas fa-envelope-open-text"></i>
                            </div>
                            <div class="protection-info">
                                <h4>Webmail Thingamabob</h4>
                                <div class="protection-stats">
                                    <span class="stat">Protected: <strong>1,247 requests</strong></span>
                                    <span class="stat">Blocked: <strong>23 threats</strong></span>
                                </div>
                            </div>
                            <div class="protection-status active">
                                <i class="fas fa-shield-alt"></i>
                                <span>PROTECTED</span>
                            </div>
                        </div>
                        
                        <div class="protection-item jupyter">
                            <div class="protection-icon">
                                <i class="fas fa-code"></i>
                            </div>
                            <div class="protection-info">
                                <h4>Jupyter Thingamabob</h4>
                                <div class="protection-stats">
                                    <span class="stat">Sessions: <strong>89 secured</strong></span>
                                    <span class="stat">Code Exec: <strong>456 monitored</strong></span>
                                </div>
                            </div>
                            <div class="protection-status active">
                                <i class="fas fa-shield-alt"></i>
                                <span>MONITORED</span>
                            </div>
                        </div>
                        
                        <div class="protection-item filemanager">
                            <div class="protection-icon">
                                <i class="fas fa-folder-open"></i>
                            </div>
                            <div class="protection-info">
                                <h4>File Manager Thingamabob</h4>
                                <div class="protection-stats">
                                    <span class="stat">Uploads: <strong>334 scanned</strong></span>
                                    <span class="stat">Traversal: <strong>12 blocked</strong></span>
                                </div>
                            </div>
                            <div class="protection-status active">
                                <i class="fas fa-shield-alt"></i>
                                <span>SECURED</span>
                            </div>
                        </div>
                        
                        <div class="protection-item calendar">
                            <div class="protection-icon">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <div class="protection-info">
                                <h4>Calendar Thingamabob</h4>
                                <div class="protection-stats">
                                    <span class="stat">CalDAV: <strong>78 validated</strong></span>
                                    <span class="stat">Events: <strong>156 secured</strong></span>
                                </div>
                            </div>
                            <div class="protection-status active">
                                <i class="fas fa-shield-alt"></i>
                                <span>VALIDATED</span>
                            </div>
                        </div>
                        
                        <div class="protection-item ftp">
                            <div class="protection-icon">
                                <i class="fas fa-server"></i>
                            </div>
                            <div class="protection-info">
                                <h4>VSFTPD Thingamabob</h4>
                                <div class="protection-stats">
                                    <span class="stat">Connections: <strong>45 monitored</strong></span>
                                    <span class="stat">Transfers: <strong>123 secured</strong></span>
                                </div>
                            </div>
                            <div class="protection-status active">
                                <i class="fas fa-shield-alt"></i>
                                <span>MONITORED</span>
                            </div>
                        </div>
                        
                    </div>
                </div>
                
            </div>
        </div>
        
        <!-- Policy Management Tab -->
        <div id="policies-tab" class="tab-content">
            <div class="policy-management-section">
                
                <!-- Policy Controls -->
                <div class="policy-controls">
                    <h3 class="section-title">
                        <i class="fas fa-cogs"></i>
                        Security Policy Management
                    </h3>
                    
                    <div class="policy-action-bar">
                        <button class="btn btn-success" onclick="showAddPolicyModal()">
                            <i class="fas fa-plus"></i> Add New Policy
                        </button>
                        <button class="btn btn-primary" onclick="exportPolicies()">
                            <i class="fas fa-download"></i> Export Policies
                        </button>
                        <button class="btn btn-secondary" onclick="importPolicies()">
                            <i class="fas fa-upload"></i> Import Policies
                        </button>
                        <button class="btn btn-warning" onclick="optimizePolicies()">
                            <i class="fas fa-magic"></i> Auto-Optimize
                        </button>
                    </div>
                </div>
                
                <!-- Policy List -->
                <div class="policy-list-container">
                    <div class="policy-filters">
                        <div class="filter-group">
                            <label>Policy Type:</label>
                            <select id="policy-type-filter" onchange="filterPolicies()">
                                <option value="all">All Types</option>
                                <option value="sql-injection">SQL Injection</option>
                                <option value="xss-protection">XSS Protection</option>
                                <option value="ddos-mitigation">DDoS Mitigation</option>
                                <option value="brute-force">Brute Force</option>
                                <option value="malware-scan">Malware Scanning</option>
                                <option value="quantum-threat">Quantum Threat</option>
                            </select>
                        </div>
                        
                        <div class="filter-group">
                            <label>Status:</label>
                            <select id="policy-status-filter" onchange="filterPolicies()">
                                <option value="all">All Policies</option>
                                <option value="enabled">Enabled Only</option>
                                <option value="disabled">Disabled Only</option>
                            </select>
                        </div>
                        
                        <div class="filter-group">
                            <label>Search:</label>
                            <input type="text" id="policy-search" placeholder="Search policies..." onkeyup="searchPolicies()">
                        </div>
                    </div>
                    
                    <div class="policy-table-container">
                        <table class="policy-table" id="policies-table">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Policy Name</th>
                                    <th>Type</th>
                                    <th>Threat Level</th>
                                    <th>Action</th>
                                    <th>Matches</th>
                                    <th>Effectiveness</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="policies-table-body">
                                
                                <tr class="policy-row active">
                                    <td>
                                        <div class="status-toggle">
                                            <input type="checkbox" id="policy-1" checked>
                                            <label for="policy-1" class="toggle-switch"></label>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="policy-name">
                                            <strong>Yorkshire Champion SQL Injection Protection</strong>
                                            <small>Advanced pattern matching with ML enhancement</small>
                                        </div>
                                    </td>
                                    <td><span class="policy-type sql-injection">SQL Injection</span></td>
                                    <td><span class="threat-level critical">Critical</span></td>
                                    <td><span class="policy-action block">Yorkshire Champion Block</span></td>
                                    <td><span class="match-count">1,247</span></td>
                                    <td>
                                        <div class="effectiveness-meter">
                                            <div class="effectiveness-bar" style="width: 98.5%;"></div>
                                            <span class="effectiveness-text">98.5%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="policy-actions">
                                            <button class="btn-icon" onclick="editPolicy('policy-1')" title="Edit Policy">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn-icon" onclick="duplicatePolicy('policy-1')" title="Duplicate">
                                                <i class="fas fa-copy"></i>
                                            </button>
                                            <button class="btn-icon danger" onclick="deletePolicy('policy-1')" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                
                                <tr class="policy-row active">
                                    <td>
                                        <div class="status-toggle">
                                            <input type="checkbox" id="policy-2" checked>
                                            <label for="policy-2" class="toggle-switch"></label>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="policy-name">
                                            <strong>Yorkshire Champion XSS Protection</strong>
                                            <small>Multi-layer XSS detection and prevention</small>
                                        </div>
                                    </td>
                                    <td><span class="policy-type xss-protection">XSS Protection</span></td>
                                    <td><span class="threat-level high">High</span></td>
                                    <td><span class="policy-action block">Block</span></td>
                                    <td><span class="match-count">456</span></td>
                                    <td>
                                        <div class="effectiveness-meter">
                                            <div class="effectiveness-bar" style="width: 94.2%;"></div>
                                            <span class="effectiveness-text">94.2%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="policy-actions">
                                            <button class="btn-icon" onclick="editPolicy('policy-2')" title="Edit Policy">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn-icon" onclick="duplicatePolicy('policy-2')" title="Duplicate">
                                                <i class="fas fa-copy"></i>
                                            </button>
                                            <button class="btn-icon danger" onclick="deletePolicy('policy-2')" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                
                                <tr class="policy-row active">
                                    <td>
                                        <div class="status-toggle">
                                            <input type="checkbox" id="policy-3" checked>
                                            <label for="policy-3" class="toggle-switch"></label>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="policy-name">
                                            <strong>DDoS Attack Mitigation</strong>
                                            <small>Real-time traffic analysis and rate limiting</small>
                                        </div>
                                    </td>
                                    <td><span class="policy-type ddos-mitigation">DDoS Mitigation</span></td>
                                    <td><span class="threat-level high">High</span></td>
                                    <td><span class="policy-action rate-limit">Rate Limit</span></td>
                                    <td><span class="match-count">89</span></td>
                                    <td>
                                        <div class="effectiveness-meter">
                                            <div class="effectiveness-bar" style="width: 96.7%;"></div>
                                            <span class="effectiveness-text">96.7%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="policy-actions">
                                            <button class="btn-icon" onclick="editPolicy('policy-3')" title="Edit Policy">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn-icon" onclick="duplicatePolicy('policy-3')" title="Duplicate">
                                                <i class="fas fa-copy"></i>
                                            </button>
                                            <button class="btn-icon danger" onclick="deletePolicy('policy-3')" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>
                </div>
                
            </div>
        </div>
        
        <!-- IP Management Tab -->
        <div id="ip-management-tab" class="tab-content">
            <div class="ip-management-section">
                
                <!-- IP Management Controls -->
                <div class="ip-controls">
                    <h3 class="section-title">
                        <i class="fas fa-globe"></i>
                        IP Address Management
                    </h3>
                    
                    <div class="ip-action-bar">
                        <button class="btn btn-success" onclick="showAddIPModal()">
                            <i class="fas fa-plus"></i> Add IP Address
                        </button>
                        <button class="btn btn-primary" onclick="bulkImportIPs()">
                            <i class="fas fa-file-upload"></i> Bulk Import
                        </button>
                        <button class="btn btn-secondary" onclick="exportIPLists()">
                            <i class="fas fa-download"></i> Export Lists
                        </button>
                        <button class="btn btn-warning" onclick="scanThreatIntelligence()">
                            <i class="fas fa-radar"></i> Threat Intel Scan
                        </button>
                    </div>
                </div>
                
                <!-- IP Lists Tabs -->
                <div class="ip-lists-tabs">
                    <div class="ip-tab-navigation">
                        <button class="ip-tab-button active" data-ip-tab="whitelist">
                            <i class="fas fa-check-circle"></i> Whitelist (23)
                        </button>
                        <button class="ip-tab-button" data-ip-tab="blacklist">
                            <i class="fas fa-ban"></i> Blacklist (156)
                        </button>
                        <button class="ip-tab-button" data-ip-tab="intelligence">
                            <i class="fas fa-brain"></i> Threat Intelligence (1,247)
                        </button>
                    </div>
                    
                    <!-- Whitelist Tab -->
                    <div id="whitelist-ip-tab" class="ip-tab-content active">
                        <div class="ip-list-controls">
                            <div class="ip-filters">
                                <input type="text" id="whitelist-search" placeholder="Search whitelist..." onkeyup="searchIPList('whitelist')">
                                <select id="whitelist-filter" onchange="filterIPList('whitelist')">
                                    <option value="all">All Entries</option>
                                    <option value="permanent">Permanent Only</option>
                                    <option value="temporary">Temporary Only</option>
                                    <option value="expiring">Expiring Soon</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="ip-table-container">
                            <table class="ip-table">
                                <thead>
                                    <tr>
                                        <th>IP Address</th>
                                        <th>Reason</th>
                                        <th>Added Date</th>
                                        <th>Expires</th>
                                        <th>Hits</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="whitelist-table-body">
                                    
                                    <tr class="ip-row permanent">
                                        <td>
                                            <div class="ip-info">
                                                <span class="ip-address">192.168.1.100</span>
                                                <small class="ip-location">Internal Network</small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="ip-reason">Admin workstation</span>
                                        </td>
                                        <td><span class="ip-date">2025-01-15</span></td>
                                        <td><span class="ip-expiry permanent">Permanent</span></td>
                                        <td><span class="ip-hits">1,247</span></td>
                                        <td><span class="ip-status active">Active</span></td>
                                        <td>
                                            <div class="ip-actions">
                                                <button class="btn-icon" onclick="editIP('whitelist', 'ip-1')" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn-icon danger" onclick="removeIP('whitelist', 'ip-1')" title="Remove">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    
                                    <tr class="ip-row temporary">
                                        <td>
                                            <div class="ip-info">
                                                <span class="ip-address">203.45.67.89</span>
                                                <small class="ip-location">United Kingdom</small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="ip-reason">Trusted partner access</span>
                                        </td>
                                        <td><span class="ip-date">2025-01-20</span></td>
                                        <td><span class="ip-expiry expiring">2 hours</span></td>
                                        <td><span class="ip-hits">45</span></td>
                                        <td><span class="ip-status active">Active</span></td>
                                        <td>
                                            <div class="ip-actions">
                                                <button class="btn-icon" onclick="editIP('whitelist', 'ip-2')" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn-icon danger" onclick="removeIP('whitelist', 'ip-2')" title="Remove">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    
                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                    <!-- Blacklist Tab -->
                    <div id="blacklist-ip-tab" class="ip-tab-content">
                        <div class="ip-list-controls">
                            <div class="ip-filters">
                                <input type="text" id="blacklist-search" placeholder="Search blacklist..." onkeyup="searchIPList('blacklist')">
                                <select id="blacklist-filter" onchange="filterIPList('blacklist')">
                                    <option value="all">All Entries</option>
                                    <option value="critical">Critical Threats</option>
                                    <option value="high">High Threats</option>
                                    <option value="medium">Medium Threats</option>
                                    <option value="auto-detected">Auto-Detected</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="ip-table-container">
                            <table class="ip-table">
                                <thead>
                                    <tr>
                                        <th>IP Address</th>
                                        <th>Threat Level</th>
                                        <th>Reason</th>
                                        <th>Added Date</th>
                                        <th>Blocked Attempts</th>
                                        <th>Source</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="blacklist-table-body">
                                    
                                    <tr class="ip-row threat-critical">
                                        <td>
                                            <div class="ip-info">
                                                <span class="ip-address">45.123.45.67</span>
                                                <small class="ip-location">Unknown/Tor</small>
                                            </div>
                                        </td>
                                        <td><span class="threat-level critical">Critical</span></td>
                                        <td>
                                            <span class="ip-reason">Multiple SQL injection attempts</span>
                                        </td>
                                        <td><span class="ip-date">2025-01-24</span></td>
                                        <td><span class="blocked-attempts">47</span></td>
                                        <td><span class="ip-source auto">Auto-Detection</span></td>
                                        <td>
                                            <div class="ip-actions">
                                                <button class="btn-icon" onclick="viewIPDetails('blacklist', 'ip-3')" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button class="btn-icon" onclick="editIP('blacklist', 'ip-3')" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn-icon success" onclick="moveToWhitelist('ip-3')" title="Move to Whitelist">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    
                                    <tr class="ip-row threat-high">
                                        <td>
                                            <div class="ip-info">
                                                <span class="ip-address">198.51.100.25</span>
                                                <small class="ip-location">Russia</small>
                                            </div>
                                        </td>
                                        <td><span class="threat-level high">High</span></td>
                                        <td>
                                            <span class="ip-reason">Brute force attack on webmail</span>
                                        </td>
                                        <td><span class="ip-date">2025-01-23</span></td>
                                        <td><span class="blocked-attempts">156</span></td>
                                        <td><span class="ip-source threat-intel">Threat Intelligence</span></td>
                                        <td>
                                            <div class="ip-actions">
                                                <button class="btn-icon" onclick="viewIPDetails('blacklist', 'ip-4')" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button class="btn-icon" onclick="editIP('blacklist', 'ip-4')" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn-icon success" onclick="moveToWhitelist('ip-4')" title="Move to Whitelist">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    
                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                </div>
                
            </div>
        </div>
        
        <!-- Threat Analysis Tab -->
        <div id="threat-analysis-tab" class="tab-content">
            <div class="threat-analysis-section">
                
                <h3 class="section-title">
                    <i class="fas fa-chart-line"></i>
                    Yorkshire Champion Threat Analysis
                </h3>
                
                <!-- Threat Statistics Charts -->
                <div class="threat-charts-grid">
                    
                    <!-- Threat Types Distribution -->
                    <div class="chart-container threat-types-chart">
                        <h4>Threat Types Distribution (Last 24 Hours)</h4>
                        <div class="chart-placeholder">
                            <canvas id="threatTypesChart" width="400" height="300"></canvas>
                        </div>
                        <div class="chart-legend">
                            <div class="legend-item">
                                <span class="legend-color sql-injection"></span>
                                <span>SQL Injection (45%)</span>
                            </div>
                            <div class="legend-item">
                                <span class="legend-color xss-attack"></span>
                                <span>XSS Attacks (23%)</span>
