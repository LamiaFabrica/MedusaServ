                    </div>
                    
                    <!-- File Manager Thingamabob -->
                    <div class="thingamabob-protection-card filemanager">
                        <div class="card-header">
                            <div class="thingamabob-icon">
                                <i class="fas fa-folder-open"></i>
                            </div>
                            <div class="thingamabob-info">
                                <h4>File Manager Thingamabob</h4>
                                <p>File system protection</p>
                            </div>
                            <div class="protection-toggle">
                                <input type="checkbox" id="filemanager-protection" checked>
                                <label for="filemanager-protection" class="toggle-switch"></label>
                            </div>
