                            <button class="btn btn-sm btn-secondary" onclick="viewThingamabobLogs('webmail')">
                                View Logs
                            </button>
                        </div>
                    </div>
                    
                    <!-- Jupyter Thingamabob -->
                    <div class="thingamabob-protection-card jupyter">
                        <div class="card-header">
                            <div class="thingamabob-icon">
                                <i class="fas fa-code"></i>
                            </div>
                            <div class="thingamabob-info">
                                <h4>Jupyter Thingamabob</h4>
                                <p>Code execution monitoring</p>
                            </div>
                            <div class="protection-toggle">
                                <input type="checkbox" id="jupyter-protection" checked>
                                <label for="jupyter-protection" class="toggle-switch"></label>
                            </div>
                        </div>
                        <div class="card-stats">
                            <div class="stat-item">
                                <span class="stat-label">Sessions Monitored:</span>
                                <span class="stat-value">89</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Code Executions:</span>
                                <span class="stat-value">456</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Security Score:</span>
                                <span class="stat-value">95.2%</span>
                            </div>
                        </div>
                        <div class="card-actions">
                            <button class="btn btn-sm btn-primary" onclick="configureThingamabobSecurity('jupyter')">
                                Configure Security
