                                <span>Brute Force (18%)</span>
                            </div>
                            <div class="legend-item">
                                <span class="legend-color ddos-attack"></span>
                                <span>DDoS (10%)</span>
                            </div>
                            <div class="legend-item">
                                <span class="legend-color other"></span>
                                <span>Other (4%)</span>
