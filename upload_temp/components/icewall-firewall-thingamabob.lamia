                            </div>
                            <div class="map-threat-indicator" style="left: 50%; top: 50%;" data-country="China">
                                <div class="threat-dot critical"></div>
                                <div class="threat-tooltip">China: 243 attacks</div>
                            </div>
                            <div class="map-threat-indicator" style="left: 75%; top: 35%;" data-country="Unknown">
                                <div class="threat-dot medium"></div>
