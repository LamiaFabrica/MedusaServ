                                <span class="stat-label">Protection Level:</span>
                                <span class="stat-value">Critical</span>
                            </div>
                        </div>
                        <div class="card-actions">
                            <button class="btn btn-sm btn-primary" onclick="configureThingamabobSecurity('filemanager')">
                                Configure Security
