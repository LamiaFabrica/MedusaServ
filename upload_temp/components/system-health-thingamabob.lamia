<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Health Monitor - PFQL Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/portal-style.css">
</head>
<body>
    <div class="portal-header">
        <h1>💗 System Health Monitor</h1>
        <div class="portal-status" id="healthStatus">
            <span class="status-indicator online"></span>
            System Health: OPTIMAL
        </div>
    </div>

    <div class="service-container">
        <div class="service-controls">
            <button class="service-btn" onclick="healthService.fullHealthCheck()">🔍 Full Health Check</button>
            <button class="service-btn" onclick="healthService.quickDiagnostic()">⚡ Quick Diagnostic</button>
            <button class="service-btn" onclick="healthService.generateReport()">📊 Generate Report</button>
            <button class="service-btn" onclick="healthService.systemRepair()">🔧 System Repair</button>
        </div>

        <div class="health-dashboard" id="healthDashboard">
            <div class="health-grid">
                <div class="health-card cpu">
                    <h4>CPU Health</h4>
                    <div class="health-gauge">
                        <div class="gauge-value" id="cpuHealth">94%</div>
                    </div>
                    <div class="health-details">
                        <div>Temperature: <span id="cpuTemp">42°C</span></div>
                        <div>Load: <span id="cpuLoad">23%</span></div>
                    </div>
                </div>
                
                <div class="health-card memory">
                    <h4>Memory Health</h4>
                    <div class="health-gauge">
                        <div class="gauge-value" id="memoryHealth">87%</div>
                    </div>
                    <div class="health-details">
                        <div>Usage: <span id="memoryUsage">6.2GB/16GB</span></div>
                        <div>Errors: <span id="memoryErrors">0</span></div>
                    </div>
                </div>
                
                <div class="health-card disk">
                    <h4>Disk Health</h4>
                    <div class="health-gauge">
                        <div class="gauge-value" id="diskHealth">91%</div>
                    </div>
                    <div class="health-details">
                        <div>Free Space: <span id="diskSpace">847GB</span></div>
                        <div>SMART Status: <span id="smartStatus">PASSED</span></div>
                    </div>
                </div>
                
                <div class="health-card network">
                    <h4>Network Health</h4>
                    <div class="health-gauge">
                        <div class="gauge-value" id="networkHealth">96%</div>
                    </div>
                    <div class="health-details">
                        <div>Latency: <span id="networkLatency">12ms</span></div>
                        <div>Packets Lost: <span id="packetsLost">0.01%</span></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="health-alerts" id="healthAlerts">
            <!-- Health alerts will be populated here -->
        </div>

        <div class="service-output" id="healthOutput">
            <div>[HEALTH] System health monitor initialized</div>
            <div>[HEALTH] Connected to PsiForceDB on 172.236.23.54</div>
            <div>[HEALTH] Yorkshire Champion health standards loaded</div>
            <div>[HEALTH] Monitoring system vitals...</div>
        </div>
    </div>

    <script>
        class SystemHealthService {
            constructor() {
                this.healthData = {
                    cpu: { health: 94, temp: 42, load: 23 },
                    memory: { health: 87, usage: '6.2GB/16GB', errors: 0 },
                    disk: { health: 91, space: '847GB', smart: 'PASSED' },
                    network: { health: 96, latency: 12, packetsLost: 0.01 }
                };
                this.init();
            }

            async init() {
                await this.connectToPsiForceDB();
                this.startHealthMonitoring();
                await this.loadHealthData();
            }

            async connectToPsiForceDB() {
                try {
                    const response = await fetch('/api/pfql-routes/system/health/status', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            server: '172.236.23.54',
                            database: 'psiforcedb_system'
                        })
                    });
                    
                    if (response.ok) {
                        this.logOutput('[HEALTH] Connected to PsiForceDB health monitoring system');
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Connection failed: ${error.message}`);
                }
            }

            async fullHealthCheck() {
                this.logOutput('[HEALTH] Starting comprehensive health check...');
                try {
                    const response = await fetch('/api/pfql-routes/system/health/comprehensive', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://system:health:comprehensive',
                            server: '172.236.23.54',
                            options: {
                                checkCPU: true,
                                checkMemory: true,
                                checkDisk: true,
                                checkNetwork: true,
                                checkServices: true,
                                yorkshireStandard: true
                            }
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        this.updateHealthData(result);
                        this.displayHealthReport(result);
                        this.logOutput('[HEALTH] Comprehensive health check completed');
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Health check failed: ${error.message}`);
                }
            }

            async quickDiagnostic() {
                this.logOutput('[HEALTH] Running quick diagnostic...');
                try {
                    const response = await fetch('/api/pfql-routes/system/health/quick', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://system:health:quick',
                            server: '172.236.23.54'
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        this.logOutput(`[HEALTH] Overall system health: ${result.overallHealth}%`);
                        this.logOutput(`[HEALTH] Critical issues: ${result.criticalIssues || 0}`);
                        this.logOutput(`[HEALTH] Warnings: ${result.warnings || 0}`);
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Quick diagnostic failed: ${error.message}`);
                }
            }

            async generateReport() {
                this.logOutput('[HEALTH] Generating health report...');
                try {
                    const response = await fetch('/api/pfql-routes/system/health/report', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://system:health:report',
                            server: '172.236.23.54',
                            timeframe: '24h',
                            format: 'detailed'
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        this.displayDetailedReport(result);
                        this.logOutput('[HEALTH] Health report generated successfully');
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Report generation failed: ${error.message}`);
                }
            }

            async systemRepair() {
                const confirmRepair = confirm('This will attempt to repair detected system issues. Continue?');
                if (confirmRepair) {
                    this.logOutput('[HEALTH] Starting system repair procedures...');
                    try {
                        const response = await fetch('/api/pfql-routes/system/health/repair', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                ...window.pfqlAuth.getAuthHeaders()
                            },
                            body: JSON.stringify({
                                command: 'pf://system:repair:auto',
                                server: '172.236.23.54',
                                options: {
                                    fixPermissions: true,
                                    repairServices: true,
                                    optimizePerformance: true,
                                    cleanupTemp: true
                                }
                            })
                        });
                        
                        if (response.ok) {
                            const result = await response.json();
                            this.logOutput(`[HEALTH] Repair completed: ${result.issuesFixed} issues fixed`);
                            this.logOutput(`[HEALTH] System health improved by ${result.healthImprovement}%`);
                            await this.loadHealthData(); // Refresh health data
                        }
                    } catch (error) {
                        this.logOutput(`[ERROR] System repair failed: ${error.message}`);
                    }
                }
            }

            async loadHealthData() {
                try {
                    const response = await fetch('/api/pfql-routes/system/health/metrics', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://system:health:metrics',
                            server: '172.236.23.54'
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        this.updateHealthData(result);
                    }
                } catch (error) {
                    // Use default health data if unable to fetch real data
                    this.updateHealthDisplay();
                }
            }

            updateHealthData(data) {
                if (data) {
                    if (data.cpu) {
                        this.healthData.cpu = { ...this.healthData.cpu, ...data.cpu };
                    }
                    if (data.memory) {
                        this.healthData.memory = { ...this.healthData.memory, ...data.memory };
                    }
                    if (data.disk) {
                        this.healthData.disk = { ...this.healthData.disk, ...data.disk };
                    }
                    if (data.network) {
                        this.healthData.network = { ...this.healthData.network, ...data.network };
                    }
                }
                this.updateHealthDisplay();
                this.checkHealthAlerts();
            }

            updateHealthDisplay() {
                // CPU
                document.getElementById('cpuHealth').textContent = this.healthData.cpu.health + '%';
                document.getElementById('cpuTemp').textContent = this.healthData.cpu.temp + '°C';
                document.getElementById('cpuLoad').textContent = this.healthData.cpu.load + '%';
                
                // Memory
                document.getElementById('memoryHealth').textContent = this.healthData.memory.health + '%';
                document.getElementById('memoryUsage').textContent = this.healthData.memory.usage;
                document.getElementById('memoryErrors').textContent = this.healthData.memory.errors;
                
                // Disk
                document.getElementById('diskHealth').textContent = this.healthData.disk.health + '%';
                document.getElementById('diskSpace').textContent = this.healthData.disk.space;
                document.getElementById('smartStatus').textContent = this.healthData.disk.smart;
                
                // Network
                document.getElementById('networkHealth').textContent = this.healthData.network.health + '%';
                document.getElementById('networkLatency').textContent = this.healthData.network.latency + 'ms';
                document.getElementById('packetsLost').textContent = this.healthData.network.packetsLost + '%';
                
                // Update gauge colors based on health
                this.updateGaugeColors();
            }

            updateGaugeColors() {
                const gauges = ['cpuHealth', 'memoryHealth', 'diskHealth', 'networkHealth'];
                gauges.forEach(gaugeId => {
                    const element = document.getElementById(gaugeId);
                    const value = parseInt(element.textContent);
                    
                    if (value >= 90) {
                        element.style.color = '#4CAF50'; // Green
                    } else if (value >= 70) {
                        element.style.color = '#FF9800'; // Orange
                    } else {
                        element.style.color = '#F44336'; // Red
                    }
                });
            }

            checkHealthAlerts() {
                const alerts = [];
                
                if (this.healthData.cpu.health < 70) {
                    alerts.push({ type: 'warning', message: 'CPU health is below optimal levels', component: 'CPU' });
                }
                if (this.healthData.cpu.temp > 80) {
                    alerts.push({ type: 'error', message: 'CPU temperature is too high', component: 'CPU' });
                }
                if (this.healthData.memory.health < 70) {
                    alerts.push({ type: 'warning', message: 'Memory health degraded', component: 'Memory' });
                }
                if (this.healthData.disk.health < 70) {
                    alerts.push({ type: 'warning', message: 'Disk health issues detected', component: 'Disk' });
                }
                if (this.healthData.network.latency > 100) {
                    alerts.push({ type: 'warning', message: 'High network latency detected', component: 'Network' });
                }
                
                this.displayAlerts(alerts);
            }

            displayAlerts(alerts) {
                const container = document.getElementById('healthAlerts');
                if (alerts.length > 0) {
                    container.innerHTML = `
                        <h3>⚠️ Health Alerts</h3>
                        <div class="alerts-list">
                            ${alerts.map(alert => `
                                <div class="alert alert-${alert.type}">
                                    <strong>${alert.component}:</strong> ${alert.message}
                                    <button class="alert-action" onclick="healthService.resolveAlert('${alert.component}')">
                                        Resolve
                                    </button>
                                </div>
                            `).join('')}
                        </div>
                    `;
                } else {
                    container.innerHTML = '<div class="no-alerts">✅ No health alerts - System is healthy</div>';
                }
            }

            displayHealthReport(report) {
                const container = document.getElementById('healthAlerts');
                container.innerHTML = `
                    <h3>📊 Health Report Summary</h3>
                    <div class="report-summary">
                        <div class="summary-stat">
                            <strong>Overall Health:</strong> ${report.overallHealth || 'N/A'}%
                        </div>
                        <div class="summary-stat">
                            <strong>System Uptime:</strong> ${report.uptime || 'N/A'}
                        </div>
                        <div class="summary-stat">
                            <strong>Last Reboot:</strong> ${report.lastReboot || 'N/A'}
                        </div>
                        <div class="summary-stat">
                            <strong>Critical Issues:</strong> ${report.criticalIssues || 0}
                        </div>
                    </div>
                `;
            }

            async resolveAlert(component) {
                this.logOutput(`[HEALTH] Attempting to resolve ${component} alert...`);
                try {
                    const response = await fetch('/api/pfql-routes/system/health/resolve', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            ...window.pfqlAuth.getAuthHeaders()
                        },
                        body: JSON.stringify({
                            command: 'pf://system:health:resolve',
                            server: '172.236.23.54',
                            component: component.toLowerCase()
                        })
                    });
                    
                    if (response.ok) {
                        this.logOutput(`[HEALTH] ${component} alert resolved`);
                        await this.loadHealthData(); // Refresh health data
                    }
                } catch (error) {
                    this.logOutput(`[ERROR] Failed to resolve ${component} alert: ${error.message}`);
                }
            }

            startHealthMonitoring() {
                setInterval(async () => {
                    try {
                        await this.loadHealthData();
                    } catch (error) {
                        // Silent monitoring
                    }
                }, 15000); // Every 15 seconds
            }

            logOutput(message) {
                const output = document.getElementById('healthOutput');
                const timestamp = new Date().toLocaleTimeString();
                output.innerHTML += `<div>[${timestamp}] ${message}</div>`;
                output.scrollTop = output.scrollHeight;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            window.healthService = new SystemHealthService();
        });
    </script>
    
    <style>
        .health-dashboard {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #64B5F6;
            border-radius: 6px;
            padding: 15px;
            margin: 15px 0;
        }
        .health-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }
        .health-card {
            background: rgba(100, 181, 246, 0.1);
            border: 1px solid #64B5F6;
            border-radius: 6px;
            padding: 15px;
            text-align: center;
        }
        .health-gauge {
            margin: 15px 0;
        }
        .gauge-value {
            font-size: 32px;
            font-weight: bold;
            color: #4CAF50;
        }
        .health-details {
            text-align: left;
            font-size: 14px;
            margin-top: 10px;
        }
        .health-details div {
            margin: 5px 0;
        }
        .health-alerts {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #64B5F6;
            border-radius: 6px;
            padding: 15px;
            margin: 15px 0;
        }
        .alert {
            background: rgba(255, 152, 0, 0.1);
            border: 1px solid #FF9800;
            border-radius: 4px;
            padding: 10px;
            margin: 5px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .alert-error {
            background: rgba(244, 67, 54, 0.1);
            border-color: #F44336;
        }
        .alert-action {
            background: #64B5F6;
            border: none;
            border-radius: 4px;
            color: white;
            padding: 5px 10px;
            cursor: pointer;
            font-size: 12px;
        }
        .no-alerts {
            text-align: center;
            color: #4CAF50;
            font-weight: bold;
            padding: 20px;
        }
        .report-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 10px;
            margin: 15px 0;
        }
        .summary-stat {
            background: rgba(76, 175, 80, 0.1);
            border: 1px solid #4CAF50;
            border-radius: 4px;
            padding: 10px;
        }
    </style>
</body>
</html>