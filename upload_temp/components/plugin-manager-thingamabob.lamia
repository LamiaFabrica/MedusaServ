/*
 * Plugin Manager Thingamabob - v0.4.0
 * Yorkshire Champion Standards - Advanced Plugin Management with Drag & Drop
 * 
 * Features:
 * - .ZIP file drag & drop installation
 * - Real-time upload progress tracking
 * - Folder monitoring and auto-updates
 * - Dependency resolution
 * - Rollback support
 * 
 * © 2025 The Medusa Project | Roylepython | D Hargreaves
 */

@component "plugin_manager_thingamabob" {
    @version "0.4.0"
    @theme "enterprise_plugin_manager"
    @security_level "quantum_resistant"
    @encryption "AES_256_PQC"
    @session_management "JWT_PsiForceDB"
    
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Plugin Manager v0.4.0 - Yorkshire Champion Standards</title>
        <style>
            :root {
                --yorkshire-gold: #FFD700;
                --yorkshire-green: #228B22;
                --medusa-purple: #6B46C1;
                --quantum-blue: #00D4FF;
                --success: #10B981;
                --warning: #F59E0B;
                --danger: #EF4444;
                --drop-zone: #4C1D95;
            }

            .plugin-manager-container {
                background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
                color: white;
                padding: 30px;
                border-radius: 12px;
                font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;
            }

            .manager-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 30px;
                padding-bottom: 20px;
                border-bottom: 2px solid var(--yorkshire-gold);
            }

            .manager-title {
                font-size: 32px;
                font-weight: bold;
                background: linear-gradient(90deg, var(--yorkshire-gold), var(--medusa-purple));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .drop-zone {
                background: rgba(76, 29, 149, 0.1);
                border: 3px dashed var(--medusa-purple);
                border-radius: 16px;
                padding: 60px;
                text-align: center;
                margin-bottom: 30px;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
            }

            .drop-zone.dragover {
                background: rgba(76, 29, 149, 0.3);
                border-color: var(--yorkshire-gold);
                transform: scale(1.02);
                box-shadow: 0 20px 40px rgba(255, 215, 0, 0.2);
            }

            .drop-zone.uploading {
                background: rgba(16, 185, 129, 0.1);
                border-color: var(--success);
            }

            .drop-icon {
                font-size: 64px;
                margin-bottom: 20px;
                animation: bounce 2s infinite;
            }

            @keyframes bounce {
                0%, 100% { transform: translateY(0); }
                50% { transform: translateY(-10px); }
            }

            .drop-text {
                font-size: 20px;
                font-weight: 600;
                margin-bottom: 10px;
                color: var(--yorkshire-gold);
            }

            .drop-subtext {
                font-size: 14px;
                color: rgba(255, 255, 255, 0.6);
                margin-bottom: 20px;
            }

            .browse-button {
                background: linear-gradient(135deg, var(--medusa-purple), var(--quantum-blue));
                border: none;
                border-radius: 8px;
                padding: 12px 30px;
                color: white;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.3s ease;
            }

            .browse-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(107, 70, 193, 0.3);
            }

            .upload-progress {
                display: none;
                margin-top: 30px;
            }

            .upload-progress.active {
                display: block;
            }

            .progress-bar-container {
                background: rgba(255, 255, 255, 0.1);
                border-radius: 10px;
                height: 10px;
                overflow: hidden;
                margin-bottom: 10px;
            }

            .progress-bar {
                background: linear-gradient(90deg, var(--success), var(--yorkshire-gold));
                height: 100%;
                border-radius: 10px;
                transition: width 0.3s ease;
                position: relative;
                overflow: hidden;
            }

            .progress-bar::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(90deg, 
                    transparent, 
                    rgba(255, 255, 255, 0.3), 
                    transparent);
                animation: shimmer 2s infinite;
            }

            @keyframes shimmer {
                0% { transform: translateX(-100%); }
                100% { transform: translateX(100%); }
            }

            .upload-details {
                display: flex;
                justify-content: space-between;
                font-size: 14px;
                color: rgba(255, 255, 255, 0.8);
            }

            .plugin-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                gap: 20px;
                margin-bottom: 30px;
            }

            .plugin-card {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 215, 0, 0.2);
                border-radius: 12px;
                padding: 20px;
                transition: all 0.3s ease;
                position: relative;
            }

            .plugin-card:hover {
                transform: translateY(-3px);
                border-color: var(--yorkshire-gold);
                box-shadow: 0 15px 30px rgba(255, 215, 0, 0.1);
            }

            .plugin-status {
                position: absolute;
                top: 10px;
                right: 10px;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                animation: pulse-status 2s infinite;
            }

            .plugin-status.active {
                background: var(--success);
                box-shadow: 0 0 10px var(--success);
            }

            .plugin-status.inactive {
                background: var(--danger);
                box-shadow: 0 0 10px var(--danger);
            }

            .plugin-status.updating {
                background: var(--warning);
                box-shadow: 0 0 10px var(--warning);
            }

            @keyframes pulse-status {
                0%, 100% { opacity: 1; }
                50% { opacity: 0.5; }
            }

            .plugin-icon {
                width: 50px;
                height: 50px;
                border-radius: 10px;
                background: linear-gradient(135deg, var(--medusa-purple), var(--quantum-blue));
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
                margin-bottom: 15px;
            }

            .plugin-name {
                font-size: 18px;
                font-weight: 600;
                margin-bottom: 5px;
            }

            .plugin-version {
                font-size: 12px;
                color: rgba(255, 255, 255, 0.6);
                margin-bottom: 10px;
            }

            .plugin-description {
                font-size: 14px;
                color: rgba(255, 255, 255, 0.8);
                line-height: 1.5;
                margin-bottom: 15px;
            }

            .plugin-actions {
                display: flex;
                gap: 10px;
            }

            .plugin-button {
                flex: 1;
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 6px;
                padding: 8px;
                color: white;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.3s ease;
                text-align: center;
            }

            .plugin-button:hover {
                background: rgba(255, 255, 255, 0.2);
                border-color: var(--yorkshire-gold);
            }

            .plugin-button.primary {
                background: linear-gradient(135deg, var(--success), #059669);
                border: none;
            }

            .plugin-button.danger {
                background: linear-gradient(135deg, var(--danger), #DC2626);
                border: none;
            }

            .folder-monitor {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 215, 0, 0.2);
                border-radius: 12px;
                padding: 20px;
                margin-bottom: 30px;
            }

            .monitor-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 15px;
            }

            .monitor-title {
                font-size: 18px;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .monitor-status {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 14px;
            }

            .monitor-indicator {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--success);
                animation: pulse-status 2s infinite;
            }

            .monitored-folders {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                margin-top: 15px;
            }

            .folder-chip {
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 20px;
                padding: 6px 12px;
                font-size: 13px;
                display: flex;
                align-items: center;
                gap: 5px;
            }

            .folder-chip .remove {
                cursor: pointer;
                color: var(--danger);
                margin-left: 5px;
            }

            .recent-activity {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 215, 0, 0.2);
                border-radius: 12px;
                padding: 20px;
            }

            .activity-title {
                font-size: 18px;
                font-weight: 600;
                margin-bottom: 15px;
            }

            .activity-list {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .activity-item {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 10px;
                background: rgba(255, 255, 255, 0.05);
                border-radius: 8px;
                font-size: 14px;
            }

            .activity-icon {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.1);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .activity-details {
                flex: 1;
            }

            .activity-time {
                font-size: 12px;
                color: rgba(255, 255, 255, 0.5);
            }
        </style>
    </head>
    <body>
        <div class="plugin-manager-container">
            <div class="manager-header">
                <h1 class="manager-title">🔧 Plugin Manager</h1>
                <div class="header-actions">
                    <button class="browse-button" onclick="openPluginStore()">
                        🛒 Plugin Store
                    </button>
                    <button class="browse-button" onclick="scanForPlugins()">
                        🔍 Scan Folders
                    </button>
                </div>
            </div>

            <div class="drop-zone" id="dropZone" ondrop="handleDrop(event)" ondragover="handleDragOver(event)" 
                 ondragleave="handleDragLeave(event)">
                <div class="drop-icon">📦</div>
                <div class="drop-text">Drag & Drop Plugin ZIP Files Here</div>
                <div class="drop-subtext">Supports .zip, .tar.gz, and .medusa-plugin formats</div>
                <button class="browse-button" onclick="document.getElementById('fileInput').click()">
                    Browse Files
                </button>
                <input type="file" id="fileInput" style="display: none;" 
                       accept=".zip,.tar.gz,.medusa-plugin" 
                       onchange="handleFileSelect(event)" multiple>
                
                <div class="upload-progress" id="uploadProgress">
                    <div class="progress-bar-container">
                        <div class="progress-bar" id="progressBar" style="width: 0%"></div>
                    </div>
                    <div class="upload-details">
                        <span id="uploadFileName">Uploading...</span>
                        <span id="uploadPercent">0%</span>
                    </div>
                </div>
            </div>

            <div class="folder-monitor">
                <div class="monitor-header">
                    <div class="monitor-title">
                        <span>📁</span>
                        Folder Monitor
                    </div>
                    <div class="monitor-status">
                        <div class="monitor-indicator"></div>
                        <span>Active - Watching 3 folders</span>
                    </div>
                </div>
                <div class="monitored-folders" id="monitoredFolders">
                    <div class="folder-chip">
                        /plugins/custom <span class="remove" onclick="removeFolder(this)">×</span>
                    </div>
                    <div class="folder-chip">
                        /extensions/user <span class="remove" onclick="removeFolder(this)">×</span>
                    </div>
                    <div class="folder-chip">
                        /workspace/dev <span class="remove" onclick="removeFolder(this)">×</span>
                    </div>
                    <button class="plugin-button" onclick="addMonitorFolder()">
                        + Add Folder
                    </button>
                </div>
            </div>

            <h2 style="margin-bottom: 20px;">Installed Plugins</h2>
            <div class="plugin-grid" id="pluginGrid">
                <!-- Plugins will be dynamically loaded here -->
            </div>

            <div class="recent-activity">
                <h3 class="activity-title">Recent Activity</h3>
                <div class="activity-list" id="activityList">
                    <!-- Activity items will be loaded here -->
                </div>
            </div>
        </div>

        <script>
            class PluginManager {
                constructor() {
                    this.plugins = new Map();
                    this.uploadQueue = [];
                    this.folderWatcher = null;
                    this.monitoredFolders = new Set([
                        '/plugins/custom',
                        '/extensions/user',
                        '/workspace/dev'
                    ]);
                    this.activityLog = [];
                    this.initializeWebSocket();
                    this.loadInstalledPlugins();
                    this.startFolderMonitoring();
                }

                initializeWebSocket() {
                    this.ws = new WebSocket('wss://localhost:8443/plugin-manager');
                    
                    this.ws.onmessage = (event) => {
                        const data = JSON.parse(event.data);
                        this.handleWebSocketMessage(data);
                    };

                    this.ws.onerror = (error) => {
                        console.error('WebSocket error:', error);
                        this.reconnectWebSocket();
                    };
                }

                handleWebSocketMessage(data) {
                    switch(data.type) {
                        case 'plugin_installed':
                            this.onPluginInstalled(data.plugin);
                            break;
                        case 'plugin_updated':
                            this.onPluginUpdated(data.plugin);
                            break;
                        case 'plugin_removed':
                            this.onPluginRemoved(data.pluginId);
                            break;
                        case 'folder_change':
                            this.onFolderChange(data.folder, data.changes);
                            break;
                        case 'upload_progress':
                            this.updateUploadProgress(data.progress, data.fileName);
                            break;
                    }
                }

                async handleFileDrop(files) {
                    for (const file of files) {
                        if (this.isValidPluginFile(file)) {
                            await this.uploadPlugin(file);
                        } else {
                            this.showNotification(`Invalid file type: ${file.name}`, 'error');
                        }
                    }
                }

                isValidPluginFile(file) {
                    const validExtensions = ['.zip', '.tar.gz', '.medusa-plugin'];
                    return validExtensions.some(ext => file.name.endsWith(ext));
                }

                async uploadPlugin(file) {
                    const formData = new FormData();
                    formData.append('plugin', file);
                    
                    // Show upload progress
                    const dropZone = document.getElementById('dropZone');
                    dropZone.classList.add('uploading');
                    
                    const uploadProgress = document.getElementById('uploadProgress');
                    uploadProgress.classList.add('active');
                    
                    document.getElementById('uploadFileName').textContent = file.name;

                    try {
                        const xhr = new XMLHttpRequest();
                        
                        xhr.upload.addEventListener('progress', (e) => {
                            if (e.lengthComputable) {
                                const percentComplete = (e.loaded / e.total) * 100;
                                this.updateUploadProgress(percentComplete, file.name);
                            }
                        });

                        xhr.addEventListener('load', () => {
                            if (xhr.status === 200) {
                                const response = JSON.parse(xhr.responseText);
                                this.onPluginInstalled(response.plugin);
                                this.showNotification(`Plugin "${response.plugin.name}" installed successfully!`, 'success');
                                this.logActivity('install', response.plugin.name);
                            } else {
                                throw new Error('Upload failed');
                            }
                            
                            // Reset UI
                            setTimeout(() => {
                                dropZone.classList.remove('uploading');
                                uploadProgress.classList.remove('active');
                                document.getElementById('progressBar').style.width = '0%';
                            }, 1000);
                        });

                        xhr.addEventListener('error', () => {
                            this.showNotification('Upload failed', 'error');
                            dropZone.classList.remove('uploading');
                            uploadProgress.classList.remove('active');
                        });

                        xhr.open('POST', '/api/plugins/upload');
                        xhr.send(formData);
                        
                    } catch (error) {
                        console.error('Upload error:', error);
                        this.showNotification('Upload failed: ' + error.message, 'error');
                        dropZone.classList.remove('uploading');
                        uploadProgress.classList.remove('active');
                    }
                }

                updateUploadProgress(percent, fileName) {
                    const progressBar = document.getElementById('progressBar');
                    const percentText = document.getElementById('uploadPercent');
                    
                    progressBar.style.width = percent + '%';
                    percentText.textContent = Math.round(percent) + '%';
                    
                    if (percent >= 100) {
                        document.getElementById('uploadFileName').textContent = 'Installing ' + fileName + '...';
                    }
                }

                async loadInstalledPlugins() {
                    try {
                        const response = await fetch('/api/plugins/installed');
                        const plugins = await response.json();
                        
                        plugins.forEach(plugin => {
                            this.plugins.set(plugin.id, plugin);
                        });
                        
                        this.renderPlugins();
                    } catch (error) {
                        console.error('Failed to load plugins:', error);
                    }
                }

                renderPlugins() {
                    const grid = document.getElementById('pluginGrid');
                    
                    if (this.plugins.size === 0) {
                        grid.innerHTML = '<div class="no-plugins">No plugins installed yet</div>';
                        return;
                    }

                    grid.innerHTML = Array.from(this.plugins.values())
                        .map(plugin => this.createPluginCard(plugin))
                        .join('');
                }

                createPluginCard(plugin) {
                    return `
                        <div class="plugin-card" data-plugin-id="${plugin.id}">
                            <div class="plugin-status ${plugin.status}"></div>
                            <div class="plugin-icon">${plugin.icon || '🔌'}</div>
                            <div class="plugin-name">${plugin.name}</div>
                            <div class="plugin-version">v${plugin.version}</div>
                            <div class="plugin-description">${plugin.description}</div>
                            <div class="plugin-actions">
                                ${plugin.status === 'active' 
                                    ? `<button class="plugin-button danger" onclick="pluginManager.disablePlugin('${plugin.id}')">Disable</button>`
                                    : `<button class="plugin-button primary" onclick="pluginManager.enablePlugin('${plugin.id}')">Enable</button>`
                                }
                                <button class="plugin-button" onclick="pluginManager.configurePlugin('${plugin.id}')">Configure</button>
                                <button class="plugin-button" onclick="pluginManager.removePlugin('${plugin.id}')">Remove</button>
                            </div>
                        </div>
                    `;
                }

                async enablePlugin(pluginId) {
                    try {
                        await fetch(`/api/plugins/${pluginId}/enable`, { method: 'POST' });
                        const plugin = this.plugins.get(pluginId);
                        plugin.status = 'active';
                        this.renderPlugins();
                        this.showNotification(`Plugin "${plugin.name}" enabled`, 'success');
                        this.logActivity('enable', plugin.name);
                    } catch (error) {
                        this.showNotification('Failed to enable plugin', 'error');
                    }
                }

                async disablePlugin(pluginId) {
                    try {
                        await fetch(`/api/plugins/${pluginId}/disable`, { method: 'POST' });
                        const plugin = this.plugins.get(pluginId);
                        plugin.status = 'inactive';
                        this.renderPlugins();
                        this.showNotification(`Plugin "${plugin.name}" disabled`, 'info');
                        this.logActivity('disable', plugin.name);
                    } catch (error) {
                        this.showNotification('Failed to disable plugin', 'error');
                    }
                }

                async removePlugin(pluginId) {
                    if (!confirm('Are you sure you want to remove this plugin?')) return;
                    
                    try {
                        await fetch(`/api/plugins/${pluginId}`, { method: 'DELETE' });
                        const plugin = this.plugins.get(pluginId);
                        this.plugins.delete(pluginId);
                        this.renderPlugins();
                        this.showNotification(`Plugin "${plugin.name}" removed`, 'success');
                        this.logActivity('remove', plugin.name);
                    } catch (error) {
                        this.showNotification('Failed to remove plugin', 'error');
                    }
                }

                configurePlugin(pluginId) {
                    window.location.href = `/plugins/configure/${pluginId}`;
                }

                startFolderMonitoring() {
                    // Start monitoring folders for changes
                    this.folderWatcher = setInterval(() => {
                        this.checkFolderChanges();
                    }, 5000); // Check every 5 seconds
                }

                async checkFolderChanges() {
                    for (const folder of this.monitoredFolders) {
                        try {
                            const response = await fetch('/api/plugins/folder-check', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ folder })
                            });
                            
                            const changes = await response.json();
                            if (changes.hasChanges) {
                                this.onFolderChange(folder, changes);
                            }
                        } catch (error) {
                            console.error(`Failed to check folder ${folder}:`, error);
                        }
                    }
                }

                onFolderChange(folder, changes) {
                    if (changes.newFiles) {
                        changes.newFiles.forEach(file => {
                            this.showNotification(`New plugin detected in ${folder}: ${file}`, 'info');
                            this.autoInstallFromFolder(folder, file);
                        });
                    }
                    
                    if (changes.modifiedFiles) {
                        changes.modifiedFiles.forEach(file => {
                            this.showNotification(`Plugin updated in ${folder}: ${file}`, 'info');
                            this.autoUpdateFromFolder(folder, file);
                        });
                    }
                }

                async autoInstallFromFolder(folder, fileName) {
                    try {
                        const response = await fetch('/api/plugins/auto-install', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ folder, fileName })
                        });
                        
                        if (response.ok) {
                            const plugin = await response.json();
                            this.onPluginInstalled(plugin);
                            this.logActivity('auto-install', plugin.name);
                        }
                    } catch (error) {
                        console.error('Auto-install failed:', error);
                    }
                }

                onPluginInstalled(plugin) {
                    this.plugins.set(plugin.id, plugin);
                    this.renderPlugins();
                    
                    // Update Purple Pages documentation
                    this.documentPlugin(plugin);
                }

                async documentPlugin(plugin) {
                    // Auto-document in Purple Pages
                    await fetch('/api/purple-pages/document', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            type: 'plugin_installation',
                            plugin: {
                                id: plugin.id,
                                name: plugin.name,
                                version: plugin.version,
                                description: plugin.description
                            },
                            timestamp: new Date().toISOString()
                        })
                    });
                }

                logActivity(action, pluginName) {
                    const activity = {
                        action,
                        plugin: pluginName,
                        timestamp: new Date()
                    };
                    
                    this.activityLog.unshift(activity);
                    if (this.activityLog.length > 10) {
                        this.activityLog.pop();
                    }
                    
                    this.renderActivity();
                }

                renderActivity() {
                    const list = document.getElementById('activityList');
                    
                    list.innerHTML = this.activityLog.map(activity => {
                        const icon = this.getActivityIcon(activity.action);
                        const timeAgo = this.getTimeAgo(activity.timestamp);
                        
                        return `
                            <div class="activity-item">
                                <div class="activity-icon">${icon}</div>
                                <div class="activity-details">
                                    <div>${this.getActivityMessage(activity)}</div>
                                    <div class="activity-time">${timeAgo}</div>
                                </div>
                            </div>
                        `;
                    }).join('');
                }

                getActivityIcon(action) {
                    const icons = {
                        'install': '📥',
                        'update': '🔄',
                        'remove': '🗑️',
                        'enable': '✅',
                        'disable': '⏸️',
                        'auto-install': '🤖'
                    };
                    return icons[action] || '📦';
                }

                getActivityMessage(activity) {
                    const messages = {
                        'install': `Installed ${activity.plugin}`,
                        'update': `Updated ${activity.plugin}`,
                        'remove': `Removed ${activity.plugin}`,
                        'enable': `Enabled ${activity.plugin}`,
                        'disable': `Disabled ${activity.plugin}`,
                        'auto-install': `Auto-installed ${activity.plugin} from folder`
                    };
                    return messages[activity.action] || `${activity.action} ${activity.plugin}`;
                }

                getTimeAgo(timestamp) {
                    const seconds = Math.floor((new Date() - timestamp) / 1000);
                    
                    if (seconds < 60) return 'just now';
                    if (seconds < 3600) return `${Math.floor(seconds / 60)} min ago`;
                    if (seconds < 86400) return `${Math.floor(seconds / 3600)} hours ago`;
                    return `${Math.floor(seconds / 86400)} days ago`;
                }

                showNotification(message, type = 'info') {
                    console.log(`[${type}] ${message}`);
                    // Implement actual notification UI
                }
            }

            // Initialize Plugin Manager
            const pluginManager = new PluginManager();

            // Global event handlers
            function handleDrop(event) {
                event.preventDefault();
                event.stopPropagation();
                
                const dropZone = document.getElementById('dropZone');
                dropZone.classList.remove('dragover');
                
                const files = Array.from(event.dataTransfer.files);
                pluginManager.handleFileDrop(files);
            }

            function handleDragOver(event) {
                event.preventDefault();
                event.stopPropagation();
                
                const dropZone = document.getElementById('dropZone');
                dropZone.classList.add('dragover');
            }

            function handleDragLeave(event) {
                event.preventDefault();
                event.stopPropagation();
                
                const dropZone = document.getElementById('dropZone');
                dropZone.classList.remove('dragover');
            }

            function handleFileSelect(event) {
                const files = Array.from(event.target.files);
                pluginManager.handleFileDrop(files);
            }

            function addMonitorFolder() {
                const folder = prompt('Enter folder path to monitor:');
                if (folder) {
                    pluginManager.monitoredFolders.add(folder);
                    renderMonitoredFolders();
                }
            }

            function removeFolder(element) {
                const folderChip = element.parentElement;
                const folder = folderChip.textContent.replace(' ×', '').trim();
                pluginManager.monitoredFolders.delete(folder);
                folderChip.remove();
            }

            function openPluginStore() {
                window.location.href = '/plugins/store';
            }

            function scanForPlugins() {
                pluginManager.checkFolderChanges();
                pluginManager.showNotification('Scanning folders for new plugins...', 'info');
            }

            function renderMonitoredFolders() {
                const container = document.getElementById('monitoredFolders');
                container.innerHTML = Array.from(pluginManager.monitoredFolders).map(folder => `
                    <div class="folder-chip">
                        ${folder} <span class="remove" onclick="removeFolder(this)">×</span>
                    </div>
                `).join('') + `
                    <button class="plugin-button" onclick="addMonitorFolder()">
                        + Add Folder
                    </button>
                `;
            }

            // Load initial activity
            pluginManager.renderActivity();
        </script>
    </body>
    </html>
}