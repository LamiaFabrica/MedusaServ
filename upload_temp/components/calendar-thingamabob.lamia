/**
 * MEDUSASERV CALENDAR/ADDRESSBOOK THINGAMABOB COMPONENT
 * ====================================================
 * Enterprise calendar & addressbook thingamabob with CalDAV/CardDAV
 * © 2025 The Medusa Project | Roylepython | D Hargreaves
 */

@component "calendar_addressbook_thingamabob" {
    @version "0.4.0"
    @theme "enterprise_calendar"
    @caldav_enabled true
    @carddav_enabled true
    @ical_support true
    
    @render {
        <div class="calendar-thingamabob">
            <!-- Calendar Header Thingamabob -->
            <div class="thingamabob-header">
                <div class="thingamabob-title">
                    <div class="thingamabob-icon">📅</div>
                    <h2>Calendar & Contacts Thingamabob</h2>
                    <span class="thingamabob-badge">CalDAV/CardDAV</span>
                </div>
                <div class="thingamabob-controls">
                    <button class="thingamabob-btn new-event">📝 New Event</button>
                    <button class="thingamabob-btn new-contact">👤 New Contact</button>
                    <button class="thingamabob-btn sync">🔄 Sync</button>
                </div>
            </div>

            <!-- Calendar Interface Thingamabob -->
            <div class="thingamabob-interface">
                <!-- Calendar Sidebar Thingamabob -->
                <div class="sidebar-thingamabob">
                    <div class="calendar-section">
                        <h3>📅 Calendars</h3>
                        <div class="calendar-list">
                            <div class="calendar-item">
                                <div class="calendar-color" style="background: #6f42c1;"></div>
                                <span class="calendar-name">Work Calendar</span>
                                <span class="event-count">12</span>
                            </div>
                            <div class="calendar-item">
                                <div class="calendar-color" style="background: #28a745;"></div>
                                <span class="calendar-name">Personal</span>
                                <span class="event-count">8</span>
                            </div>
                            <div class="calendar-item">
                                <div class="calendar-color" style="background: #dc3545;"></div>
                                <span class="calendar-name">System Maintenance</span>
                                <span class="event-count">3</span>
                            </div>
                            <div class="calendar-item">
                                <div class="calendar-color" style="background: #ffc107;"></div>
                                <span class="calendar-name">Meetings</span>
                                <span class="event-count">15</span>
                            </div>
                        </div>
                        
                        <button class="add-calendar-btn">+ Add Calendar</button>
                    </div>
                    
                    <div class="contacts-section">
                        <h3>👥 Address Books</h3>
                        <div class="addressbook-list">
                            <div class="addressbook-item">
                                <div class="addressbook-icon">🏢</div>
                                <span class="addressbook-name">Business Contacts</span>
                                <span class="contact-count">156</span>
                            </div>
                            <div class="addressbook-item">
                                <div class="addressbook-icon">👤</div>
                                <span class="addressbook-name">Personal</span>
                                <span class="contact-count">89</span>
                            </div>
                            <div class="addressbook-item">
                                <div class="addressbook-icon">⚙️</div>
                                <span class="addressbook-name">System Contacts</span>
                                <span class="contact-count">12</span>
                            </div>
                        </div>
                        
                        <button class="add-addressbook-btn">+ Add Address Book</button>
                    </div>
                    
                    <div class="mini-calendar">
                        <h4>January 2025</h4>
                        <div class="calendar-grid">
                            <div class="day-header">S</div>
                            <div class="day-header">M</div>
                            <div class="day-header">T</div>
                            <div class="day-header">W</div>
                            <div class="day-header">T</div>
                            <div class="day-header">F</div>
                            <div class="day-header">S</div>
                            
                            <div class="day-cell"></div>
                            <div class="day-cell"></div>
                            <div class="day-cell"></div>
                            <div class="day-cell">1</div>
                            <div class="day-cell">2</div>
                            <div class="day-cell">3</div>
                            <div class="day-cell">4</div>
                            
                            <div class="day-cell">5</div>
                            <div class="day-cell">6</div>
                            <div class="day-cell">7</div>
                            <div class="day-cell">8</div>
                            <div class="day-cell">9</div>
                            <div class="day-cell">10</div>
                            <div class="day-cell">11</div>
                            
                            <div class="day-cell">12</div>
                            <div class="day-cell">13</div>
                            <div class="day-cell">14</div>
                            <div class="day-cell">15</div>
                            <div class="day-cell">16</div>
                            <div class="day-cell">17</div>
                            <div class="day-cell">18</div>
                            
                            <div class="day-cell">19</div>
                            <div class="day-cell">20</div>
                            <div class="day-cell">21</div>
                            <div class="day-cell">22</div>
                            <div class="day-cell">23</div>
                            <div class="day-cell today">24</div>
                            <div class="day-cell">25</div>
                            
                            <div class="day-cell">26</div>
                            <div class="day-cell">27</div>
                            <div class="day-cell">28</div>
                            <div class="day-cell">29</div>
                            <div class="day-cell">30</div>
                            <div class="day-cell">31</div>
                            <div class="day-cell"></div>
                        </div>
                    </div>
                </div>

                <!-- Main Calendar View Thingamabob -->
                <div class="calendar-main-thingamabob">
                    <div class="calendar-toolbar">
                        <div class="toolbar-left">
                            <button class="view-btn active">Month</button>
                            <button class="view-btn">Week</button>
                            <button class="view-btn">Day</button>
                            <button class="view-btn">Agenda</button>
                        </div>
                        <div class="toolbar-center">
                            <button class="nav-btn">◀</button>
                            <h3 class="current-month">January 2025</h3>
                            <button class="nav-btn">▶</button>
                        </div>
                        <div class="toolbar-right">
                            <button class="today-btn">Today</button>
                        </div>
                    </div>
                    
                    <!-- Month View Calendar -->
                    <div class="month-view">
                        <div class="calendar-header">
                            <div class="header-cell">Sunday</div>
                            <div class="header-cell">Monday</div>
                            <div class="header-cell">Tuesday</div>
                            <div class="header-cell">Wednesday</div>
                            <div class="header-cell">Thursday</div>
                            <div class="header-cell">Friday</div>
                            <div class="header-cell">Saturday</div>
                        </div>
                        
                        <div class="calendar-body">
                            <!-- Week 1 -->
                            <div class="calendar-row">
                                <div class="date-cell other-month">29</div>
                                <div class="date-cell other-month">30</div>
                                <div class="date-cell other-month">31</div>
                                <div class="date-cell">1</div>
                                <div class="date-cell">2</div>
                                <div class="date-cell">3</div>
                                <div class="date-cell">4</div>
                            </div>
                            
                            <!-- Week 2 -->
                            <div class="calendar-row">
                                <div class="date-cell">5</div>
                                <div class="date-cell">
                                    6
                                    <div class="event-dot" style="background: #28a745;"></div>
                                </div>
                                <div class="date-cell">7</div>
                                <div class="date-cell">
                                    8
                                    <div class="event-dot" style="background: #ffc107;"></div>
                                    <div class="event-dot" style="background: #6f42c1;"></div>
                                </div>
                                <div class="date-cell">9</div>
                                <div class="date-cell">10</div>
                                <div class="date-cell">11</div>
                            </div>
                            
                            <!-- Week 3 -->
                            <div class="calendar-row">
                                <div class="date-cell">12</div>
                                <div class="date-cell">
                                    13
                                    <div class="event-dot" style="background: #dc3545;"></div>
                                </div>
                                <div class="date-cell">14</div>
                                <div class="date-cell">15</div>
                                <div class="date-cell">
                                    16
                                    <div class="event-dot" style="background: #28a745;"></div>
                                </div>
                                <div class="date-cell">17</div>
                                <div class="date-cell">18</div>
                            </div>
                            
                            <!-- Week 4 -->
                            <div class="calendar-row">
                                <div class="date-cell">19</div>
                                <div class="date-cell">
                                    20
                                    <div class="event-dot" style="background: #ffc107;"></div>
                                </div>
                                <div class="date-cell">21</div>
                                <div class="date-cell">
                                    22
                                    <div class="event-dot" style="background: #6f42c1;"></div>
                                    <div class="event-dot" style="background: #ffc107;"></div>
                                </div>
                                <div class="date-cell">23</div>
                                <div class="date-cell today">
                                    24
                                    <div class="event-dot" style="background: #dc3545;"></div>
                                </div>
                                <div class="date-cell">25</div>
                            </div>
                            
                            <!-- Week 5 -->
                            <div class="calendar-row">
                                <div class="date-cell">26</div>
                                <div class="date-cell">
                                    27
                                    <div class="event-dot" style="background: #28a745;"></div>
                                </div>
                                <div class="date-cell">28</div>
                                <div class="date-cell">29</div>
                                <div class="date-cell">30</div>
                                <div class="date-cell">31</div>
                                <div class="date-cell other-month">1</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Events & Contacts Panel Thingamabob -->
                <div class="events-contacts-thingamabob">
                    <div class="panel-tabs">
                        <button class="tab-btn active">📅 Today's Events</button>
                        <button class="tab-btn">👥 Recent Contacts</button>
                    </div>
                    
                    <div class="tab-content">
                        <!-- Today's Events -->
                        <div class="events-list">
                            <div class="event-item">
                                <div class="event-time">09:00</div>
                                <div class="event-info">
                                    <div class="event-title">Team Standup</div>
                                    <div class="event-location">Conference Room A</div>
                                </div>
                                <div class="event-indicator" style="background: #6f42c1;"></div>
                            </div>
                            
                            <div class="event-item">
                                <div class="event-time">11:30</div>
                                <div class="event-info">
                                    <div class="event-title">Server Maintenance</div>
                                    <div class="event-location">Data Center</div>
                                </div>
                                <div class="event-indicator" style="background: #dc3545;"></div>
                            </div>
                            
                            <div class="event-item">
                                <div class="event-time">14:00</div>
                                <div class="event-info">
                                    <div class="event-title">Client Meeting</div>
                                    <div class="event-location">Video Call</div>
                                </div>
                                <div class="event-indicator" style="background: #ffc107;"></div>
                            </div>
                            
                            <div class="event-item">
                                <div class="event-time">16:30</div>
                                <div class="event-info">
                                    <div class="event-title">Code Review</div>
                                    <div class="event-location">Development Team</div>
                                </div>
                                <div class="event-indicator" style="background: #28a745;"></div>
                            </div>
                        </div>
                        
                        <!-- Recent Contacts -->
                        <div class="contacts-list" style="display: none;">
                            <div class="contact-item">
                                <div class="contact-avatar">👨‍💻</div>
                                <div class="contact-info">
                                    <div class="contact-name">John Developer</div>
                                    <div class="contact-email">john@medusaserv.com</div>
                                </div>
                                <div class="contact-actions">
                                    <button class="contact-btn">📧</button>
                                    <button class="contact-btn">📞</button>
                                </div>
                            </div>
                            
                            <div class="contact-item">
                                <div class="contact-avatar">👩‍🎨</div>
                                <div class="contact-info">
                                    <div class="contact-name">Sarah Designer</div>
                                    <div class="contact-email">sarah@creative.com</div>
                                </div>
                                <div class="contact-actions">
                                    <button class="contact-btn">📧</button>
                                    <button class="contact-btn">📞</button>
                                </div>
                            </div>
                            
                            <div class="contact-item">
                                <div class="contact-avatar">👨‍💼</div>
                                <div class="contact-info">
                                    <div class="contact-name">Mike Manager</div>
                                    <div class="contact-email">mike@company.com</div>
                                </div>
                                <div class="contact-actions">
                                    <button class="contact-btn">📧</button>
                                    <button class="contact-btn">📞</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="sync-status">
                        <h4>Synchronization Status</h4>
                        <div class="sync-item">
                            <span class="sync-label">CalDAV Server:</span>
                            <span class="sync-value online">Connected</span>
                        </div>
                        <div class="sync-item">
                            <span class="sync-label">CardDAV Server:</span>
                            <span class="sync-value online">Connected</span>
                        </div>
                        <div class="sync-item">
                            <span class="sync-label">Last Sync:</span>
                            <span class="sync-value">2 minutes ago</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    
    @styles {
        .calendar-thingamabob {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
            border-left: 4px solid #fd7e14;
            margin-bottom: 2rem;
        }

        .thingamabob-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #f8f9fa;
        }

        .thingamabob-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .thingamabob-icon {
            font-size: 1.5rem;
        }

        .thingamabob-title h2 {
            color: #fd7e14;
            margin: 0;
            font-size: 1.4rem;
            font-weight: 600;
        }

        .thingamabob-badge {
            background: linear-gradient(135deg, #fd7e14, #ffc107);
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .thingamabob-controls {
            display: flex;
            gap: 0.5rem;
        }

        .thingamabob-btn {
            background: #fd7e14;
            color: white;
            border: none;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .thingamabob-btn:hover {
            background: #e8690b;
            transform: translateY(-1px);
        }

        .thingamabob-interface {
            display: grid;
            grid-template-columns: 280px 1fr 320px;
            gap: 1.5rem;
            min-height: 600px;
        }

        .sidebar-thingamabob {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .calendar-section h3,
        .contacts-section h3 {
            color: #343a40;
            font-size: 1rem;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #e9ecef;
        }

        .calendar-list,
        .addressbook-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .calendar-item,
        .addressbook-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem;
            background: white;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 0.875rem;
        }

        .calendar-item:hover,
        .addressbook-item:hover {
            background: rgba(253, 126, 20, 0.1);
            transform: translateX(2px);
        }

        .calendar-color {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }

        .addressbook-icon {
            font-size: 1rem;
        }

        .calendar-name,
        .addressbook-name {
            flex: 1;
            font-weight: 500;
        }

        .event-count,
        .contact-count {
            background: rgba(0, 0, 0, 0.1);
            padding: 0.125rem 0.5rem;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .add-calendar-btn,
        .add-addressbook-btn {
            background: #fd7e14;
            color: white;
            border: none;
            padding: 0.5rem;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

        .add-calendar-btn:hover,
        .add-addressbook-btn:hover {
            background: #e8690b;
        }

        .mini-calendar h4 {
            text-align: center;
            margin-bottom: 0.75rem;
            color: #343a40;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 2px;
        }

        .day-header {
            background: #6c757d;
            color: white;
            padding: 0.25rem;
            text-align: center;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .day-cell {
            background: white;
            padding: 0.25rem;
            text-align: center;
            font-size: 0.75rem;
            min-height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .day-cell:hover {
            background: rgba(253, 126, 20, 0.1);
        }

        .day-cell.today {
            background: #fd7e14;
            color: white;
            font-weight: 600;
        }

        .calendar-main-thingamabob {
            border-right: 1px solid #e9ecef;
            padding-right: 1.5rem;
        }

        .calendar-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding: 0.75rem;
            background: #f8f9fa;
            border-radius: 6px;
        }

        .toolbar-left {
            display: flex;
            gap: 0.25rem;
        }

        .view-btn {
            background: white;
            border: 1px solid #dee2e6;
            padding: 0.375rem 0.75rem;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

        .view-btn:hover,
        .view-btn.active {
            background: #fd7e14;
            color: white;
            border-color: #fd7e14;
        }

        .toolbar-center {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .nav-btn {
            background: white;
            border: 1px solid #dee2e6;
            padding: 0.375rem 0.75rem;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .nav-btn:hover {
            background: #fd7e14;
            color: white;
        }

        .current-month {
            margin: 0;
            font-size: 1.1rem;
            color: #343a40;
            min-width: 150px;
            text-align: center;
        }

        .today-btn {
            background: #fd7e14;
            color: white;
            border: none;
            padding: 0.375rem 0.75rem;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

        .today-btn:hover {
            background: #e8690b;
        }

        .month-view {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .calendar-header {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            background: #6c757d;
        }

        .header-cell {
            padding: 1rem;
            text-align: center;
            font-weight: 600;
            color: white;
            font-size: 0.875rem;
        }

        .calendar-body {
            display: flex;
            flex-direction: column;
        }

        .calendar-row {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            border-bottom: 1px solid #e9ecef;
        }

        .calendar-row:last-child {
            border-bottom: none;
        }

        .date-cell {
            min-height: 80px;
            padding: 0.5rem;
            border-right: 1px solid #e9ecef;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
            font-weight: 600;
        }

        .date-cell:last-child {
            border-right: none;
        }

        .date-cell:hover {
            background: rgba(253, 126, 20, 0.1);
        }

        .date-cell.today {
            background: rgba(253, 126, 20, 0.2);
            color: #fd7e14;
            font-weight: bold;
        }

        .date-cell.other-month {
            color: #adb5bd;
            background: #f8f9fa;
        }

        .event-dot {
            position: absolute;
            bottom: 4px;
            left: 4px;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            margin-right: 2px;
            display: inline-block;
        }

        .event-dot:nth-child(3) {
            left: 12px;
        }

        .events-contacts-thingamabob {
            padding-left: 1.5rem;
        }

        .panel-tabs {
            display: flex;
            margin-bottom: 1rem;
            border-bottom: 1px solid #e9ecef;
        }

        .tab-btn {
            background: transparent;
            border: none;
            padding: 0.75rem 1rem;
            cursor: pointer;
            font-size: 0.875rem;
            color: #6c757d;
            border-bottom: 2px solid transparent;
            transition: all 0.2s ease;
        }

        .tab-btn:hover,
        .tab-btn.active {
            color: #fd7e14;
            border-bottom-color: #fd7e14;
        }

        .events-list,
        .contacts-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        .event-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.75rem;
            background: #f8f9fa;
            border-radius: 6px;
            position: relative;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .event-item:hover {
            background: rgba(253, 126, 20, 0.1);
            transform: translateX(2px);
        }

        .event-time {
            font-weight: 600;
            color: #6c757d;
            font-size: 0.875rem;
            min-width: 50px;
        }

        .event-info {
            flex: 1;
        }

        .event-title {
            font-weight: 600;
            color: #343a40;
            font-size: 0.875rem;
        }

        .event-location {
            color: #6c757d;
            font-size: 0.75rem;
        }

        .event-indicator {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem;
            background: #f8f9fa;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .contact-item:hover {
            background: rgba(253, 126, 20, 0.1);
            transform: translateX(2px);
        }

        .contact-avatar {
            font-size: 1.5rem;
            width: 40px;
            height: 40px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .contact-info {
            flex: 1;
        }

        .contact-name {
            font-weight: 600;
            color: #343a40;
            font-size: 0.875rem;
        }

        .contact-email {
            color: #6c757d;
            font-size: 0.75rem;
        }

        .contact-actions {
            display: flex;
            gap: 0.25rem;
        }

        .contact-btn {
            background: white;
            border: 1px solid #dee2e6;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.75rem;
            transition: all 0.2s ease;
        }

        .contact-btn:hover {
            background: #fd7e14;
            color: white;
            border-color: #fd7e14;
        }

        .sync-status {
            background: #f8f9fa;
            padding: 1rem;
            border-radius: 8px;
        }

        .sync-status h4 {
            color: #343a40;
            font-size: 0.875rem;
            margin-bottom: 0.75rem;
        }

        .sync-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.5rem;
            font-size: 0.875rem;
        }

        .sync-item:last-child {
            margin-bottom: 0;
        }

        .sync-label {
            color: #6c757d;
        }

        .sync-value {
            font-weight: 600;
            color: #343a40;
        }

        .sync-value.online {
            color: #28a745;
        }

        /* Responsive Design */
        @media (max-width: 1200px) {
            .thingamabob-interface {
                grid-template-columns: 250px 1fr 280px;
            }
        }

        @media (max-width: 900px) {
            .thingamabob-interface {
                grid-template-columns: 1fr;
                grid-template-rows: auto auto auto;
                gap: 1rem;
            }

            .thingamabob-header {
                flex-direction: column;
                gap: 1rem;
            }

            .calendar-toolbar {
                flex-direction: column;
                gap: 1rem;
            }

            .header-cell {
                padding: 0.5rem;
            }

            .date-cell {
                min-height: 60px;
            }
        }
    }
}