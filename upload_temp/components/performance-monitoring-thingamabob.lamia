    font-weight: bold;
}

.efficiency-badge {
    background: #4CAF50;
    color: white;
    padding: 4px 12px;
    border-radius: 15px;
    font-size: 0.8em;
    font-weight: bold;
    display: inline-block;
    margin-top: 10px;
}

.health-bar {
    width: 100%;
    height: 8px;
    background: rgba(255,255,255,0.1);
    border-radius: 4px;
    overflow: hidden;
    margin-top: 15px;
}

.health-fill {
    height: 100%;
    background: linear-gradient(90deg, #4CAF50, #8BC34A);
    transition: width 0.3s ease;
}

.metrics-chart-container {
    background: rgba(0,0,0,0.3);
    padding: 20px;
    border-radius: 15px;
    margin-bottom: 30px;
}

.chart-controls {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
}

.component-performance-grid {
    display: grid;
    gap: 15px;
}

.component-performance-item {
    background: rgba(0,0,0,0.3);
    padding: 20px;
    border-radius: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-left: 4px solid transparent;
    transition: all 0.3s ease;
}

.component-performance-item.excellent {
    border-left-color: #4CAF50;
    background: linear-gradient(135deg, rgba(76, 175, 80, 0.1), rgba(0,0,0,0.3));
}

.component-performance-item.good {
    border-left-color: #FF9800;
    background: linear-gradient(135deg, rgba(255, 152, 0, 0.1), rgba(0,0,0,0.3));
}

.component-info {
    display: flex;
    align-items: center;
    gap: 15px;
}

.component-icon {
    font-size: 1.5em;
}

.component-name {
    font-weight: bold;
    font-size: 1.1em;
}

.performance-metrics {
    display: flex;
    gap: 20px;
    align-items: center;
}

.metric {
    text-align: center;
}

.metric-label {
    display: block;
    font-size: 0.8em;
    color: #ccc;
}

.metric-value {
    font-weight: bold;
    font-size: 1.1em;
    color: #4CAF50;
}

.yorkshire-multiplier {
    background: linear-gradient(45deg, #FFD700, #FFA500);
    color: #000;
    padding: 8px 15px;
    border-radius: 20px;
    font-weight: bold;
    font-size: 1.1em;
    animation: multiplierGlow 3s infinite;
}

/* Real-time monitoring styles */
.live-metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.live-metric-card {
    background: rgba(0,0,0,0.4);
    padding: 20px;
    border-radius: 15px;
    text-align: center;
}

.metric-gauge {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: conic-gradient(#4CAF50 0deg, #4CAF50 var(--angle, 90deg), #333 var(--angle, 90deg));
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 20px auto;
    position: relative;
}

.gauge-value {
    font-size: 1.2em;
    font-weight: bold;
    color: white;
}

.activity-feed {
    background: rgba(0,0,0,0.4);
    padding: 20px;
    border-radius: 15px;
    margin-top: 20px;
}

.activity-log {
    height: 300px;
    overflow-y: auto;
    background: #000;
    padding: 15px;
    border-radius: 10px;
    font-family: 'Courier New', monospace;
    font-size: 14px;
}

/* Optimization styles */
.recommendation-card {
    background: rgba(0,0,0,0.4);
    border-radius: 10px;
    padding: 20px;
    margin: 15px 0;
    border-left: 4px solid transparent;
}

.recommendation-card.high-impact {
    border-left-color: #f44336;
}

.recommendation-card.medium-impact {
    border-left-color: #FF9800;
}

.recommendation-card.low-impact {
    border-left-color: #4CAF50;
}

.impact-badge {
    padding: 4px 12px;
    border-radius: 15px;
    font-size: 0.8em;
    font-weight: bold;
    color: white;
}

.impact-badge.high {
    background: #f44336;
}

.impact-badge.medium {
    background: #FF9800;
}

.impact-badge.low {
    background: #4CAF50;
}

.recommendation-actions {
    margin-top: 15px;
    display: flex;
    gap: 10px;
}

.toggle-switch {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 15px 0;
    cursor: pointer;
}

.toggle-slider {
    width: 50px;
    height: 25px;
    background: #ccc;
    border-radius: 25px;
    position: relative;
    transition: background 0.3s ease;
}

.toggle-slider:before {
    content: '';
    position: absolute;
    width: 21px;
    height: 21px;
    border-radius: 50%;
    background: white;
    top: 2px;
    left: 2px;
    transition: transform 0.3s ease;
}

input:checked + .toggle-slider {
    background: #4CAF50;
}

input:checked + .toggle-slider:before {
    transform: translateX(25px);
}

/* Alert styles */
.alert-item {
    display: flex;
    gap: 15px;
    padding: 15px;
    border-radius: 10px;
    margin: 10px 0;
    background: rgba(0,0,0,0.3);
    border-left: 4px solid transparent;
}

.alert-item.success {
    border-left-color: #4CAF50;
}

.alert-icon {
    font-size: 1.5em;
    color: #4CAF50;
}

.threshold-item {
    display: flex;
    align-items: center;
    gap: 15px;
    margin: 15px 0;
    padding: 10px;
    background: rgba(0,0,0,0.2);
    border-radius: 8px;
}

.threshold-item label {
    min-width: 200px;
    font-weight: bold;
}

.threshold-item input {
    width: 100px;
}

.current-value {
    color: #4CAF50;
    font-weight: bold;
}

/* Report styles */
.report-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    padding: 20px;
    background: rgba(0,0,0,0.3);
    border-radius: 10px;
}

.metrics-checkboxes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
    margin-top: 10px;
}

.report-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px;
    background: rgba(0,0,0,0.3);
    border-radius: 10px;
    margin: 10px 0;
}

.report-actions {
    display: flex;
    gap: 10px;
}

/* Animations */
@keyframes performancePulse {
    0%, 100% { text-shadow: 0 0 10px rgba(255, 152, 0, 0.5); }
    50% { text-shadow: 0 0 20px rgba(255, 152, 0, 0.8), 0 0 30px rgba(255, 152, 0, 0.6); }
}

@keyframes championGlow {
    0%, 100% { box-shadow: 0 0 10px rgba(255, 215, 0, 0.5); }
    50% { box-shadow: 0 0 20px rgba(255, 215, 0, 0.8), 0 0 30px rgba(255, 152, 0, 0.6); }
}

@keyframes championPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

@keyframes multiplierGlow {
    0%, 100% { box-shadow: 0 0 5px rgba(255, 215, 0, 0.5); }
    50% { box-shadow: 0 0 15px rgba(255, 215, 0, 0.8), 0 0 25px rgba(255, 152, 0, 0.6); }
}
</style>

<script>
// Performance Monitoring JavaScript
let autoRefreshEnabled = true;
let refreshInterval = 2000;
let autoRefreshTimer = null;

function showPerformanceTab(tabName) {
    // Hide all tab contents
    const contents = document.querySelectorAll('.tab-content');
    contents.forEach(content => content.classList.remove('active'));
    
    // Remove active from all buttons
    const buttons = document.querySelectorAll('.tab-button');
    buttons.forEach(button => button.classList.remove('active'));
    
    // Show selected tab and mark button as active
    document.getElementById(tabName + '-tab').classList.add('active');
    event.target.classList.add('active');
    
    // Initialize tab-specific functionality
    initializeTab(tabName);
}

function initializeTab(tabName) {
    switch(tabName) {
        case 'real-time':
            startRealTimeMonitoring();
            break;
        case 'historical':
            loadHistoricalData('7d');
            break;
        case 'optimization':
            loadOptimizationRecommendations();
            break;
        case 'alerts':
            loadActiveAlerts();
            break;
    }
}

function startRealTimeMonitoring() {
    if (autoRefreshTimer) {
        clearInterval(autoRefreshTimer);
    }
    
    if (autoRefreshEnabled) {
        autoRefreshTimer = setInterval(updateLiveMetrics, refreshInterval);
    }
    
    // Initial load
    updateLiveMetrics();
}

function updateLiveMetrics() {
    // Simulate real-time data updates
    const cpuUsage = Math.random() * 40 + 20; // 20-60%
    const memoryUsage = Math.random() * 30 + 40; // 40-70%
    
    // Update gauges
    updateGauge('cpu-gauge', cpuUsage);
    updateGauge('memory-gauge', memoryUsage);
    
    // Update activity log
    addActivityLogEntry();
    
    // Update Yorkshire Champion score
    const championScore = 14.5 + Math.random() * 1.0;
    document.getElementById('yorkshire-score').textContent = championScore.toFixed(1);
}

function updateGauge(gaugeId, value) {
    const gauge = document.getElementById(gaugeId);
    if (gauge) {
        const fill = gauge.querySelector('.gauge-fill');
        const valueDisplay = gauge.querySelector('.gauge-value');
        
        const angle = (value / 100) * 180; // Convert percentage to degrees
        fill.style.transform = `rotate(${angle}deg)`;
        valueDisplay.textContent = Math.round(value) + '%';
    }
}

function addActivityLogEntry() {
    const activityLog = document.getElementById('activity-log');
    if (!activityLog) return;
    
    const activities = [
        'ICEWALL Firewall: Blocked 23 suspicious requests',
        'Database TRIFORCE: Query optimization completed in 0.05s',
        'LAMIA WebServer: Template cache hit rate 94.2%',
        'Testing Framework: All 847 tests passed successfully',
        'Performance Monitor: Yorkshire Champion score maintained at 15.0x'
    ];
    
    const timestamp = new Date().toLocaleTimeString();
    const activity = activities[Math.floor(Math.random() * activities.length)];
    const entry = document.createElement('div');
    entry.innerHTML = `<span style="color: #00BFFF;">[${timestamp}]</span> <span style="color: #4CAF50;">${activity}</span>`;
    
    activityLog.appendChild(entry);
    activityLog.scrollTop = activityLog.scrollHeight;
    
    // Keep only last 50 entries
    while (activityLog.children.length > 50) {
        activityLog.removeChild(activityLog.firstChild);
    }
}

function toggleAutoRefresh() {
    autoRefreshEnabled = !autoRefreshEnabled;
    const btn = document.getElementById('auto-refresh-btn');
    
    if (autoRefreshEnabled) {
        btn.innerHTML = '<i class="fas fa-sync-alt"></i> Auto Refresh: ON';
        btn.className = 'btn btn-success';
        startRealTimeMonitoring();
    } else {
        btn.innerHTML = '<i class="fas fa-sync-alt"></i> Auto Refresh: OFF';
        btn.className = 'btn btn-secondary';
        if (autoRefreshTimer) {
            clearInterval(autoRefreshTimer);
        }
    }
}

function loadHistoricalData(timeRange) {
    // Simulate loading historical data
    console.log(`Loading historical data for: ${timeRange}`);
    
    // Update active button
    const buttons = document.querySelectorAll('.range-btn');
    buttons.forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');
    
    // Simulate data loading
    setTimeout(() => {
        populateHistoricalCharts(timeRange);
        populateSummaryTable(timeRange);
    }, 500);
}

function populateHistoricalCharts(timeRange) {
    // This would integrate with Chart.js or similar library
    console.log(`Populating charts for ${timeRange}`);
}

function populateSummaryTable(timeRange) {
    const tableBody = document.getElementById('summary-table-body');
    if (!tableBody) return;
    
    const metrics = [
        { name: 'Response Time', current: '0.12s', avg7d: '0.13s', avg30d: '0.15s', best: '0.08s', worst: '0.22s', trend: '↗' },
        { name: 'Throughput', current: '45,672 req/s', avg7d: '43,234 req/s', avg30d: '41,892 req/s', best: '52,341 req/s', worst: '38,492 req/s', trend: '↗' },
        { name: 'CPU Usage', current: '31%', avg7d: '33%', avg30d: '35%', best: '28%', worst: '42%', trend: '↘' },
        { name: 'Memory Usage', current: '48%', avg7d: '51%', avg30d: '53%', best: '45%', worst: '67%', trend: '↘' },
        { name: 'Yorkshire Score', current: '15.0x', avg7d: '14.8x', avg30d: '14.5x', best: '18.2x', worst: '12.3x', trend: '↗' }
    ];
    
    tableBody.innerHTML = '';
    metrics.forEach(metric => {
        const row = document.createElement('tr');
        row.innerHTML = `
            <td>${metric.name}</td>
            <td><strong>${metric.current}</strong></td>
            <td>${metric.avg7d}</td>
            <td>${metric.avg30d}</td>
            <td style="color: #4CAF50;">${metric.best}</td>
            <td style="color: #f44336;">${metric.worst}</td>
            <td style="color: ${metric.trend === '↗' ? '#4CAF50' : '#f44336'}; font-size: 1.2em;">${metric.trend}</td>
        `;
        tableBody.appendChild(row);
    });
}

function loadOptimizationRecommendations() {
    console.log('Loading optimization recommendations');
}

function loadActiveAlerts() {
    console.log('Loading active alerts');
}

function generateReport() {
    const reportType = document.getElementById('report-type').value;
    const reportFormat = document.getElementById('report-format').value;
    
    // Simulate report generation
    alert(`Generating ${reportType} report in ${reportFormat} format...`);
    
    // In real implementation, this would trigger a server-side report generation
    setTimeout(() => {
        alert('Report generated successfully! Download started.');
    }, 2000);
}

// Initialize when page loads
document.addEventListener('DOMContentLoaded', function() {
    // Start with overview tab
    initializeTab('overview');
    
    // Update metrics every 5 seconds on overview
    setInterval(() => {
        if (document.getElementById('overview-tab').classList.contains('active')) {
            updateOverviewMetrics();
        }
    }, 5000);
});

function updateOverviewMetrics() {
    // Simulate metric updates
    const responseTime = (0.08 + Math.random() * 0.08).toFixed(3);
    const throughput = Math.floor(44000 + Math.random() * 4000);
    const resourceUsage = Math.floor(28 + Math.random() * 8);
    
    if (document.getElementById('response-time')) {
        document.getElementById('response-time').textContent = responseTime + 's';
    }
    if (document.getElementById('throughput')) {
        document.getElementById('throughput').textContent = throughput.toLocaleString();
    }
    if (document.getElementById('resource-usage')) {
        document.getElementById('resource-usage').textContent = resourceUsage + '%';
    }
}
</script>}
