}

.kpi-card.throughput {
    border: 2px solid #00BFFF;
    box-shadow: 0 0 15px rgba(0, 191, 255, 0.3);
}

.kpi-card.resource-usage {
    border: 2px solid #9C27B0;
    box-shadow: 0 0 15px rgba(156, 39, 176, 0.3);
}

.kpi-value {
    font-size: 2.5em;
    font-weight: bold;
    margin: 10px 0;
    color: #fff;
    text-shadow: 0 0 10px currentColor;
}

.champion-indicator {
