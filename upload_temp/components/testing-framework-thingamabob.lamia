    gap: 15px;
}

.benchmark-bar {
    flex: 1;
    height: 8px;
    background: rgba(255,255,255,0.1);
    border-radius: 4px;
    overflow: hidden;
}

.benchmark-fill.yorkshire-champion {
    background: linear-gradient(90deg, #FFD700, #FFA500);
    animation: championPulse 2s infinite;
}

.security-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
}

.security-category {
    background: rgba(0,0,0,0.3);
    padding: 20px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.1);
}

.test-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px;
    margin: 5px 0;
    background: rgba(255,255,255,0.05);
    border-radius: 5px;
}

.test-item.passed .test-status {
    color: #4CAF50;
    font-weight: bold;
}

.test-item.yorkshire .test-status {
    background: linear-gradient(45deg, #FFD700, #FFA500);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: bold;
}

.toggle-switch {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 10px 0;
    cursor: pointer;
}

.toggle-slider {
    width: 50px;
    height: 25px;
    background: #ccc;
    border-radius: 25px;
    position: relative;
    transition: background 0.3s ease;
}

.toggle-slider:before {
    content: '';
    position: absolute;
    width: 21px;
    height: 21px;
    border-radius: 50%;
    background: white;
    top: 2px;
    left: 2px;
    transition: transform 0.3s ease;
}

input:checked + .toggle-slider {
    background: #4CAF50;
}

input:checked + .toggle-slider:before {
    transform: translateX(25px);
}

@keyframes testingPulse {
    0%, 100% { text-shadow: 0 0 10px rgba(76, 175, 80, 0.5); }
    50% { text-shadow: 0 0 20px rgba(76, 175, 80, 0.8), 0 0 30px rgba(76, 175, 80, 0.6); }
}

@keyframes championGlow {
    0%, 100% { box-shadow: 0 0 10px rgba(255, 215, 0, 0.5); }
    50% { box-shadow: 0 0 20px rgba(255, 215, 0, 0.8), 0 0 30px rgba(255, 152, 0, 0.6); }
}

@keyframes championPulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
}
</style>

<script>
// Testing Framework JavaScript Functions
function showTestingTab(tabName) {
    // Hide all tab contents
    const contents = document.querySelectorAll('.tab-content');
    contents.forEach(content => content.classList.remove('active'));
    
    // Remove active from all buttons
    const buttons = document.querySelectorAll('.tab-button');
    buttons.forEach(button => button.classList.remove('active'));
    
    // Show selected tab and mark button as active
    document.getElementById(tabName + '-tab').classList.add('active');
    event.target.classList.add('active');
}

function runSelectedTests() {
    const testSelection = document.getElementById('test-selection').value;
    const environment = document.getElementById('test-environment').value;
    
    // Show progress container
    document.getElementById('test-progress-container').style.display = 'block';
    
    // Disable run button, enable stop button
    document.getElementById('run-tests-btn').disabled = true;
    document.getElementById('stop-tests-btn').disabled = false;
    
    // Clear output
    const output = document.getElementById('test-output');
    output.innerHTML = '<div class="output-line system">Initializing test runner...</div>';
    
    // Simulate test execution
    simulateTestExecution(testSelection, environment);
}

function simulateTestExecution(testSelection, environment) {
    const output = document.getElementById('test-output');
    const progressFill = document.getElementById('progress-fill');
    const progressText = document.getElementById('progress-text');
    const progressPercentage = document.getElementById('progress-percentage');
    
    let currentTest = 0;
    const totalTests = testSelection === 'all' ? 847 : 
                      testSelection === 'security' ? 156 :
                      testSelection === 'performance' ? 98 : 234;
    
    const testRunner = setInterval(() => {
        currentTest++;
        const progress = (currentTest / totalTests) * 100;
        
        // Update progress bar
        progressFill.style.width = progress + '%';
        progressText.textContent = `Running test ${currentTest}/${totalTests}`;
        progressPercentage.textContent = Math.round(progress) + '%';
        
        // Add test output
        const testName = generateTestName(testSelection, currentTest);
        const status = Math.random() > 0.02 ? 'PASSED' : 'FAILED';
        const duration = (Math.random() * 2 + 0.1).toFixed(3);
        
        const outputClass = status === 'PASSED' ? 'success' : 'error';
        output.innerHTML += `<div class="output-line ${outputClass}">[${currentTest.toString().padStart(3, '0')}] ${testName} - ${status} (${duration}s)</div>`;
        
        // Auto-scroll to bottom
        output.scrollTop = output.scrollHeight;
        
        // Complete when all tests are done
        if (currentTest >= totalTests) {
            clearInterval(testRunner);
            completeTestExecution(totalTests, currentTest);
        }
    }, 50);
    
    // Store interval ID for stopping
    window.currentTestRunner = testRunner;
}

function generateTestName(testSelection, index) {
    const names = {
        security: [
            'ICEWALL SQL Injection Prevention',
            'Quantum Encryption Validation',
            'XSS Protection Framework',
            'CSRF Token Verification',
            'Policy Enforcement Engine',
            'Threat Detection System'
        ],
        performance: [
            'Yorkshire Champion Response Time',
            'Database Query Optimization',
            'Memory Usage Validation',
            'Concurrent Request Handling',
            'Cache Performance Test'
        ],
        all: [
            'Component Integration Test',
            'API Endpoint Validation',
            'Database Connection Test',
            'LAMIA Template Rendering',
            'Security Policy Check'
        ]
    };
    
    const testNames = names[testSelection] || names.all;
    return testNames[index % testNames.length] + ` #${index}`;
}

function completeTestExecution(totalTests, completed) {
    const output = document.getElementById('test-output');
    const passed = Math.floor(totalTests * 0.987);
    const failed = totalTests - passed;
    
    output.innerHTML += `<div class="output-line system">Test execution completed!</div>`;
    output.innerHTML += `<div class="output-line success">Tests passed: ${passed}/${totalTests}</div>`;
    if (failed > 0) {
        output.innerHTML += `<div class="output-line error">Tests failed: ${failed}</div>`;
    }
    output.innerHTML += `<div class="output-line system">Yorkshire Champion status: ACHIEVED</div>`;
    
    // Reset buttons
    document.getElementById('run-tests-btn').disabled = false;
    document.getElementById('stop-tests-btn').disabled = true;
    
    // Hide progress after 3 seconds
    setTimeout(() => {
        document.getElementById('test-progress-container').style.display = 'none';
    }, 3000);
}

function stopTests() {
    if (window.currentTestRunner) {
        clearInterval(window.currentTestRunner);
        const output = document.getElementById('test-output');
        output.innerHTML += '<div class="output-line warning">Test execution stopped by user.</div>';
        
        // Reset buttons
        document.getElementById('run-tests-btn').disabled = false;
        document.getElementById('stop-tests-btn').disabled = true;
        
        // Hide progress
        document.getElementById('test-progress-container').style.display = 'none';
    }
}

function clearTestOutput() {
    document.getElementById('test-output').innerHTML = 
        '<div class="output-line system">Output cleared. Ready for new test run.</div>';
}

function exportTestOutput() {
    const output = document.getElementById('test-output').textContent;
    const blob = new Blob([output], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'test-output-' + new Date().toISOString().slice(0,19).replace(/:/g, '-') + '.txt';
    a.click();
    URL.revokeObjectURL(url);
}

function runTestSuite(suiteName) {
    document.getElementById('test-selection').value = suiteName;
    showTestingTab('test-runner');
    setTimeout(runSelectedTests, 500);
}

// Initialize charts and update data periodically
document.addEventListener('DOMContentLoaded', function() {
    // Update metrics every 30 seconds
    setInterval(updateMetrics, 30000);
    
    // Initialize with current data
    updateMetrics();
});

function updateMetrics() {
    // Simulate metric updates
    const totalTests = 847 + Math.floor(Math.random() * 10);
    const passRate = (98.5 + Math.random() * 1.0).toFixed(1);
    const avgDuration = (1.1 + Math.random() * 0.3).toFixed(1);
    
    document.getElementById('total-tests').textContent = totalTests;
    document.getElementById('pass-rate').textContent = passRate + '%';
    document.getElementById('avg-duration').textContent = avgDuration + 's';
}
</script>}
