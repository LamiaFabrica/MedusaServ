// Security validation
if (!defined('LAMIA_SECURE') || !LAMIA_SECURE) {
    http_response_code(403);
    exit('Access Denied');
}

// Include MedusaServ core
require_once __DIR__ . '/../../../include/medusa_core.php';
require_once __DIR__ . '/../../../include/medusa_auth.php';

// Verify authentication and admin privileges
if (!MedusaAuth::verify_session() || !MedusaAuth::has_admin_privileges()) {
    http_response_code(401);
    exit(json_encode(['error' => 'Unauthorized access']));
}
