    text-align: center;
    margin-top: 80px;
}

@keyframes gatewayPulse {
    0%, 100% { text-shadow: 0 0 10px rgba(156, 39, 176, 0.5); }
    50% { text-shadow: 0 0 20px rgba(156, 39, 176, 0.8), 0 0 30px rgba(156, 39, 176, 0.6); }
}

@keyframes championGlow {
    0%, 100% { box-shadow: 0 0 10px rgba(255, 215, 0, 0.5); }
    50% { box-shadow: 0 0 20px rgba(255, 215, 0, 0.8), 0 0 30px rgba(255, 152, 0, 0.6); }
}

@keyframes championPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}
</style>

<script>
// API Gateway JavaScript Functions
let feedActive = true;
let feedUpdateTimer = null;

function showGatewayTab(tabName) {
    // Hide all tab contents
    const contents = document.querySelectorAll('.tab-content');
    contents.forEach(content => content.classList.remove('active'));
    
    // Remove active from all buttons
    const buttons = document.querySelectorAll('.tab-button');
    buttons.forEach(button => button.classList.remove('active'));
    
    // Show selected tab and mark button as active
    document.getElementById(tabName + '-tab').classList.add('active');
    event.target.classList.add('active');
    
    // Initialize tab-specific functionality
    initializeGatewayTab(tabName);
}

function initializeGatewayTab(tabName) {
    switch(tabName) {
        case 'overview':
            startActivityFeed();
            break;
        case 'endpoints':
            loadEndpoints();
            break;
        case 'monitoring':
            initializeCharts();
            break;
    }
}

function startActivityFeed() {
    if (feedUpdateTimer) {
        clearInterval(feedUpdateTimer);
    }
    
    if (feedActive) {
        feedUpdateTimer = setInterval(updateActivityFeed, 2000);
    }
    
    // Initial load
    updateActivityFeed();
}

function updateActivityFeed() {
    const activityLog = document.getElementById('api-activity-log');
    if (!activityLog) return;
    
    const activities = [
        { type: 'success', message: 'GET /api/v1/thingamabobs - 200 OK (0.05ms) - Yorkshire Champion performance', icon: '✅' },
        { type: 'success', message: 'POST /api/v1/thingamabobs/icewall/action - 201 Created (0.12ms)', icon: '🚀' },
        { type: 'info', message: 'WebSocket connection established - Client: 172.16.0.45', icon: '🔌' },
        { type: 'security', message: 'ICEWALL: Blocked suspicious request from 192.168.1.100', icon: '🛡️' },
        { type: 'champion', message: 'Yorkshire Champion multiplier achieved: 15.0x on performance endpoint', icon: '🏆' },
        { type: 'success', message: 'GET /api/v1/performance/yorkshire-champion - 200 OK (0.03ms)', icon: '⚡' },
        { type: 'info', message: 'Rate limit applied: 234/15000 requests this minute', icon: '⏱️' },
        { type: 'success', message: 'PUT /api/v1/security/policies - 200 OK (0.08ms)', icon: '🔐' }
    ];
    
    const randomActivity = activities[Math.floor(Math.random() * activities.length)];
    const timestamp = new Date().toLocaleTimeString();
    
    const entry = document.createElement('div');
    entry.className = `activity-entry ${randomActivity.type}`;
    entry.innerHTML = `
        <span class="activity-time">[${timestamp}]</span>
        <span class="activity-icon">${randomActivity.icon}</span>
        <span class="activity-message">${randomActivity.message}</span>
    `;
    
    activityLog.appendChild(entry);
    activityLog.scrollTop = activityLog.scrollHeight;
    
    // Keep only last 50 entries
    while (activityLog.children.length > 50) {
        activityLog.removeChild(activityLog.firstChild);
    }
    
    // Update stats
    updateGatewayStats();
}

function updateGatewayStats() {
    // Simulate stat updates
    const currentRps = Math.floor(15000 + Math.random() * 2000);
    const uptimePercent = (99.95 + Math.random() * 0.04).toFixed(2);
    
    document.getElementById('requests-per-second').textContent = currentRps.toLocaleString();
    document.getElementById('uptime').textContent = uptimePercent + '%';
    
    const throughputDisplay = document.getElementById('throughput-display');
    if (throughputDisplay) {
        throughputDisplay.textContent = currentRps.toLocaleString() + ' req/s';
    }
}

function toggleFeed() {
    feedActive = !feedActive;
    const btn = document.getElementById('pause-feed');
    
    if (feedActive) {
        btn.innerHTML = '⏸️ Pause';
        startActivityFeed();
    } else {
        btn.innerHTML = '▶️ Resume';
        if (feedUpdateTimer) {
            clearInterval(feedUpdateTimer);
        }
    }
}

function showEndpointCategory(category) {
    // Hide all categories
    const categories = document.querySelectorAll('.endpoint-category');
    categories.forEach(cat => cat.classList.remove('active'));
    
    // Remove active from all tabs
    const tabs = document.querySelectorAll('.category-tab');
    tabs.forEach(tab => tab.classList.remove('active'));
    
    // Show selected category
    document.getElementById(category + '-endpoints').classList.add('active');
    event.target.classList.add('active');
}

function createNewEndpoint() {
    // Simulate endpoint creation
    alert('New endpoint creation dialog would open here');
}

function testEndpoint(endpoint) {
    // Simulate endpoint testing
    console.log(`Testing endpoint: ${endpoint}`);
    
    // Mock API response
    const mockResponse = {
        status: 200,
        response_time: Math.random() * 50 + 20,
        yorkshire_champion_score: 15.0 + Math.random() * 3,
        data: { message: 'Yorkshire Champion API response', endpoint: endpoint }
    };
    
    alert(`Endpoint test successful!\nStatus: ${mockResponse.status}\nResponse Time: ${mockResponse.response_time.toFixed(2)}ms\nYorkshire Score: ${mockResponse.yorkshire_champion_score.toFixed(1)}x`);
}

function editEndpoint(endpoint) {
    alert(`Edit endpoint: ${endpoint}`);
}

function viewEndpointDocs(endpoint) {
    alert(`Documentation for: ${endpoint}`);
}

function executeApiRequest() {
    const method = document.getElementById('method-selector').value;
    const url = document.getElementById('endpoint-url').value;
    const headers = document.getElementById('request-headers').value;
    const body = document.getElementById('request-body').value;
    
    const responseContainer = document.getElementById('api-response');
    
    // Simulate API request
    responseContainer.innerHTML = `
        <div style="color: #4CAF50;">✅ ${method} ${url}</div>
        <div style="color: #00BFFF;">Status: 200 OK</div>
        <div style="color: #FF9800;">Response Time: 0.${Math.floor(Math.random() * 99 + 1)}ms</div>
        <div style="color: #FFD700;">Yorkshire Champion: 15.0x multiplier achieved!</div>
        <br>
        <div style="color: #ccc;">Response Headers:</div>
        <div style="color: #888;">Content-Type: application/json</div>
        <div style="color: #888;">X-Yorkshire-Champion-Score: 15.0</div>
        <div style="color: #888;">X-Response-Time: 0.${Math.floor(Math.random() * 99 + 1)}ms</div>
        <br>
        <div style="color: #ccc;">Response Body:</div>
        <div style="color: #4CAF50;">{
    "status": "success",
    "yorkshire_champion": true,
    "multiplier": 15.0,
    "data": {
        "thingamabobs": ["icewall-firewall-daddy", "testing-framework", "performance-monitor"],
        "total_count": 23,
        "active_count": 23,
        "health": "EXCELLENT"
    }
}</div>
    `;
}

function generateDocumentation() {
    const format = document.querySelector('.format-btn.active').textContent.trim();
    alert(`Generating ${format} documentation...`);
    
    // Simulate documentation generation
    setTimeout(() => {
        alert('Documentation generated successfully! Download will start shortly.');
    }, 2000);
}

function selectDocFormat(format) {
    const buttons = document.querySelectorAll('.format-btn');
    buttons.forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');
}

