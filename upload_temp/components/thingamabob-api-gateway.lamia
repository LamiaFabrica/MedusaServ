                            <input type="checkbox"> Include Rate Limits
                        </label>
                        <label class="checkbox-option">
                            <input type="checkbox" checked> Yorkshire Champion Features
                        </label>
                    </div>
                    <div class="format-selection">
                        <button class="format-btn active" onclick="selectDocFormat('swagger')">
                            <i class="fas fa-file-code"></i> Swagger/OpenAPI
                        </button>
                        <button class="format-btn" onclick="selectDocFormat('postman')">
                            <i class="fas fa-rocket"></i> Postman Collection
                        </button>
                        <button class="format-btn" onclick="selectDocFormat('markdown')">
                            <i class="fab fa-markdown"></i> Markdown
                        </button>
                        <button class="format-btn" onclick="selectDocFormat('pdf')">
                            <i class="fas fa-file-pdf"></i> PDF
                        </button>
                    </div>
                    <button class="btn btn-primary" onclick="generateDocumentation()">
                        <i class="fas fa-magic"></i> Generate Documentation
                    </button>
                </div>
            </div>

            <!-- Interactive API Explorer -->
            <div class="api-explorer">
                <h4>Interactive API Explorer</h4>
                <div class="explorer-interface">
                    <div class="request-builder">
                        <div class="builder-section">
                            <label>HTTP Method</label>
                            <select id="method-selector">
                                <option value="GET">GET</option>
                                <option value="POST">POST</option>
                                <option value="PUT">PUT</option>
                                <option value="DELETE">DELETE</option>
                                <option value="PATCH">PATCH</option>
                            </select>
                        </div>
                        
                        <div class="builder-section">
                            <label>Endpoint URL</label>
                            <input type="text" id="endpoint-url" placeholder="/api/v1/thingamabobs" value="/api/v1/thingamabobs">
                        </div>
                        
                        <div class="builder-section">
                            <label>Headers</label>
                            <textarea id="request-headers" placeholder="Authorization: Bearer your-token-here">Authorization: Bearer demo-token-123</textarea>
                        </div>
                        
                        <div class="builder-section">
                            <label>Request Body (JSON)</label>
                            <textarea id="request-body" placeholder="{}">{}</textarea>
                        </div>
                        
                        <button class="btn btn-success" onclick="executeApiRequest()">
                            <i class="fas fa-play"></i> Execute Request
                        </button>
                    </div>
                    
                    <div class="response-display">
                        <h5>Response</h5>
                        <div class="response-container" id="api-response">
                            <div class="response-placeholder">
                                Execute a request to see the response here
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.thingamabob-api-gateway {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
