<!--
Purple-Pages.com - LFSSL Documentation Landing Page
Main documentation hub for LFSSL
© 2025 D Hargreaves (Roylepython) - Yorkshire Champion Standards
-->

manifest purple_pages_lfssl_index() {
    include "base.lamia" {
        title: "LFSSL Documentation - Purple Pages"
        description: "Complete documentation for LFSSL - Native C++ TLS 1.3 implementation with quantum-resistant algorithms"
        keywords: "LFSSL, TLS, SSL, cryptography, security, native C++, quantum-resistant, documentation"
    }
    
    main {
        // Breadcrumbs
        nav(class: "breadcrumbs") {
            div(class: "breadcrumb-container") {
                ol(class: "breadcrumb-list") {
                    li {
                        a(href: "/index.lamia") {
                            "Home"
                        }
                    }
                    li {
                        a(href: "/pages/lfssl/index.lamia") {
                            "LFSSL"
                        }
                    }
                }
            }
        }
        
        // Hero Section
        section(class: "tech-hero") {
            div(class: "tech-hero-content") {
                div(class: "tech-icon") {
                    "🔒"
                }
                h1 {
                    "LFSSL Documentation"
                }
                p(class: "tech-description") {
                    "Native C++ TLS 1.3 implementation with quantum-resistant algorithms. Complete cryptographic stack built from the ground up."
                }
            }
        }
        
        // Quick Links
        section(class: "quick-links-section") {
            div(class: "quick-links-container") {
                h2 {
                    "Quick Start"
                }
                div(class: "quick-links-grid") {
                    a(href: "/pages/lfssl/getting-started.lamia", class: "quick-link-card") {
                        h3 {
                            "🚀 Getting Started"
                        }
                        p {
                            "Introduction to LFSSL"
                        }
                    }
                    
                    a(href: "/pages/lfssl/security.lamia", class: "quick-link-card") {
                        h3 {
                            "🛡️ Security Guide"
                        }
                        p {
                            "Security best practices"
                        }
                    }
                    
                    a(href: "/pages/lfssl/configuration.lamia", class: "quick-link-card") {
                        h3 {
                            "⚙️ Configuration"
                        }
                        p {
                            "Configure TLS settings"
                        }
                    }
                    
                    a(href: "/pages/lfssl/quantum-resistant.lamia", class: "quick-link-card") {
                        h3 {
                            "⚛️ Quantum Resistance"
                        }
                        p {
                            "Quantum-resistant algorithms"
                        }
                    }
                }
            }
        }
        
        // Documentation Sections
        section(class: "docs-sections") {
            div(class: "docs-container") {
                div(class: "docs-grid") {
                    div(class: "docs-category") {
                        h3 {
                            "📚 Guides"
                        }
                        ul(class: "docs-list") {
                            li {
                                a(href: "/pages/lfssl/guides/overview.lamia") {
                                    "Overview"
                                }
                            }
                            li {
                                a(href: "/pages/lfssl/guides/implementation.lamia") {
                                    "Implementation Guide"
                                }
                            }
                            li {
                                a(href: "/pages/lfssl/guides/certificates.lamia") {
                                    "Certificate Management"
                                }
                            }
                        }
                    }
                    
                    div(class: "docs-category") {
                        h3 {
                            "🔧 Technical"
                        }
                        ul(class: "docs-list") {
                            li {
                                a(href: "/pages/lfssl/architecture.lamia") {
                                    "Architecture"
                                }
                            }
                            li {
                                a(href: "/pages/lfssl/algorithms.lamia") {
                                    "Cryptographic Algorithms"
                                }
                            }
                            li {
                                a(href: "/pages/lfssl/tls13-features.lamia") {
                                    "TLS 1.3 Features"
                                }
                            }
                        }
                    }
                    
                    div(class: "docs-category") {
                        h3 {
                            "🆘 Support"
                        }
                        ul(class: "docs-list") {
                            li {
                                a(href: "/pages/lfssl/troubleshooting.lamia") {
                                    "Troubleshooting"
                                }
                            }
                            li {
                                a(href: "/pages/lfssl/faq.lamia") {
                                    "FAQ"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

