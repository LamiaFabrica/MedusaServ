// Utility functions
function sanitize_id(str) {
    return str.toLowerCase().replace(/[^a-z0-9]+/g, "_");
}

function sanitize_filename(str) {
    return str.toLowerCase().replace(/[^a-z0-9]+/g, "-");
}

function get_filename(path) {
    return path.split("/").pop().replace(/\.md$/, "");
}

